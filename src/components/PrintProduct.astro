---
import { sizes, frames, roomImage, publishedPrints, type Print, type Lang } from '../data/prints';

interface Props { print: Print; lang: Lang; }
const { print, lang } = Astro.props;
const base = lang === 'es' ? '/es/prints' : '/prints';

const t = {
  en: {
    prints: 'Prints', kicker: 'Fine art print', frame: 'Frame', size: 'Size', buy: 'Buy this print',
    viewRoom: 'In the room', viewPhoto: 'Photo only', viewDetail: 'Frame detail',
    prev: 'Previous view', next: 'Next view', zoom: 'Zoom in', closeZoom: 'Close zoom', zoomHint: 'Move across the photo to explore it',
    noteFramed: 'Framed prints ship within Vietnam only; frame price on request. Outside Vietnam, choose “No frame” and we ship it rolled in a tube.',
    noteUnframed: 'Signed print, no frame. Shipped worldwide, rolled in a protective tube. Shipping calculated at checkout.',
    printing: 'Printing', printingVal: 'Giclée on cotton fine art paper, pigment inks',
    signature: 'Signature', signatureVal: 'Hand-signed on the border',
    format: 'Format', formatVal: '3:2, white border for framing',
    behind: 'Behind the photo', more: 'More prints', from: 'From',
    mailSubject: 'Print order', mailIntro: 'Hi Cris, I would like to order this print:',
  },
  es: {
    prints: 'Prints', kicker: 'Impresión fine art', frame: 'Marco', size: 'Tamaño', buy: 'Comprar este print',
    viewRoom: 'En el espacio', viewPhoto: 'Solo la foto', viewDetail: 'Detalle del marco',
    prev: 'Vista anterior', next: 'Vista siguiente', zoom: 'Ampliar fotografía', closeZoom: 'Cerrar ampliación', zoomHint: 'Recorre la foto con el cursor',
    noteFramed: 'Con marco: envío solo dentro de Vietnam; precio del marco a consultar. Para otros países, elige “Sin marco” y lo enviamos enrollado en tubo.',
    noteUnframed: 'Print firmado, sin marco. Envío a todo el mundo, enrollado en tubo protector. Envío calculado al pagar.',
    printing: 'Impresión', printingVal: 'Giclée sobre papel fine art de algodón, tintas de pigmento',
    signature: 'Firma', signatureVal: 'Firmada a mano en el borde',
    format: 'Formato', formatVal: '3:2, con borde blanco para enmarcar',
    behind: 'Detrás de la foto', more: 'Más prints', from: 'Desde',
    mailSubject: 'Pedido de print', mailIntro: 'Hola Cris, quiero comprar este print:',
  },
}[lang];

const title = print.title[lang];
const others = publishedPrints.filter((p) => p.slug !== print.slug);
const defaultSize = sizes[1];
const viewLabels = [t.viewRoom, t.viewPhoto, t.viewDetail];
const frameData = frames.map((f) => ({ id: f.id, color: f.color, label: f.label[lang] }));
---

<main class="pp" id="pp" data-frame="black" data-view="room"
  style={`--frame-color:#1a1714;--framed:1;--room-w:${defaultSize.room};`}>
  <p class="pp-crumbs"><a href={base}>{t.prints}</a> / Vietnam / {title}</p>

  <div class="pp-grid">
    <section class="pp-media" aria-label={title}>
      <div class="pp-scene pp-stage" data-v="room" id="pp-stage">
        <img class="pp-room" src={roomImage} alt="" aria-hidden="true" />
        <div class="pp-print">
          <div class="pp-mat"><img src={print.image} alt={print.alt[lang]} /></div>
          <span class="pp-light" aria-hidden="true"></span>
        </div>
        <button type="button" class="pp-round pp-zoom-btn" id="pp-zoom-open" aria-label={t.zoom}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path><path d="M10.5 7.5v6M7.5 10.5h6"></path></svg>
        </button>
        <div class="pp-zoom" id="pp-zoom" hidden>
          <img src={print.image} alt="" id="pp-zoom-img" />
          <button type="button" class="pp-round pp-zoom-btn" id="pp-zoom-close" aria-label={t.closeZoom}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
          <p class="pp-zoom-hint">{t.zoomHint}</p>
        </div>
      </div>

      <div class="pp-viewbar">
        <button type="button" class="pp-round pp-arrow" data-step="-1" aria-label={t.prev}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <div class="pp-thumbs">
          {['room', 'photo', 'detail'].map((v, i) => (
            <button type="button" class="pp-scene pp-thumb" data-v={v} data-set-view={v} aria-label={viewLabels[i]} aria-pressed={v === 'room' ? 'true' : 'false'}>
              {v === 'room' && <img class="pp-room" src={roomImage} alt="" />}
              <span class="pp-print"><span class="pp-mat"><img src={print.image} alt="" /></span></span>
            </button>
          ))}
        </div>
        <button type="button" class="pp-round pp-arrow" data-step="1" aria-label={t.next}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
      <p class="pp-viewlabel" id="pp-viewlabel" aria-live="polite">{t.viewRoom} · 1 / 3</p>
    </section>

    <aside class="pp-panel">
      <div>
        <p class="pp-kicker">{t.kicker}</p>
        <h1 class="pp-title">{title}</h1>
        <p class="pp-place">{print.place}</p>
      </div>

      <fieldset class="pp-field">
        <legend>{t.frame}: <span id="pp-frame-name">{frameData[0].label}</span></legend>
        <div class="pp-swatches">
          {frameData.map((f, i) => (
            <button type="button" class="pp-swatch" data-frame={f.id} data-color={f.color} data-label={f.label}
              aria-label={f.label} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class={f.id === 'none' ? 'pp-swatch-none' : ''} style={f.id === 'none' ? '' : `background:${f.color}`}></span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset class="pp-field">
        <legend>{t.size}</legend>
        <div class="pp-sizes">
          {sizes.map((s) => (
            <button type="button" class="pp-size" data-size={s.id} data-price={s.price} data-room={s.room} data-cm={s.cm}
              aria-pressed={s.id === defaultSize.id ? 'true' : 'false'}>
              <strong>{s.label}</strong>
              <span>{s.cm} · ${s.price}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <div class="pp-buy">
        <p class="pp-price"><span id="pp-price">${defaultSize.price}</span> <small>USD</small></p>
        <a class="pp-cta" id="pp-cta" href="#">{t.buy}</a>
        <p class="pp-note" id="pp-note">{t.noteFramed}</p>
      </div>

      <dl class="pp-specs">
        <dt>{t.printing}</dt><dd>{t.printingVal}</dd>
        <dt>{t.signature}</dt><dd>{t.signatureVal}</dd>
        <dt>{t.format}</dt><dd>{t.formatVal}</dd>
      </dl>
    </aside>
  </div>

  <section class="pp-story" aria-labelledby="pp-story-title">
    <div>
      <p class="pp-kicker">{t.behind}</p>
      <h2 id="pp-story-title">{title}</h2>
    </div>
    <div class="pp-story-body">
      {print.story[lang].map((para) => <p class="pp-story-p">{para}</p>)}
      <p class="pp-meta">{print.meta[lang]}</p>
      <span class="pp-signature">Cris Maturana</span>
    </div>
  </section>

  {others.length > 0 && (
    <section class="pp-more">
      <h2>{t.more}</h2>
      <div class="pp-more-grid">
        {others.map((o) => (
          <a href={`${base}/${o.slug}`} class="pp-card">
            <img src={o.image} alt={o.alt[lang]} loading="lazy" />
            <span class="pp-card-title">{o.title[lang]}</span>
            <span class="pp-card-sub">{t.from} ${sizes[0].price}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</main>

<script is:inline define:vars={{ t, title, viewLabels, slug: print.slug, sizesList: sizes }}>
  (function () {
    var root = document.getElementById('pp');
    var stage = document.getElementById('pp-stage');
    var views = ['room', 'photo', 'detail'];
    var state = { view: 'room', frame: 'black', frameLabel: '', size: 'm' };

    function frameLabelOf(id) {
      var b = root.querySelector('.pp-swatch[data-frame="' + id + '"]');
      return b ? b.getAttribute('data-label') : id;
    }
    function render() {
      var sizeBtn = root.querySelector('.pp-size[data-size="' + state.size + '"]');
      var swatch = root.querySelector('.pp-swatch[data-frame="' + state.frame + '"]');
      var framed = state.frame !== 'none';
      root.style.setProperty('--frame-color', swatch.getAttribute('data-color'));
      root.style.setProperty('--framed', framed ? '1' : '0');
      root.style.setProperty('--room-w', sizeBtn.getAttribute('data-room'));
      root.setAttribute('data-frame', state.frame);
      stage.setAttribute('data-v', state.view);
      root.querySelectorAll('.pp-swatch').forEach(function (b) { b.setAttribute('aria-pressed', String(b === swatch)); });
      root.querySelectorAll('.pp-size').forEach(function (b) { b.setAttribute('aria-pressed', String(b === sizeBtn)); });
      root.querySelectorAll('.pp-thumb').forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-set-view') === state.view)); });
      var vi = views.indexOf(state.view);
      document.getElementById('pp-viewlabel').textContent = viewLabels[vi] + ' · ' + (vi + 1) + ' / 3';
      document.getElementById('pp-frame-name').textContent = swatch.getAttribute('data-label');
      document.getElementById('pp-price').textContent = '$' + sizeBtn.getAttribute('data-price');
      document.getElementById('pp-note').textContent = framed ? t.noteFramed : t.noteUnframed;
      var body = t.mailIntro + '\n\n' + title + '\n' + sizeBtn.getAttribute('data-cm') + ' · ' + swatch.getAttribute('data-label') + ' · $' + sizeBtn.getAttribute('data-price') + ' USD\n' + location.href;
      document.getElementById('pp-cta').href = 'mailto:info@crismaturana.com?subject=' + encodeURIComponent(t.mailSubject + ': ' + title) + '&body=' + encodeURIComponent(body);
    }

    root.addEventListener('click', function (e) {
      var el = e.target.closest('button');
      if (!el || !root.contains(el)) return;
      if (el.hasAttribute('data-frame')) state.frame = el.getAttribute('data-frame');
      else if (el.hasAttribute('data-size')) state.size = el.getAttribute('data-size');
      else if (el.hasAttribute('data-set-view')) state.view = el.getAttribute('data-set-view');
      else if (el.hasAttribute('data-step')) {
        var vi = views.indexOf(state.view);
        state.view = views[(vi + Number(el.getAttribute('data-step')) + 3) % 3];
      } else return;
      render();
    });

    var zoom = document.getElementById('pp-zoom');
    var zimg = document.getElementById('pp-zoom-img');
    function setOrigin(x, y) {
      var r = zoom.getBoundingClientRect();
      var px = Math.max(0, Math.min(100, (x - r.left) / r.width * 100));
      var py = Math.max(0, Math.min(100, (y - r.top) / r.height * 100));
      zimg.style.transformOrigin = px + '% ' + py + '%';
    }
    document.getElementById('pp-zoom-open').addEventListener('click', function () { zimg.style.transformOrigin = '50% 50%'; zoom.hidden = false; });
    document.getElementById('pp-zoom-close').addEventListener('click', function () { zoom.hidden = true; });
    zoom.addEventListener('mousemove', function (e) { setOrigin(e.clientX, e.clientY); });
    zoom.addEventListener('touchmove', function (e) { if (e.touches[0]) setOrigin(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') zoom.hidden = true; });

    render();
  })();
</script>

<style>
  .pp { max-width: 1360px; margin: 0 auto; padding: calc(var(--nav-height, 80px) + 2rem) 5vw 5rem; color: #14110d; }
  .pp-crumbs { margin: 0 0 1.5rem; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: #5c554b; }
  .pp-crumbs a { color: inherit; text-decoration: none; }
  .pp-crumbs a:hover { color: #7d5820; }
  .pp-grid { display: flex; flex-wrap: wrap; gap: 3rem; align-items: flex-start; }
  .pp-media { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 1rem; }
  .pp-panel { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 1.75rem; }

  /* Escena: el mismo marcado sirve para la vista grande y las miniaturas */
  .pp-scene { position: relative; overflow: hidden; background: #ece6db; }
  .pp-stage { width: 100%; aspect-ratio: 3 / 2; border-radius: 2px; }
  .pp-room { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .pp-scene:not([data-v="room"]) .pp-room { display: none; }
  .pp-print { position: absolute; display: block; box-sizing: border-box; transform: translate(-50%, -50%);
    background: var(--frame-color); left: 50%; top: 47%; width: 64%;
    padding: calc(1.2% * var(--framed)); box-shadow: 0 10px 22px rgba(20,17,13,0.3), 0 2px 4px rgba(20,17,13,0.2); }
  .pp-mat { display: block; background: #efeae1; padding: calc(4.5% * var(--framed)); }
  .pp[data-frame="none"] .pp-mat { background: transparent; }
  .pp-mat img { display: block; width: 100%; height: auto; }
  .pp-light { display: none; }

  .pp-scene[data-v="room"] .pp-print { left: 49%; top: 35%; width: var(--room-w); padding: calc(0.6% * var(--framed));
    filter: brightness(0.93) saturate(0.96);
    box-shadow: -16px 12px 28px rgba(34,27,18,0.30), -5px 4px 8px rgba(34,27,18,0.24), -1px 1px 2px rgba(34,27,18,0.25); }
  .pp[data-frame="none"] .pp-scene[data-v="room"] .pp-print { box-shadow: -10px 8px 18px rgba(34,27,18,0.26), -2px 2px 4px rgba(34,27,18,0.2); }
  .pp-scene[data-v="room"] .pp-mat { background: #e6dfd2; }
  .pp[data-frame="none"] .pp-scene[data-v="room"] .pp-mat { background: transparent; }
  .pp-scene[data-v="room"] .pp-light { display: block; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to right, rgba(28,22,14,0.12) 0%, rgba(28,22,14,0.03) 55%, rgba(255,248,235,0.06) 100%); }
  .pp-scene[data-v="detail"] .pp-print { left: 83%; top: 94%; width: 150%; padding: calc(1.6% * var(--framed)); }

  .pp-thumb .pp-print { box-shadow: 0 2px 4px rgba(20,17,13,0.25) !important; }

  .pp-round { width: 44px; height: 44px; padding: 0; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #14110d; }
  .pp-zoom-btn { position: absolute; top: 16px; right: 16px; border: 0; background: rgba(251,249,244,0.92); box-shadow: 0 2px 8px rgba(20,17,13,0.18); z-index: 2; }
  .pp-zoom { position: absolute; inset: 0; overflow: hidden; background: #ece6db; cursor: zoom-in; z-index: 3; }
  .pp-zoom[hidden] { display: none; }
  .pp-zoom > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transform: scale(2.4); }
  .pp-zoom-hint { position: absolute; left: 16px; bottom: 16px; margin: 0; padding: 8px 12px; background: rgba(251,249,244,0.92); font-size: 0.75rem; letter-spacing: 0.08em; border-radius: 2px; }

  .pp-viewbar { display: flex; align-items: center; gap: 12px; }
  .pp-arrow { flex: 0 0 auto; border: 1px solid #cfc5b3; background: #fbf9f4; }
  .pp-thumbs { flex: 1 1 auto; min-width: 0; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .pp-thumb { width: 108px; height: 72px; padding: 0; border: 1px solid #cfc5b3; border-radius: 2px; cursor: pointer; }
  .pp-thumb[aria-pressed="true"] { outline: 2px solid #14110d; outline-offset: 1px; }
  .pp-viewlabel { margin: 0; text-align: center; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: #5c554b; }

  .pp-kicker { margin: 0 0 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #7d5820; }
  .pp-title { margin: 0; font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 3rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.01em; color: #14110d; }
  .pp-place { margin: 0.5rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1.125rem; color: #5c554b; }

  .pp-field { margin: 0; padding: 0; border: 0; }
  .pp-field legend { padding: 0; margin-bottom: 0.75rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .pp-field legend span { font-weight: 400; letter-spacing: 0.04em; text-transform: none; }
  .pp-swatches { display: flex; gap: 12px; flex-wrap: wrap; }
  .pp-swatch { width: 48px; height: 48px; padding: 4px; border: 2px solid transparent; border-radius: 50%; background: transparent; cursor: pointer; }
  .pp-swatch[aria-pressed="true"] { border-color: #14110d; }
  .pp-swatch span { display: block; width: 100%; height: 100%; border-radius: 50%; border: 1px solid #b9ae9b; box-sizing: border-box; }
  .pp-swatch-none { background: repeating-linear-gradient(45deg, #fbf9f4 0 5px, #e2dacb 5px 7px); }
  .pp-sizes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .pp-size { min-height: 56px; padding: 8px; border: 1px solid #cfc5b3; border-radius: 2px; background: #fbf9f4; color: #14110d; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; cursor: pointer; font: inherit; }
  .pp-size[aria-pressed="true"] { border: 2px solid #14110d; }
  .pp-size strong { font-size: 0.875rem; }
  .pp-size span { font-size: 0.75rem; color: #5c554b; }

  .pp-buy { display: flex; flex-direction: column; gap: 0.875rem; padding-top: 1.25rem; border-top: 1px solid #e2dacb; }
  .pp-price { margin: 0; font-family: var(--font-serif); font-size: 2.25rem; }
  .pp-price small { font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.1em; color: #5c554b; }
  .pp-cta { display: flex; align-items: center; justify-content: center; min-height: 54px; background: #e8c070; color: #14110d; text-decoration: none; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; border-radius: 2px; }
  .pp-cta:hover { background: #dcae55; }
  .pp-note { margin: 0; font-size: 0.875rem; line-height: 1.6; color: #5c554b; }
  .pp-specs { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 10px 20px; font-size: 0.875rem; line-height: 1.5; }
  .pp-specs dt { font-weight: 700; }
  .pp-specs dd { margin: 0; color: #5c554b; }

  .pp-story { margin-top: 5rem; padding-top: 3.5rem; border-top: 1px solid #e2dacb; display: flex; flex-wrap: wrap; gap: 3rem; }
  .pp-story > div:first-child { flex: 1 1 280px; }
  .pp-story h2 { margin: 0; font-family: var(--font-serif); font-size: 2.25rem; font-weight: 400; line-height: 1.15; }
  .pp-story-body { flex: 2 1 480px; display: flex; flex-direction: column; gap: 1.25rem; }
  .pp-story-p { margin: 0; font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.6; }
  .pp-meta { margin: 0; font-size: 0.875rem; letter-spacing: 0.08em; color: #5c554b; }
  .pp-signature { font-family: var(--font-serif); font-style: italic; font-size: 2rem; line-height: 1; }

  .pp-more { margin-top: 5rem; }
  .pp-more h2 { margin: 0 0 1.5rem; font-family: var(--font-serif); font-size: 2rem; font-weight: 400; }
  .pp-more-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem; }
  .pp-card { display: flex; flex-direction: column; gap: 0.4rem; text-decoration: none; color: #14110d; }
  .pp-card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .pp-card-title { font-family: var(--font-serif); font-size: 1.3rem; }
  .pp-card-sub { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: #5c554b; }
</style>
