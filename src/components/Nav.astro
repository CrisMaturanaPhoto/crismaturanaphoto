---
const navLinks = [
  {
    label: 'Portfolio', i18n: 'nav.portfolio',
    href: '/portfolio',
    children: [
      { label: 'Weddings', i18n: 'nav.weddings', href: '/portfolio/weddings' },
      { label: 'Couples & Families', i18n: 'nav.couples', href: '/portfolio/couples-families' },
      { label: 'Portraits', i18n: 'nav.portraits', href: '/portfolio/portraits' },
      { label: 'Travel & Culture', i18n: 'nav.travel', href: '/portfolio/travel-culture' },
      { label: 'From Above', i18n: 'nav.aerial', href: '/portfolio/aerial' },
      { label: 'Matrimonios en Chile 🇨🇱', i18n: 'nav.matrimonios', href: '/es/matrimonios-chile' },
    ],
  },
  { label: 'Photo Tours', i18n: 'nav.phototours', href: '/photo-tours-vietnam-2026' },
  {
    label: 'About', i18n: 'nav.aboutmenu',
    href: '#',
    children: [
      { label: 'About Me', i18n: 'nav.about', href: '/about-me' },
      { label: 'FAQ', i18n: 'nav.faq', href: '/faq' },
    ],
  },
  { label: 'Prices', i18n: 'nav.prices', href: '/prices' },
  { label: 'Blog', i18n: 'nav.blog', href: '/blog' },
  { label: 'Contact', i18n: 'nav.contact', href: '/contact' },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-name">Cristóbal Maturana</span>
      <span class="logo-sub">Documentary Photographer</span>
    </a>

    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" id="site-nav" role="navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class={`nav-item ${link.children ? 'has-dropdown' : ''}`}>
            <a href={link.href} class={`nav-link ${link.cta ? 'nav-cta' : ''}`}>
              <span data-i18n={link.i18n || ''}><span data-i18n={link.i18n || ''}>{link.label}</span></span>
              {link.children && <span class="dropdown-arrow">&#9662;</span>}
            </a>
            {link.children && (
              <ul class="dropdown">
                {link.children.map((child) => (
                  <li><a href={child.href} class="dropdown-link" data-i18n={child.i18n || ''}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="lang-switcher" role="group" aria-label="Language selector">
      <button class="lang-btn active" data-lang="en" onclick="window.setLang && window.setLang('en')" aria-label="English">
        <span class="lang-flag">🇬🇧</span>
        <span class="lang-code">EN</span>
      </button>
      <span class="lang-divider">|</span>
      <button class="lang-btn" data-lang="es" onclick="window.setLang && window.setLang('es')" aria-label="Español">
        <span class="lang-flag">🇪🇸</span>
        <span class="lang-code">ES</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: var(--nav-height);
    transition: background 0.4s ease, backdrop-filter 0.4s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-white);
    letter-spacing: 0.02em;
  }

  .logo-sub {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .site-nav { display: flex; }

  .nav-list {
    display: flex;
    list-style: none;
    gap: 0;
    align-items: center;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0 1.1rem;
    height: var(--nav-height);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--color-white); }

  .dropdown-arrow {
    font-size: 0.6rem;
    opacity: 0.6;
  }

  .dropdown {
    display: none;
    position: absolute;
    top: calc(var(--nav-height) - 2px);
    left: 0;
    min-width: 200px;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    list-style: none;
    padding: 0.5rem 0;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .has-dropdown:hover .dropdown { display: block; }

  .dropdown-link {
    display: block;
    padding: 0.6rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    transition: color 0.2s, padding-left 0.2s;
    white-space: nowrap;
  }

  .dropdown-link:hover {
    color: var(--color-heading);
    padding-left: 1.6rem;
  }

  .site-header.scrolled .logo-name {
    color: var(--color-heading);
  }

  .site-header.scrolled .nav-link {
    color: var(--color-text);
  }

  .site-header.scrolled .nav-link:hover {
    color: var(--color-accent);
  }

  /* Mobile */
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-white);
    transition: all 0.3s ease;
  }

  .site-header.scrolled .menu-toggle span {
    background: var(--color-heading);
  }

  @media (max-width: 900px) {
    .menu-toggle { display: flex; }

    .site-nav {
      display: none;
      position: fixed;
      top: 70px;
      left: 0;
      right: 0;
      background: #ffffff;
      height: auto;
      overflow-y: visible;
      padding: 1.5rem 2rem 2rem;
      z-index: 9999;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

    .site-nav.open { display: block; background: #ffffff; padding-top: 0; }

    .nav-list { flex-direction: column; align-items: flex-start; gap: 0; }

    .nav-link {
      height: auto;
      padding: 1rem 0;
      font-size: 1rem;
      letter-spacing: 0.1em;
      color: var(--color-heading);
      border-bottom: 1px solid var(--color-border);
      width: 100%;
    }

    .dropdown {
      display: block;
      position: static;
      border: none;
      background: transparent;
      border-top: none;
      padding: 0 0 0 1rem;
      box-shadow: none;
    }

    .dropdown-link {
      padding: 0.5rem 0;
      border-bottom: 1px solid rgba(0,0,0,0.08);
    }

    .dropdown-link:hover { padding-left: 0.5rem; }
  }

  /* Language switcher */
  .lang-switcher { display: flex; align-items: center; gap: 0.1rem; margin-left: 1.5rem; }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem 0.3rem;
    border-radius: 4px;
    font-family: var(--font-sans, 'Jost', sans-serif);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--color-muted, #8a8278);
    transition: color 0.2s, background 0.2s;
    opacity: 0.7;
  }
  .lang-btn.active {
    color: var(--color-accent, #a0722a);
    opacity: 1;
    font-weight: 500;
  }
  .lang-btn:hover { opacity: 1; color: var(--color-heading, #1c1a17); }
  .lang-flag { font-size: 0.9rem; line-height: 1; }
  .lang-code { font-size: 0.65rem; letter-spacing: 0.12em; }
  .lang-divider { color: var(--color-border, rgba(160,114,42,0.3)); font-size: 0.7rem; }
  @media (max-width: 900px) {
    .lang-switcher { margin-left: 0.5rem; }
    .lang-code { display: none; }
  }


  @media (max-width: 900px) {
    .header-inner { position: relative; }
    .lang-switcher { order: 2; margin-left: auto; margin-right: 0.6rem; gap: 0.05rem; }
    .lang-switcher .lang-code { display: none; }
    .menu-toggle { order: 3; }
    .logo { order: 1; }
    .site-nav { order: 4; }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('site-nav')!;

  // Scroll effect
  const isHome = window.location.pathname === '/';
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', isHome ? window.scrollY > 20 : true);
  }, { passive: true });
  header.classList.toggle('scrolled', isHome ? window.scrollY > 20 : true);

  // Mobile menu
  toggle.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('scrolled', open || window.scrollY > 20);
  });

  // Actualizar hrefs del nav según idioma activo
  function updateNavHrefs(lang) {
    const isEs = lang === 'es';
    const map = {
      '/portfolio':                          isEs ? '/es/portfolio'                          : '/portfolio',
      '/portfolio/weddings':                 isEs ? '/es/portfolio/weddings'                 : '/portfolio/weddings',
      '/portfolio/couples-families':         isEs ? '/es/portfolio/couples-families'         : '/portfolio/couples-families',
      '/portfolio/portraits':                isEs ? '/es/portfolio/portraits'                : '/portfolio/portraits',
      '/portfolio/travel-culture':           isEs ? '/es/portfolio/travel-culture'           : '/portfolio/travel-culture',
      '/portfolio/aerial':                   isEs ? '/es/portfolio/aerial'                   : '/portfolio/aerial',
      '/photo-tours-vietnam-2026': isEs ? '/es/photo-tours-vietnam-2026' : '/photo-tours-vietnam-2026',
      '/about-me':                           isEs ? '/es/about-me'                           : '/about-me',
      '/prices':                             isEs ? '/es/prices'                             : '/prices',
      '/faq':                                isEs ? '/es/faq'                                : '/faq',
      '/contact':                            isEs ? '/es/contact'                            : '/contact',
    };
    document.querySelectorAll('.nav-link, .dropdown-link').forEach(el => {
      const href = el.getAttribute('href');
      if (href && map[href]) el.setAttribute('href', map[href]);
      // también el reverso: si ya tiene la ruta ES, apuntar a EN
      const reverseMap = Object.fromEntries(Object.entries(map).map(([k,v]) => [v,k]));
      if (href && !isEs && reverseMap[href]) el.setAttribute('href', reverseMap[href]);
    });
  }

  // Aplicar al cargar
  const initLang = localStorage.getItem('lang') || 'en';
  updateNavHrefs(initLang);

  // Escuchar cambios de idioma
  window.addEventListener('langChanged', (e) => updateNavHrefs(e.detail));
</script>
