---
// SpecialOfferPopup.astro
// Flash offer popup — $99 USD — bilingual EN/ES
// Auto-detects browser language: Spanish → ES, everything else → EN
// WhatsApp: +56999679935
// Timer: 48h
---

<div id="offer-overlay" role="dialog" aria-modal="true" aria-labelledby="offer-title">
  <div id="offer-card">

    <div class="top-strip">
      <div class="strip-left">
        <div class="strip-dot"></div>
        <span class="strip-label" id="pop-flash">Flash offer · today only</span>
      </div>
      <div class="strip-timer">
        <span class="st-num" id="pop-th">47</span><span class="st-sep">h</span>
        <span class="st-num" id="pop-tm">59</span><span class="st-sep">m</span>
        <span class="st-num" id="pop-ts">59</span><span class="st-sep">s</span>
      </div>
    </div>

    <div class="hero">
      <button class="close-btn" id="pop-close" type="button" aria-label="Close">×</button>
      <p class="eyebrow" id="pop-eyebrow">Hội An · Photography session</p>
      <h2 class="hl" id="pop-hl" id="offer-title">Your session<br>for <em>just</em> $99.</h2>
      <div class="price-row">
        <span class="pcur">USD</span>
        <span class="pmain">99</span>
        <div class="price-meta">
          <span class="pold">$160</span>
          <span class="psave">–38% off</span>
        </div>
      </div>
      <p class="pnote" id="pop-pnote">Only for the next 48 hours</p>
    </div>

    <div class="body">
      <div class="tabs" role="group">
        <button class="stab active" data-en="Family"   data-es="Familia"  type="button">Family</button>
        <button class="stab"        data-en="Couple"   data-es="Pareja"   type="button">Couple</button>
        <button class="stab"        data-en="Branding" data-es="Branding" type="button">Branding</button>
      </div>

      <div class="includes">
        <div class="inc">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="pop-inc1">1 hour</span>
        </div>
        <div class="inc">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          <span id="pop-inc2">15+ photos</span>
        </div>
        <div class="inc">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span id="pop-inc3">Sneak 24h</span>
        </div>
        <div class="inc">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span id="pop-inc4">Online gallery</span>
        </div>
      </div>

      <div class="spots">
        <span aria-hidden="true">●</span>
        <span id="pop-spots">3 dates available</span>
        <div class="sbar"><div class="sfill"></div></div>
      </div>

      <div class="testimonial">
        <div class="testimonial-img">
          <img src="https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION/Mady%26Sven-%40-25.JPG" alt="Mandy & Swen" width="900" height="600" loading="lazy" />
        </div>
        <div class="testimonial-text">
          <p id="pop-quote">"We're very happy with the result. Now we have a lot of great photos for our website."</p>
          <cite>— Mandy &amp; Swen, Berlin</cite>
        </div>
      </div>

      <a id="pop-wsp" href="https://wa.me/56999679935?text=Hi+Cris,+I%27d+like+to+book+a+Family+session+for+%2499" target="_blank" rel="noopener noreferrer" class="cta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <span id="pop-cta-txt">Book via WhatsApp</span>
      </a>

      <button class="cta2" id="pop-dismiss" type="button">No thanks, I'll pay full price</button>

      <div class="trust">
        <span class="tr">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span id="pop-tr1">No upfront payment</span>
        </span>
        <span class="tr">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="pop-tr2">Local resident</span>
        </span>
        <span class="tr">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span id="pop-tr3">Reply within 24h</span>
        </span>
      </div>
    </div>

  </div>
</div>

<style>
  #offer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(8, 6, 4, 0.82);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'DM Sans', -apple-system, sans-serif;
  }
  #offer-overlay.is-visible {
    display: flex;
    animation: popFadeIn 0.35s ease;
  }
  @keyframes popFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  #offer-card {
    background: #faf8f4;
    max-width: 400px;
    width: 100%;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #e0d8cc;
    animation: popSlideUp 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes popSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .top-strip {
    background: #1a1812;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .strip-left { display: flex; align-items: center; gap: 7px; }
  .strip-dot {
    width: 7px; height: 7px;
    background: #c8a84a;
    border-radius: 50%;
    flex-shrink: 0;
    animation: popPulse 1.4s ease-in-out infinite;
  }
  @keyframes popPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.8); }
  }
  .strip-label {
    font-size: 11px; color: #e8d088;
    letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500;
  }
  .strip-timer { display: flex; align-items: center; gap: 1px; flex-shrink: 0; }
  .st-num {
    font-size: 12px; color: #e8d088; font-weight: 500;
    min-width: 18px; display: inline-block; text-align: center;
  }
  .st-sep { color: #6a5a28; font-size: 11px; margin: 0 1px; }
  .hero {
    text-align: center;
    padding: 22px 24px 18px;
    border-bottom: 1px solid #e8e2d8;
    position: relative;
  }
  .close-btn {
    position: absolute; top: 14px; right: 16px;
    background: none; border: none; color: #c0b8a8;
    font-size: 18px; cursor: pointer; line-height: 1; padding: 0;
    transition: color 0.2s;
  }
  .close-btn:hover { color: #1a1812; }
  .eyebrow {
    font-size: 9px; color: #8B6914;
    letter-spacing: 0.15em; text-transform: uppercase; font-weight: 500; margin-bottom: 8px;
  }
  .hl {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 30px; color: #1a1812; line-height: 1.1; font-weight: 300; margin-bottom: 16px;
  }
  .hl em { font-style: italic; font-weight: 600; color: #8B6914; }
  .price-row {
    display: flex; align-items: flex-end; justify-content: center;
    gap: 10px; margin-bottom: 6px;
  }
  .pcur { font-size: 16px; color: #a09888; align-self: flex-start; margin-top: 10px; font-weight: 300; }
  .pmain {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 64px; color: #1a1812; font-weight: 600; line-height: 1;
  }
  .price-meta { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; align-self: flex-end; margin-bottom: 6px; }
  .pold { font-size: 13px; color: #c0b8a8; text-decoration: line-through; font-weight: 300; }
  .psave {
    font-size: 11px; background: #eaf4e0; color: #3b6d11;
    border: 1px solid #c0dda0; padding: 3px 8px; border-radius: 2px; font-weight: 500;
  }
  .pnote { font-size: 10px; color: #b0a898; }
  .body { padding: 16px 20px 18px; display: flex; flex-direction: column; }
  .tabs { display: flex; gap: 5px; margin-bottom: 12px; }
  .stab {
    flex: 1;
    background: #ffffff;
    border: 1px solid #d8d0c4;
    color: #1a1812;
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 11px;
    padding: 8px 3px;
    border-radius: 2px;
    cursor: default;
    text-align: center;
    letter-spacing: 0.02em;
    font-weight: 400;
    pointer-events: none;
  }
  .stab.active {
    background: #ffffff;
    border-color: #c8a84a;
    color: #1a1812;
    font-weight: 500;
    box-shadow: 0 0 0 1px #c8a84a;
    pointer-events: auto;
    cursor: pointer;
  }
  .includes { display: flex; gap: 5px; margin-bottom: 12px; flex-wrap: wrap; }
  .inc {
    display: flex; align-items: center; gap: 4px;
    font-size: 10px; color: #6a6050;
    background: #f4f0e8; border: 1px solid #e8e2d8;
    border-radius: 2px; padding: 4px 8px;
  }
  .inc svg { color: #8B6914; flex-shrink: 0; }
  .spots {
    display: flex; align-items: center; gap: 6px;
    font-size: 10px; color: #c85a30; font-weight: 500; margin-bottom: 12px;
  }
  .sbar { flex: 1; height: 2px; background: #e8e2d8; border-radius: 2px; overflow: hidden; }
  .sfill { height: 100%; width: 70%; background: #c85a30; }
  .testimonial {
    display: flex; align-items: center; gap: 11px;
    background: #f4f0e8; border: 1px solid #e8e2d8;
    border-radius: 3px; padding: 10px 12px; margin-bottom: 14px;
  }
  .testimonial-img {
    width: 42px; height: 42px; border-radius: 50%;
    overflow: hidden; flex-shrink: 0; border: 2px solid #e0d8cc;
  }
  .testimonial-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .testimonial-text p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 12px; color: #4a3a28; font-style: italic;
    line-height: 1.45; font-weight: 300; margin-bottom: 3px;
  }
  .testimonial-text cite { font-size: 9px; color: #a09888; text-transform: uppercase; letter-spacing: 0.09em; font-style: normal; }
  .cta {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; background: #25D366; color: #fff; border: none;
    padding: 13px; font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 12px; font-weight: 500; letter-spacing: 0.05em;
    cursor: pointer; border-radius: 3px; transition: background 0.2s;
    margin-bottom: 7px; text-decoration: none;
  }
  .cta:hover { background: #20c05a; }
  .cta svg { flex-shrink: 0; }
  .cta2 {
    width: 100%; background: transparent; color: #b0a898;
    border: 1px solid #e0d8cc; padding: 8px;
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 10px; cursor: pointer; border-radius: 2px; transition: all 0.2s;
  }
  .cta2:hover { color: #6a6050; border-color: #c0b8a8; }
  .trust {
    display: flex; align-items: center; justify-content: center;
    gap: 12px; margin-top: 12px; padding-top: 10px;
    border-top: 1px solid #e8e2d8; flex-wrap: wrap;
  }
  .tr { display: flex; align-items: center; gap: 4px; font-size: 9px; color: #b0a898; }
  @media (max-width: 480px) {
    #offer-card { max-width: 100%; }
    .hl { font-size: 24px; }
    .pmain { font-size: 52px; }
  }
</style>

<script is:inline>
(function () {
  var PHONE     = '56999679935';
  var SEEN_KEY  = 'cris_offer_seen';
  var TIMER_KEY = 'cris_offer_end';
  var DELAY_MS  = 3000;

  var copy = {
    en: {
      flash:  'Flash offer \u00b7 today only',
      eyebrow:'H\u1ed9i An \u00b7 Photography session',
      hl:     'Your session<br>for <em>just</em> $99.',
      pnote:  'Only for the next 48 hours',
      tabs:   ['Family', 'Couple', 'Branding'],
      inc:    ['1 hour', '15+ photos', 'Sneak 24h', 'Online gallery'],
      spots:  '3 dates available',
      cta:    'Book via WhatsApp',
      cta2:   "No thanks, I'll pay full price",
      tr:     ['No upfront payment', 'Local resident', 'Reply within 24h'],
      quote:  '\u201cI\u2019m very happy with the result. Now we have a lot of great photos for our website.\u201d',
      msgs: {
        'Family':   'Hi+Cris,+I%27d+like+to+book+a+Family+session+for+%2499',
        'Couple':   'Hi+Cris,+I%27d+like+to+book+a+Couple+session+for+%2499',
        'Branding': 'Hi+Cris,+I%27d+like+to+book+a+Branding+session+for+%2499'
      }
    },
    es: {
      flash:  'Oferta flash \u00b7 solo hoy',
      eyebrow:'H\u1ed9i An \u00b7 Sesi\u00f3n fotogr\u00e1fica',
      hl:     'Tu sesi\u00f3n<br>por <em>solo</em> $99.',
      pnote:  'Solo durante las pr\u00f3ximas 48 horas',
      tabs:   ['Familia', 'Pareja', 'Branding'],
      inc:    ['1 hora', '15+ fotos', 'Sneak 24h', 'Galer\u00eda online'],
      spots:  '3 fechas disponibles',
      cta:    'Reservar por WhatsApp',
      cta2:   'No gracias, prefiero precio completo',
      tr:     ['Sin pago previo', 'Residente local', 'Respuesta en 24h'],
      quote:  '\u201cEstamos muy felices con el resultado. Ahora tenemos muchas fotos incre\u00edbles para nuestra web.\u201d',
      msgs: {
        'Familia':  'Hola+Cris,+quiero+reservar+la+sesi%C3%B3n+de+Familia+por+%2499',
        'Pareja':   'Hola+Cris,+quiero+reservar+la+sesi%C3%B3n+de+Pareja+por+%2499',
        'Branding': 'Hola+Cris,+quiero+reservar+la+sesi%C3%B3n+de+Branding+por+%2499'
      }
    }
  };

  var lang = 'en';
  var currentType = 'Family';

  function detectLang() {
    var l = (navigator.language || 'en').toLowerCase();
    return l.startsWith('es') ? 'es' : 'en';
  }

  function set(id, val) {
    var el = document.getElementById(id);
    if (el) el.innerHTML = val;
  }

  function updateWsp() {
    var msg = copy[lang].msgs[currentType] || '';
    var el = document.getElementById('pop-wsp');
    if (el) el.href = 'https://wa.me/' + PHONE + '?text=' + msg;
  }

  function applyLang(l) {
    lang = l;
    var c = copy[l];
    set('pop-flash',   c.flash);
    set('pop-eyebrow', c.eyebrow);
    set('pop-hl',      c.hl);
    set('pop-pnote',   c.pnote);
    set('pop-spots',   c.spots);
    set('pop-cta-txt', c.cta);
    set('pop-quote',   c.quote);
    set('pop-inc1',    c.inc[0]);
    set('pop-inc2',    c.inc[1]);
    set('pop-inc3',    c.inc[2]);
    set('pop-inc4',    c.inc[3]);
    set('pop-tr1',     c.tr[0]);
    set('pop-tr2',     c.tr[1]);
    set('pop-tr3',     c.tr[2]);
    var dismiss = document.getElementById('pop-dismiss');
    if (dismiss) dismiss.textContent = c.cta2;
    var tabs = document.querySelectorAll('#offer-card .stab');
    tabs.forEach(function(btn, i) { btn.textContent = c.tabs[i]; });
    tabs.forEach(function(b) { b.classList.remove('active'); });
    if (tabs[0]) tabs[0].classList.add('active');
    currentType = c.tabs[0];
    updateWsp();
  }

  function initTimer() {
    var stored = parseInt(sessionStorage.getItem(TIMER_KEY) || '0', 10);
    var end = (stored && stored > Date.now()) ? stored : Date.now() + 48 * 3600 * 1000;
    sessionStorage.setItem(TIMER_KEY, String(end));
    return end;
  }

  function tick(end) {
    var d = Math.max(0, end - Date.now());
    var h = Math.floor(d / 3600000);
    var m = Math.floor((d % 3600000) / 60000);
    var s = Math.floor((d % 60000) / 1000);
    var pad = function(n) { return String(n).padStart(2, '0'); };
    set('pop-th', pad(h));
    set('pop-tm', pad(m));
    set('pop-ts', pad(s));
  }

  function closePopup() {
    var overlay = document.getElementById('offer-overlay');
    if (!overlay) return;
    overlay.style.transition = 'opacity 0.25s ease';
    overlay.style.opacity = '0';
    setTimeout(function() { overlay.classList.remove('is-visible'); }, 260);
    sessionStorage.setItem(SEEN_KEY, '1');
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (sessionStorage.getItem(SEEN_KEY)) return;
    var overlay = document.getElementById('offer-overlay');
    if (!overlay) return;

    applyLang(detectLang());

    setTimeout(function () {
      overlay.classList.add('is-visible');
      var end = initTimer();
      tick(end);
      setInterval(function() { tick(end); }, 1000);
    }, DELAY_MS);

    var closeBtn = document.getElementById('pop-close');
    var dismiss  = document.getElementById('pop-dismiss');
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    if (dismiss)  dismiss.addEventListener('click', closePopup);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closePopup(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePopup(); });

    var tabs = document.querySelectorAll('#offer-card .stab');
    tabs.forEach(function(btn, i) {
      btn.addEventListener('click', function() {
        tabs.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        currentType = copy[lang].tabs[i];
        updateWsp();
      });
    });
  });
})();
</script>
