---
// SpecialOfferPopup.astro
// Oferta flash $99 USD — aparece una vez por sesión en home y /prices
// Uso: importar en index.astro y prices.astro
//   import SpecialOfferPopup from '../components/SpecialOfferPopup.astro';
//   <SpecialOfferPopup />
---

<div id="offer-overlay" aria-modal="true" role="dialog" aria-labelledby="offer-title">
  <div id="offer-card">

    <div class="photo-col">
      <img
        src="https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION/Mady%26Sven-%40-25.JPG"
        alt="Sesión fotográfica en Hội An"
        loading="eager"
      />
      <div class="photo-top-badge">
        <div class="pulse"></div>
        <span>Hội An, Vietnam</span>
      </div>
      <div class="photo-bottom">
        <p class="photo-quote">"Capturó algo que nunca podríamos haber posado."</p>
        <span class="photo-cite">— Mandy &amp; Swen, Berlín</span>
      </div>
    </div>

    <div class="content-col">
      <div class="top-strip">
        <div class="strip-left">
          <div class="strip-dot"></div>
          <span class="strip-label">Oferta flash · solo hoy</span>
        </div>
        <div class="strip-timer">
          <span class="st-num" id="pop-th">23</span><span class="st-sep">h</span>
          <span class="st-num" id="pop-tm">59</span><span class="st-sep">m</span>
          <span class="st-num" id="pop-ts">59</span><span class="st-sep">s</span>
        </div>
      </div>

      <div class="body">
        <button
          class="close-btn"
          id="offer-close"
          aria-label="Cerrar oferta"
          type="button"
        >×</button>

        <div class="session-tabs" role="group" aria-label="Tipo de sesión">
          <button class="stab active" data-type="Familia" type="button">Familia</button>
          <button class="stab" data-type="Pareja" type="button">Pareja</button>
          <button class="stab" data-type="Branding" type="button">Branding</button>
        </div>

        <h2 id="offer-title" class="hl">Momentos<br /><em>honestamente</em><br />capturados.</h2>
        <p class="sub">Luz natural. Sin posados forzados. Hội An como escenario.</p>

        <div class="divider"></div>

        <div class="price-row">
          <span class="pcur">USD</span>
          <span class="pmain">99</span>
          <span class="pold">$160</span>
          <span class="psave">– 38%</span>
        </div>
        <p class="pnote">Precio habitual $160 · Solo durante las próximas 24 horas</p>

        <div class="spots">
          <span class="spot-dot">●</span>
          <span>Solo 3 fechas disponibles este mes</span>
          <div class="sbar"><div class="sfill"></div></div>
        </div>

        <div class="grid">
          <div class="gi">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="gi-ico" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <div class="gi-text"><strong>1 hora</strong>sesión completa</div>
          </div>
          <div class="gi">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="gi-ico" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <div class="gi-text"><strong>25+ fotos</strong>editadas</div>
          </div>
          <div class="gi">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="gi-ico" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            <div class="gi-text"><strong>Sneak peek</strong>en 24 horas</div>
          </div>
          <div class="gi">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="gi-ico" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <div class="gi-text"><strong>Galería</strong>privada online</div>
          </div>
        </div>

        <div class="bonus">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="bonus-ico" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
          <div class="bonus-txt">
            <strong>Bonus:</strong> Guía de preparación — outfits, luz dorada y locaciones según tu sesión. Enviada por WhatsApp al confirmar.
          </div>
        </div>

        <div class="social-row">
          <div class="avatars" aria-hidden="true">
            <div class="av">M</div>
            <div class="av">S</div>
            <div class="av">R</div>
            <div class="av">+</div>
          </div>
          <p class="social-text"><strong>47 personas</strong> reservaron sesión este año en Hội An</p>
        </div>

        <a
          href="/contact"
          id="offer-cta"
          class="cta"
          role="button"
        >Reservar sesión Familia por $99 →</a>

        <button
          class="cta2"
          id="offer-dismiss"
          type="button"
        >No gracias, prefiero pagar precio completo</button>

        <div class="trust" aria-label="Garantías">
          <span class="tr">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Sin pago previo
          </span>
          <span class="tr">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Residente local
          </span>
          <span class="tr">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            WhatsApp 24h
          </span>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── Overlay ── */
  #offer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(8, 6, 4, 0.78);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font-family: 'DM Sans', -apple-system, sans-serif;
    animation: fadeIn 0.35s ease;
  }
  #offer-overlay.is-visible {
    display: flex;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Card ── */
  #offer-card {
    background: #faf8f4;
    max-width: 600px;
    width: 100%;
    display: flex;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid #e0d8cc;
    animation: slideUp 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Photo column ── */
  .photo-col {
    width: 200px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    background: #d0c8b8;
  }
  .photo-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.82);
  }
  .photo-top-badge {
    position: absolute;
    top: 0; left: 0; right: 0;
    background: rgba(10, 8, 5, 0.72);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .pulse {
    width: 7px; height: 7px;
    background: #c8a84a;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pl 1.4s ease-in-out infinite;
  }
  @keyframes pl {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.8); }
  }
  .photo-top-badge span {
    font-size: 10px;
    color: #e8d088;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .photo-bottom {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: rgba(8, 6, 4, 0.78);
    padding: 14px;
  }
  .photo-quote {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 13px;
    color: rgba(255,255,255,0.88);
    font-style: italic;
    line-height: 1.5;
    font-weight: 300;
    margin-bottom: 6px;
  }
  .photo-cite {
    font-size: 10px;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* ── Content column ── */
  .content-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .top-strip {
    background: #1a1812;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .strip-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .strip-dot {
    width: 8px; height: 8px;
    background: #c8a84a;
    border-radius: 50%;
    flex-shrink: 0;
    animation: pl 1.4s ease-in-out infinite;
  }
  .strip-label {
    font-size: 13px;
    color: #e8d088;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .strip-timer {
    display: flex;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
  }
  .st-num {
    font-size: 14px;
    color: #e8d088;
    font-weight: 500;
    min-width: 22px;
    display: inline-block;
    text-align: center;
  }
  .st-sep {
    color: #6a5a28;
    font-size: 13px;
    font-weight: 500;
    margin: 0 1px;
  }

  /* ── Body ── */
  .body {
    padding: 20px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #faf8f4;
  }
  .close-btn {
    align-self: flex-end;
    background: none;
    border: none;
    color: #c0b8a8;
    font-size: 22px;
    cursor: pointer;
    line-height: 1;
    margin-bottom: 6px;
    transition: color 0.2s;
    padding: 0;
  }
  .close-btn:hover { color: #1a1812; }

  /* ── Tabs ── */
  .session-tabs {
    display: flex;
    gap: 6px;
    margin-bottom: 18px;
  }
  .stab {
    flex: 1;
    background: transparent;
    border: 1px solid #e0d8cc;
    color: #a09888;
    font-family: inherit;
    font-size: 11px;
    padding: 8px 4px;
    border-radius: 2px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
    letter-spacing: 0.04em;
  }
  .stab.active {
    background: #faf6ea;
    border-color: #c8a84a;
    color: #8B6914;
  }
  .stab:hover:not(.active) {
    border-color: #c0b8a8;
    color: #6a6050;
  }

  /* ── Headline ── */
  .hl {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 31px;
    color: #1a1812;
    line-height: 1.1;
    font-weight: 300;
    margin-bottom: 5px;
  }
  .hl em {
    font-style: italic;
    font-weight: 600;
    color: #8B6914;
  }
  .sub {
    font-size: 12px;
    color: #8a8070;
    line-height: 1.6;
    margin-bottom: 14px;
  }
  .divider {
    height: 1px;
    background: #e8e2d8;
    margin-bottom: 14px;
  }

  /* ── Price ── */
  .price-row {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    margin-bottom: 4px;
  }
  .pcur {
    font-size: 14px;
    color: #a09888;
    align-self: flex-start;
    margin-top: 8px;
    font-weight: 300;
  }
  .pmain {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 50px;
    color: #1a1812;
    font-weight: 600;
    line-height: 1;
  }
  .pold {
    font-size: 14px;
    color: #c0b8a8;
    text-decoration: line-through;
    font-weight: 300;
    align-self: flex-end;
    margin-bottom: 5px;
  }
  .psave {
    font-size: 11px;
    background: #eaf4e0;
    color: #3b6d11;
    border: 1px solid #c0dda0;
    padding: 3px 8px;
    border-radius: 2px;
    font-weight: 500;
    align-self: flex-end;
    margin-bottom: 5px;
  }
  .pnote {
    font-size: 11px;
    color: #b0a898;
    margin-bottom: 12px;
  }

  /* ── Spots ── */
  .spots {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: #c85a30;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .sbar {
    flex: 1;
    height: 2px;
    background: #e8e2d8;
    border-radius: 2px;
    overflow: hidden;
  }
  .sfill {
    height: 100%;
    width: 70%;
    background: #c85a30;
    border-radius: 2px;
  }

  /* ── Includes grid ── */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
    margin-bottom: 12px;
  }
  .gi {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    background: #f4f0e8;
    border: 1px solid #e8e2d8;
    border-radius: 2px;
    padding: 8px 9px;
  }
  .gi-ico {
    color: #8B6914;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .gi-text {
    font-size: 11px;
    color: #6a6050;
    line-height: 1.4;
  }
  .gi-text strong {
    display: block;
    color: #3a3020;
    font-weight: 500;
    font-size: 11px;
    margin-bottom: 1px;
  }

  /* ── Bonus ── */
  .bonus {
    background: #fffbf0;
    border: 1px solid #e8d89a;
    border-radius: 3px;
    padding: 10px 12px;
    margin-bottom: 12px;
    display: flex;
    gap: 9px;
    align-items: flex-start;
  }
  .bonus-ico {
    color: #ba7517;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .bonus-txt {
    font-size: 11px;
    color: #7a6040;
    line-height: 1.55;
  }
  .bonus-txt strong {
    color: #4a3010;
    font-weight: 500;
  }

  /* ── Social proof ── */
  .social-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 11px 14px;
    background: #f4f0e8;
    border: 1px solid #e8e2d8;
    border-radius: 3px;
  }
  .avatars { display: flex; }
  .av {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 2px solid #faf8f4;
    overflow: hidden;
    margin-left: -7px;
    background: #d0c8b8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    color: #6a5a48;
    font-weight: 500;
    flex-shrink: 0;
  }
  .av:first-child { margin-left: 0; }
  .social-text {
    font-size: 12px;
    color: #6a6050;
    line-height: 1.4;
    flex: 1;
  }
  .social-text strong {
    color: #2a2018;
    font-weight: 500;
  }

  /* ── CTAs ── */
  .cta {
    display: block;
    width: 100%;
    background: #c8a84a;
    color: #1a1208;
    border: none;
    padding: 15px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 2px;
    text-align: center;
    text-decoration: none;
    transition: background 0.2s;
    margin-bottom: 8px;
  }
  .cta:hover { background: #daba5a; }
  .cta:active { background: #b89838; }

  .cta2 {
    width: 100%;
    background: transparent;
    color: #a09888;
    border: 1px solid #e0d8cc;
    padding: 10px;
    font-family: inherit;
    font-size: 11px;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.2s;
  }
  .cta2:hover {
    color: #6a6050;
    border-color: #c0b8a8;
  }

  /* ── Trust bar ── */
  .trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
    padding-top: 11px;
    border-top: 1px solid #e8e2d8;
    flex-wrap: wrap;
  }
  .tr {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: #a09888;
  }
  .tr svg { color: #a09888; }

  /* ── Mobile ── */
  @media (max-width: 540px) {
    #offer-card { flex-direction: column; }
    .photo-col {
      width: 100%;
      height: 180px;
    }
    .hl { font-size: 26px; }
    .pmain { font-size: 40px; }
  }
</style>

<script is:inline>
(function () {
  const STORAGE_KEY = 'cris_offer_seen';
  const TIMER_KEY   = 'cris_offer_end';

  function initTimer() {
    let end = parseInt(sessionStorage.getItem(TIMER_KEY) || '0', 10);
    if (!end || end < Date.now()) {
      end = Date.now() + 24 * 3600 * 1000;
      sessionStorage.setItem(TIMER_KEY, String(end));
    }
    return end;
  }

  function tick(end) {
    const d = Math.max(0, end - Date.now());
    const h = Math.floor(d / 3600000);
    const m = Math.floor((d % 3600000) / 60000);
    const s = Math.floor((d % 60000) / 1000);
    const pad = n => String(n).padStart(2, '0');
    const eh = document.getElementById('pop-th');
    const em = document.getElementById('pop-tm');
    const es = document.getElementById('pop-ts');
    if (eh) eh.textContent = pad(h);
    if (em) em.textContent = pad(m);
    if (es) es.textContent = pad(s);
  }

  function close() {
    const overlay = document.getElementById('offer-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      overlay.style.transition = 'opacity 0.25s ease';
      setTimeout(() => { overlay.classList.remove('is-visible'); }, 260);
    }
    sessionStorage.setItem(STORAGE_KEY, '1');
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (sessionStorage.getItem(STORAGE_KEY)) return;

    const overlay = document.getElementById('offer-overlay');
    if (!overlay) return;

    // Show after 3s
    setTimeout(function () {
      overlay.classList.add('is-visible');

      const end = initTimer();
      tick(end);
      setInterval(function () { tick(end); }, 1000);
    }, 3000);

    // Close buttons
    document.getElementById('offer-close')?.addEventListener('click', close);
    document.getElementById('offer-dismiss')?.addEventListener('click', close);

    // Close on overlay click (outside card)
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    // Tabs
    const tabs = document.querySelectorAll('.stab');
    const cta  = document.getElementById('offer-cta');
    tabs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const type = btn.dataset.type;
        if (cta) cta.textContent = 'Reservar sesión ' + type + ' por $99 →';
      });
    });
  });
})();
</script>
