---
import { publishedPrints, sizes, type Lang } from '../data/prints';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const base = lang === 'es' ? '/es/prints' : '/prints';
const t = {
  en: { kicker: 'Fine art prints', title: 'Prints', lead: 'Stories from Vietnam for your wall. Each photograph is printed on cotton fine art paper, hand-signed, and comes with the story behind the moment.', from: 'From' },
  es: { kicker: 'Prints fine art', title: 'Prints', lead: 'Historias de Vietnam para tu muro. Cada fotografía se imprime en papel fine art de algodón, va firmada a mano y viene con la historia detrás del momento.', from: 'Desde' },
}[lang];
---
<main class="pi">
  <header class="pi-head">
    <p class="pi-kicker">{t.kicker}</p>
    <h1>{t.title}</h1>
    <p class="pi-lead">{t.lead}</p>
  </header>
  <div class="pi-grid">
    {publishedPrints.map((p) => (
      <a href={`${base}/${p.slug}`} class="pi-card">
        <img src={p.image} alt={p.alt[lang]} loading="lazy" />
        <span class="pi-card-title">{p.title[lang]}</span>
        <span class="pi-card-place">{p.place}</span>
        <span class="pi-card-price">{t.from} ${sizes[0].price} USD</span>
      </a>
    ))}
  </div>
</main>
<style>
  .pi { max-width: 1360px; margin: 0 auto; padding: calc(var(--nav-height, 80px) + 3rem) 5vw 6rem; color: #14110d; }
  .pi-head { max-width: 46rem; margin-bottom: 3.5rem; }
  .pi-kicker { margin: 0 0 0.75rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #7d5820; }
  .pi h1 { margin: 0; font-family: var(--font-serif); font-size: clamp(2.8rem, 6vw, 4.5rem); font-weight: 400; line-height: 1; }
  .pi-lead { margin: 1.25rem 0 0; font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.6; color: #3a352e; }
  .pi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 3rem 2.5rem; }
  .pi-card { display: flex; flex-direction: column; gap: 0.35rem; text-decoration: none; color: #14110d; }
  .pi-card img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; margin-bottom: 0.75rem; transition: opacity 0.3s ease; }
  .pi-card:hover img { opacity: 0.9; }
  .pi-card-title { font-family: var(--font-serif); font-size: 1.6rem; }
  .pi-card-place { font-family: var(--font-serif); font-style: italic; color: #5c554b; }
  .pi-card-price { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: #5c554b; }
</style>
