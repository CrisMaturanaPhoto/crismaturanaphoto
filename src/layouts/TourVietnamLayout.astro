    <script>
      function setLang(lang: 'es' | 'en') {
        const root = document.querySelector('.tour-vn-page');
        if (!root) return;
        root.classList.remove('lang-es', 'lang-en');
        root.classList.add('lang-' + lang);
        document.documentElement.lang = lang;
        document.querySelectorAll('.lang-btn').forEach((b) => {
          const active = (b as HTMLButtonElement).dataset.lang === lang;
          b.classList.toggle('active', active);
          b.setAttribute('aria-pressed', String(active));
        });
      }

      document.querySelectorAll('.lang-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const lang = (btn as HTMLButtonElement).dataset.lang as 'es' | 'en';
          if (lang) setLang(lang);
        });
      });

      function swapMain(imgId: string, src: string) {
        const img = document.getElementById(imgId) as HTMLImageElement | null;
        if (!img) return;
        img.style.opacity = '0';
        img.style.transition = 'opacity 0.2s';
        setTimeout(() => {
          img.src = src;
          img.style.opacity = '1';
        }, 200);
      }
      (window as unknown as { swapMain: typeof swapMain }).swapMain = swapMain;

      const reveals = document.querySelectorAll('.reveal');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) e.target.classList.add('visible');
          });
        },
        { threshold: 0.12 }
      );
      reveals.forEach((el) => observer.observe(el));

      const header = document.getElementById('tour-site-header');
      if (header) {
        window.addEventListener(
          'scroll',
          () => {
            header.style.boxShadow = window.scrollY > 10 ? '0 2px 20px rgba(0,0,0,0.06)' : 'none';
          },
          { passive: true }
        );
      }
    </script>
