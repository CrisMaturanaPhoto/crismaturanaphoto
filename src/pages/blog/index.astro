---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.lang || post.data.lang === 'en')
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.slug !== featuredPost.slug);
const categories = [...new Set(posts.map((post) => post.data.category))];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<Layout title="Blog – Cristóbal Maturana" description="Photography, travel, and visual storytelling articles by Cristóbal Maturana.">
  <section class="page-hero">
    <p class="hero-label">Words and Stories</p>
    <h1>The Journal</h1>
    <p class="hero-sub">Thoughts on photography, travel, and the art of seeing</p>
  </section>

  <div class="filter-bar">
    <button class="filter-btn active" data-filter="all">All</button>
    {categories.map((category) => (
      <button class="filter-btn" data-filter={category}>{category}</button>
    ))}
  </div>

  {featuredPost && (
    <div class="featured-wrapper container">
      <article class="featured-post">
        <a class="featured-img" href={`/blog/${featuredPost.slug}`}>
          <img src={featuredPost.data.coverImage} alt={featuredPost.data.title} loading="lazy" />
        </a>
        <div class="featured-body">
          <span class="featured-badge">Featured</span>
          <p class="post-tag">{featuredPost.data.category}</p>
          <h2>{featuredPost.data.title}</h2>
          <p class="post-meta">
            <span>{formatDate(featuredPost.data.publishDate)}</span>
            <span>{featuredPost.data.readTime}</span>
          </p>
          <p class="post-excerpt">{featuredPost.data.excerpt}</p>
          <a class="read-link" href={`/blog/${featuredPost.slug}`} data-en="Read Article" data-es="Leer Artículo">Read Article</a>
        </div>
      </article>
    </div>
  )}

  <section class="grid-section container">
    <p class="section-label">Latest Stories</p>
    <div class="blog-grid">
      {latestPosts.map((post) => (
        <article class="post-card" data-category={post.data.category}>
          <a class="card-img" href={`/blog/${post.slug}`}>
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              loading="lazy"
              style={`object-position: ${post.slug === 'quiet-portrait' ? 'center top' : 'center'};`}
            />
          </a>
          <p class="card-tag">{post.data.category}</p>
          <h3 class="card-title">{post.data.title}</h3>
          <p class="card-meta">{formatDate(post.data.publishDate)} - {post.data.readTime}</p>
          <p class="card-excerpt">{post.data.excerpt}</p>
          <a class="card-link" href={`/blog/${post.slug}`} data-en="Read More" data-es="Leer Más">Read More</a>
        </article>
      ))}
    </div>
  </section>
<script is:inline>
(function(){
  var l=(navigator.language||'en').toLowerCase();
  var es=l.startsWith('es');
  document.querySelectorAll('[data-en][data-es]').forEach(function(el){
    el.textContent=es?el.dataset.es:el.dataset.en;
  });
})();
</script>
</Layout>

<style>
  .page-hero {
    margin-top: var(--nav-height);
    padding: 80px 2rem 56px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .hero-label {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }

  .page-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-heading);
    position: relative;
    z-index: 1;
  }

  .hero-sub {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
    position: relative;
    z-index: 1;
  }

  .filter-bar {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    padding: 32px 2rem 0;
  }

  .filter-btn {
    padding: 6px 18px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-heading);
  }

  .featured-wrapper {
    margin-top: 56px;
  }

  .featured-post {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .featured-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .featured-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .featured-post:hover .featured-img img {
    transform: scale(1.04);
  }

  .featured-body {
    padding: 48px;
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-badge {
    display: inline-block;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-heading);
    padding: 4px 10px;
    margin-bottom: 18px;
    font-weight: 700;
    width: fit-content;
  }

  .post-tag {
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .featured-body h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.4vw, 2.3rem);
    line-height: 1.2;
    margin-bottom: 18px;
  }

  .post-meta {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }

  .post-meta span {
    margin-right: 16px;
  }

  .post-excerpt {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 26px;
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.2s, gap 0.2s;
    font-weight: 700;
    width: fit-content;
  }

  .read-link::after {
    content: '→';
  }

  .read-link:hover {
    color: var(--color-accent);
    gap: 14px;
  }

  .grid-section {
    margin: 64px auto 80px;
  }

  .section-label {
    color: var(--color-text-muted);
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px 28px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
  }

  .post-card.hidden {
    display: none;
  }

  .card-img {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin-bottom: 18px;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-card:hover .card-img img {
    transform: scale(1.04);
  }

  .card-tag {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: 10px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.24rem;
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .card-meta {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }

  .card-excerpt {
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 18px;
    flex: 1;
  }

  .card-link {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s, gap 0.2s;
    font-weight: 700;
  }

  .card-link::after {
    content: '→';
  }

  .card-link:hover {
    color: var(--color-accent);
    gap: 12px;
  }

  @media (max-width: 980px) {
    .featured-post {
      grid-template-columns: 1fr;
    }

    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 56px 1.25rem 36px;
    }

    .filter-bar {
      padding: 24px 1.25rem 0;
    }

    .featured-body {
      padding: 28px 22px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.post-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      filterButtons.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');

      const filter = button.dataset.filter;
      cards.forEach((card) => {
        const category = card.dataset.category;
        const show = filter === 'all' || category === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
