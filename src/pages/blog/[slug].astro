---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'es');
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/-es$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-ES', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  }).format(date);
---

<Layout title={`${post.data.title} – Blog – Cristóbal Maturana`} description={post.data.excerpt}>
  <article class="post container">
    <header class="post-header">
      <a class="back-link" href="/es/blog">Volver al Blog</a>
      <p class="post-tag">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <span>{formatDate(post.data.publishDate)}</span>
        <span>{post.data.readTime}</span>
      </p>
    </header>

    <img class="cover-image" src={post.data.coverImage} alt={post.data.title} width="1200" height="800" loading="eager" fetchpriority="high" />

    <div class="post-body">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 860px;
    margin-top: calc(var(--nav-height) + 2.5rem);
    margin-bottom: 3.5rem;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
    transition: color 0.2s;
  }

  .back-link::before {
    content: '←';
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-tag {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 700;
    margin-bottom: 0.9rem;
  }

  .post-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--color-heading);
  }

  .post-meta {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }

  .post-meta span {
    margin-right: 1rem;
  }

  .cover-image {
    width: 100%;
    border: 1px solid var(--color-border);
    margin-bottom: 2.2rem;
  }

  .post-body {
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .post-body :global(p) {
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: var(--font-serif);
    color: var(--color-heading);
    margin: 2rem 0 0.8rem;
    line-height: 1.2;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.2rem;
    margin-bottom: 1.2rem;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>