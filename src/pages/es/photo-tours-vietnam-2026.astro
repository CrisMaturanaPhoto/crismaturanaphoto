<div class="pt-page">

  <!-- HERO -->
  <section class="pt-hero">
    <img
      src="https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-1.JPG"
      alt="Pescadores vietnamitas con botes de bambú al amanecer — photo tour Hội An"
      class="pt-hero-img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="pt-hero-overlay"></div>
    <div class="pt-hero-content">
      <span class="pt-hero-eyebrow">Hội An · Vietnam · 2026</span>
      <h1>Fotografía Vietnam<br><em>como realmente es</em></h1>
      <p class="pt-hero-sub">
        Tres tours fotográficos privados guiados por un fotógrafo local. Pueblos de pescadores, calles antiguas, vida en el río al amanecer. Tarifas grupales y privadas disponibles. Sin apuro. Sin masas.
      </p>
      <div class="pt-hero-ctas">
        <a href="#tours" class="pt-btn-primary">Ver los Tours ↓</a>
        <a href="/es/contact" class="pt-btn-ghost">Reservar Fecha</a>
