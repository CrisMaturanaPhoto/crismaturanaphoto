<script is:inline>
  document.querySelectorAll('[data-tour]').forEach(function(summary) {
    var tourId = summary.dataset.tour;
    var detail = document.getElementById('detail-' + tourId);
    var detailBtn = document.querySelector('[data-details-btn="' + tourId + '"]');
    var hint = document.querySelector('[data-hint="' + tourId + '"]');
    function toggle(e) {
      if (e.target && e.target.closest('a')) return;
      var isOpen = detail.classList.contains('open');
      detail.classList.toggle('open', !isOpen);
      summary.setAttribute('aria-expanded', String(!isOpen));
      if (detailBtn) {
        detailBtn.setAttribute('aria-expanded', String(!isOpen));
        detailBtn.classList.toggle('open', !isOpen);
      }
      if (hint) hint.classList.toggle('open', !isOpen);
      if (!isOpen) {
        setTimeout(function() { detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 100);
      }
    }
    summary.addEventListener('click', toggle);
    summary.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(e); }
    });
    if (detailBtn) {
      detailBtn.addEventListener('click', function(e) { e.stopPropagation(); toggle(e); });
    }
  });

  document.querySelectorAll('.pt-tour-detail').forEach(function(detail) {
    var track = detail.querySelector('[data-track]');
    var dots = detail.querySelectorAll('[data-dot]');
    var prevBtn = detail.querySelector('[data-prev]');
    var nextBtn = detail.querySelector('[data-next]');
    if (!track) return;
    var imgs = track.querySelectorAll('img');
    var total = imgs.length;
    var idx = 0;
    function go(n) {
      idx = (n + total) % total;
      track.style.transform = 'translateX(-' + (idx * 100) + '%)';
      dots.forEach(function(d, i) { d.classList.toggle('active', i === idx); });
    }
    if (prevBtn) prevBtn.addEventListener('click', function() { go(idx - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { go(idx + 1); });
    dots.forEach(function(d) {
      d.addEventListener('click', function() { go(parseInt(d.dataset.dot)); });
    });
  });

  document.querySelectorAll('[data-faq]').forEach(function(item) {
    item.addEventListener('click', function() {
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('[data-faq]').forEach(function(el) { el.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });
</script>

</Layout>
