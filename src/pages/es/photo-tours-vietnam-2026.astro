  .pt-final-overlay { position: absolute; inset: 0; background: rgba(10,8,5,0.78); }
  .pt-final-content { position: relative; z-index: 2; padding: 7rem 2rem; max-width: 700px; margin: 0 auto; text-align: center; }
  .pt-final-content .pt-section-label { color: var(--color-accent); }
  .pt-final-content h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 400; color: #fff; line-height: 1.2; margin-bottom: 1rem; }
  .pt-final-content p { font-size: 1rem; color: rgba(255,255,255,0.68); line-height: 1.75; margin-bottom: 2.5rem; }
