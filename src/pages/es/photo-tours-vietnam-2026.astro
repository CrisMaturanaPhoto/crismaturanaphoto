  </section>

  <!-- TRUST BAR -->
  <div class="pt-trust" role="complementary">
    <div class="pt-trust-inner">
      <span class="pt-trust-item"><span class="pt-trust-dot">◆</span> <strong>Grupal o privado</strong> — tú decides</span>
      <span class="pt-trust-item"><span class="pt-trust-dot">◆</span> <strong>Todos los niveles</strong> bienvenidos</span>
      <span class="pt-trust-item"><span class="pt-trust-dot">◆</span> <strong>Todo el año</strong> disponible</span>
      <span class="pt-trust-item"><span class="pt-trust-dot">◆</span> <strong>Fotógrafo local</strong> — vive en Hội An</span>
