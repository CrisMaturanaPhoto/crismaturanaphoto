---
import Layout from '../../layouts/Layout.astro';
import { buildAlternates } from '../../lib/utils';

const alternates = buildAlternates('/photo-tours-vietnam-2026', '/es/photo-tours-vietnam-2026');

const tours = [
  {
    id: 'duy-hai',
    num: '01',
    badge: 'COSTA · DOCUMENTAL',
    name: 'Amanecer en el Pueblo Pesquero',
    sessionValue: 'Photo Tour – Dawn at the Fishing Village',
    location: 'Duy Hai · 40 min de Hội An',
    tagline: 'Botes de bambú, aire salado y pescadores clasificando la captura al borde de la primera luz.',
    time: '4:30 – 8:30 AM',
    duration: '3,5 horas',
    groupSize: 'Máx. 4 personas',
    level: 'Todos los niveles',
    groupPrice: '$60 USD',
    groupPriceVnd: '1.600.000 VND',
    privatePrice: '$150 USD',
    privatePriceVnd: '3.950.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-1.JPG',
    heroAlt: 'Pescadores vietnamitas con botes de bambú al amanecer dorado en Duy Hai',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHay2HoiAn%40-0001.JPG', alt: 'Pueblo pesquero de Duy Hai con luz matinal' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-10.JPG', alt: 'Botes de bambú saliendo antes del amanecer' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-15.JPG', alt: 'Mercado de pescado fresco en Duy Hai' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHay2HoiAn%40-21.JPG', alt: 'Siluetas de barcos tradicionales en hora dorada' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-1.JPG', alt: 'Pescadores en Duy Hai al amanecer' },
    ],
    shots: [
      'Botes de bambú redondos (thuyền thúng) saliendo antes del amanecer',
      'Pescadores clasificando la captura nocturna sobre la arena mojada',
      'El mercado espontáneo de pescado — caras, color, movimiento',
      'Barcos tradicionales en silueta contra un horizonte dorado',
      'Olas en larga exposición y reflejos de embarcaciones en la orilla',
    ],
    includes: ['Transporte privado de ida y vuelta desde Hội An', 'Café y bánh mì', 'Coaching fotográfico en tiempo real', 'Lista de encuadres y guía de composición'],
    description: 'La mayoría de los visitantes nunca llegan a Duy Hai. El pueblo despierta antes de las 4 AM — pescadores que regresan, redes que se reparan, el mercado espontáneo que aparece sobre la arena. Estarás ahí con un fotógrafo que conoce a estos hombres por su nombre, en el preciso instante en que la luz se vuelve dorada y el caos se vuelve hermoso.',
  },
  {
    id: 'old-town',
    num: '02',
    badge: 'MÁS SOLICITADO · CALLE · ARQUITECTURA',
    name: 'Old Town Antes de los Turistas',
    sessionValue: 'Photo Tour – Old Town Before the Crowds',
    location: 'Casco Antiguo de Hội An · Patrimonio UNESCO',
    tagline: 'Las paredes amarillas, el mercado matutino, el Hội An real — fotografiado antes de que lleguen los turistas.',
    time: '6:00 – 9:00 AM',
    duration: '3 horas',
    groupSize: 'Máx. 5 personas',
    level: 'Todos los niveles',
    groupPrice: '$40 USD',
    groupPriceVnd: '1.100.000 VND',
    privatePrice: '$129 USD',
    privatePriceVnd: '3.400.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-32.jpg',
    heroAlt: 'Calles vacías del Casco Antiguo de Hội An con luz dorada de la mañana',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/market-001.JPG', alt: 'Vendedora en el mercado con productos coloridos' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-37.jpg', alt: 'Vendedores en el mercado matutino de Hội An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-39.JPG', alt: 'Esquina con pared amarilla al amanecer' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-43.jpg', alt: 'Vida en las calles de Old Town, Hội An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-32.jpg', alt: 'Tejados de Hội An con luz matinal' },
    ],
    shots: [
      'Paredes amarillas UNESCO con luz rasante matinal — textura, sombra, profundidad',
      'Callejones vacíos y fachadas icónicas antes de que empiece el día',
      'El mercado matutino: fruta tropical, mariscos frescos, vendedoras con sombreros cónicos',
      'Color y vida callejera auténtica — el Hội An real, no la versión de postal',
      'El Puente Japonés Cubierto — arquitectura, simetría, quietud',
    ],
    includes: ['Tour a pie (sin transporte)', 'Desayuno juntos en el mercado', 'Revisión completa de imágenes en tiempo real'],
    description: 'A las 7 AM Old Town pertenece a los turistas. A las 6 AM todavía pertenece a los locales — los vendedores acomodando sus puestos, las motos cruzando callejones estrechos, la luz deslizándose en ángulo bajo sobre esas famosas paredes amarillas. Este es el tour del que la gente vuelve diciendo "finalmente conseguí la foto por la que vine a Vietnam".',
  },
  {
    id: 'thu-bon',
    num: '03',
    badge: 'DOCUMENTAL · PAISAJE · BOTE',
    name: 'Vida en el Río a la Hora Dorada',
    sessionValue: 'Photo Tour – River Life at Golden Hour',
    location: 'Río Thu Bon · Campos de Hội An',
    tagline: 'Luz cálida de tarde, un bote de madera y pescadores lanzando redes mientras el río se vuelve dorado.',
    time: '3:30 – 6:30 PM',
    duration: '3 horas',
    groupSize: 'Máx. 4 personas',
    level: 'Todos los niveles',
    groupPrice: '$70 USD',
    groupPriceVnd: '1.850.000 VND',
    privatePrice: '$195 USD',
    privatePriceVnd: '5.150.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-004.JPEG',
    heroAlt: 'Pescador lanzando red en el Río Thu Bon a la hora dorada en Hội An',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-004.JPG', alt: 'Vida en el río Thu Bon a la hora dorada' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-001.JPEG', alt: 'Pescador tradicional en el Río Thu Bon' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-008.jpg', alt: 'Paisaje con luz de tarde en el Thu Bon' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-009.jpg', alt: 'Reflejos de palmeras en el río Thu Bon' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-004.JPEG', alt: 'Pescador lanzando red en el Río Thu Bon' },
    ],
    shots: [
      'Pescadores lanzando redes desde un bote de madera tradicional',
      'Luz dorada cálida reflejándose en el agua quieta como espejo',
      'Reflejos de palmeras y arrozales inundados',
      'Botes de bambú navegando canales estrechos del río',
      'Vida ribereña rural — agricultores, niños, ritmo cotidiano',
    ],
    includes: ['Bote de madera privado con guía fluvial local', 'Coaching fotográfico a bordo en tiempo real', 'Lista de encuadres e instrucciones de timing'],
    description: 'El Thu Bon a última hora de la tarde es algo que no puedes fotografiar desde la orilla. A medida que el sol baja, la luz convierte el agua en oro líquido y cada red lanzada se convierte en un encuadre perfecto. Necesitas un bote, el guía correcto y paciencia — este tour te da las tres cosas. La experiencia más meditativa de las tres, lenta y llena de encuadres que no encontrarás en ningún otro lugar.',
  },
];
---

<Layout
  title="Photo Tours Hội An, Vietnam 2026 — Tours Fotográficos Privados con Guía Local"
  description="Tres tours fotográficos privados en Hội An, Vietnam. Pueblos de pescadores, calles antiguas y vida fluvial al amanecer. Tarifas grupales y privadas. Guiados por Cristóbal Maturana."
  lang="es"
  canonical="https://crismaturana.com/es/photo-tours-vietnam-2026"
  alternates={alternates}
>

<!-- ═══ SCHEMA.ORG ═══ -->
<script type="application/ld+json" is:inline>{JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://crismaturana.com/es" },
        { "@type": "ListItem", "position": 2, "name": "Photo Tours Vietnam 2026", "item": "https://crismaturana.com/es/photo-tours-vietnam-2026" }
      ]
    },
    {
      "@type": "TouristTrip",
      "name": "Amanecer en el Pueblo Pesquero — Tour Fotográfico Duy Hai",
      "description": "Tour fotográfico privado al amanecer en el pueblo pesquero de Duy Hai, cerca de Hội An, Vietnam.",
      "touristType": "Fotógrafo",
      "offers": { "@type": "AggregateOffer", "lowPrice": "60", "highPrice": "150", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cristóbal Maturana" },
      "location": { "@type": "Place", "name": "Duy Hai, Quảng Nam, Vietnam" }
    },
    {
      "@type": "TouristTrip",
      "name": "Old Town Antes de los Turistas — Tour Fotográfico Hội An",
      "description": "Tour fotográfico privado matutino por el Casco Antiguo de Hội An Patrimonio UNESCO.",
      "touristType": "Fotógrafo",
      "offers": { "@type": "AggregateOffer", "lowPrice": "40", "highPrice": "129", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cristóbal Maturana" },
      "location": { "@type": "Place", "name": "Casco Antiguo de Hội An, Vietnam" }
    },
    {
      "@type": "TouristTrip",
      "name": "Vida en el Río a la Hora Dorada — Tour Fotográfico Río Thu Bon",
      "description": "Tour fotográfico privado en bote por el Río Thu Bon, Hội An. Pescadores lanzando redes, luz dorada de tarde y vida rural al atardecer.",
      "touristType": "Fotógrafo",
      "offers": { "@type": "AggregateOffer", "lowPrice": "70", "highPrice": "195", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cristóbal Maturana" },
      "location": { "@type": "Place", "name": "Río Thu Bon, Hội An, Vietnam" }
    }
  ]
})}</script>

<style>
  .pt-page { font-family: var(--font-sans); color: var(--color-text); }
  .pt-hero { position: relative; height: 100svh; min-height: 600px; max-height: 900px; overflow: hidden; display: flex; align-items: flex-end; }
  .pt-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .pt-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,8,5,0.85) 0%, rgba(10,8,5,0.35) 50%, rgba(10,8,5,0.08) 100%); }
  .pt-hero-content { position: relative; z-index: 2; padding: 0 2rem 4rem; max-width: 860px; margin: 0 auto; width: 100%; }
  .pt-hero-eyebrow { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 1rem; display: block; }
  .pt-hero h1 { font-family: var(--font-serif); font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 400; color: #fff; line-height: 1.1; margin-bottom: 1.25rem; letter-spacing: -0.01em; }
  .pt-hero h1 em { font-style: italic; }
  .pt-hero-sub { font-size: clamp(0.95rem, 1.6vw, 1.1rem); color: rgba(255,255,255,0.72); max-width: 520px; line-height: 1.7; margin-bottom: 2rem; font-weight: 300; }
  .pt-hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .pt-btn-primary { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; background: var(--color-accent); color: #1a1814; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; transition: background 0.25s, transform 0.15s; border: none; cursor: pointer; }
  .pt-btn-primary:hover { background: #b8934a; transform: translateY(-1px); }
  .pt-btn-ghost { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 2rem; border: 1px solid rgba(255,255,255,0.45); color: rgba(255,255,255,0.85); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; transition: border-color 0.25s, color 0.25s; cursor: pointer; background: transparent; }
  .pt-btn-ghost:hover { border-color: #fff; color: #fff; }
  .pt-scroll-arrow { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); z-index: 2; color: rgba(255,255,255,0.4); font-size: 1.4rem; animation: bounce 2s infinite; text-decoration: none; }
  @keyframes bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }
  .pt-trust { background: var(--color-heading); padding: 1.1rem 2rem; }
  .pt-trust-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: center; gap: 2.5rem; flex-wrap: wrap; }
  .pt-trust-item { display: flex; align-items: center; gap: 0.6rem; color: rgba(255,255,255,0.65); font-size: 0.76rem; font-weight: 400; letter-spacing: 0.05em; white-space: nowrap; }
  .pt-trust-item strong { color: rgba(255,255,255,0.9); font-weight: 700; }
  .pt-trust-dot { color: var(--color-accent); font-size: 0.9rem; line-height: 1; }
  .pt-section { padding: 5rem 2rem; }
  .pt-section-inner { max-width: 1160px; margin: 0 auto; }
  .pt-section-label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 0.75rem; display: block; }
  .pt-section-title { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.5vw, 2.8rem); font-weight: 400; color: var(--color-heading); line-height: 1.2; margin-bottom: 1rem; }
  .pt-section-intro { font-size: 1.05rem; color: var(--color-text-muted); max-width: 600px; line-height: 1.75; margin-bottom: 3.5rem; }
  .pt-tours-grid { display: grid; grid-template-columns: 1fr; gap: 0; border: 1px solid var(--color-border); }
  .pt-tour-card { border-bottom: 1px solid var(--color-border); overflow: hidden; }
  .pt-tour-card:last-child { border-bottom: none; }
  .pt-tour-summary { display: grid; grid-template-columns: 1fr 1fr; cursor: pointer; transition: background 0.2s; position: relative; }
  .pt-tour-summary:hover .pt-tour-img { transform: scale(1.03); }
  .pt-tour-img-wrap { overflow: hidden; aspect-ratio: 4/3; position: relative; }
  .pt-tour-img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 0.5s ease; display: block; }
  .pt-tour-img-wrap::after { content: ''; position: absolute; inset: 0; background: rgba(10,8,5,0); transition: background 0.3s; }
  .pt-tour-summary:hover .pt-tour-img-wrap::after { background: rgba(10,8,5,0.18); }
  .pt-tour-expand-hint { position: absolute; bottom: 1.25rem; right: 1.25rem; z-index: 3; width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.55); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.3rem; font-weight: 300; line-height: 1; transition: background 0.25s, transform 0.25s; pointer-events: none; }
  .pt-tour-summary:hover .pt-tour-expand-hint { background: rgba(201,169,110,0.85); border-color: transparent; transform: scale(1.08); }
  .pt-tour-expand-hint.open { background: rgba(201,169,110,0.9); border-color: transparent; }
  .pt-tour-expand-hint.open span { transform: rotate(45deg); display: inline-block; }
  .pt-tour-info { padding: 2.5rem 2.5rem 2rem; display: flex; flex-direction: column; justify-content: space-between; background: var(--color-bg); }
  .pt-tour-badge-wrap { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
  .pt-tour-num-tag { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); }
  .pt-tour-badge-tag { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); padding: 2px 8px; border: 1px solid var(--color-border); border-radius: 2px; }
  .pt-tour-info h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 400; color: var(--color-heading); line-height: 1.2; margin-bottom: 0.5rem; }
  .pt-tour-location { font-size: 0.75rem; color: var(--color-accent); letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; margin-bottom: 0.75rem; }
  .pt-tour-tagline { font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.65; margin-bottom: 1.75rem; font-style: italic; }
  .pt-tour-quickmeta { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 2rem; padding-bottom: 1.75rem; border-bottom: 1px solid var(--color-border); }
  .pt-qm-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); display: block; margin-bottom: 2px; }
  .pt-qm-val { font-size: 0.85rem; font-weight: 400; color: var(--color-heading); }
  .pt-tour-bottom { display: flex; flex-direction: column; gap: 1.25rem; }
  .pt-price-options { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .pt-price-option { display: flex; flex-direction: column; gap: 2px; }
  .pt-price-option-label { font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); }
  .pt-price-amount { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; color: var(--color-heading); letter-spacing: -0.01em; line-height: 1.15; }
  .pt-price-per { font-size: 0.68rem; color: var(--color-text-muted); margin-left: 3px; font-weight: 400; }
  .pt-price-vnd { font-size: 0.68rem; color: var(--color-text-muted); }
  .pt-tour-actions { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
  .pt-btn-book { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1.5rem; background: var(--color-accent); color: #1a1814; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .pt-btn-book:hover { background: #b8934a; transform: translateY(-1px); }
  .pt-btn-details { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.75rem 1.5rem; border: 1px solid var(--color-border); color: var(--color-text); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; background: transparent; cursor: pointer; transition: border-color 0.2s, color 0.2s; font-family: inherit; white-space: nowrap; }
  .pt-btn-details:hover { border-color: var(--color-heading); color: var(--color-heading); }
  .pt-btn-details .arrow { display: inline-block; transition: transform 0.3s; }
  .pt-btn-details.open .arrow { transform: rotate(180deg); }
  .pt-tour-detail { max-height: 0; overflow: hidden; transition: max-height 0.55s cubic-bezier(0.4, 0, 0.2, 1); background: var(--color-surface); border-top: 1px solid transparent; }
  .pt-tour-detail.open { max-height: 1400px; border-top-color: var(--color-border); }
  .pt-tour-detail-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 0; padding: 3rem 0; }
  .pt-detail-left { padding: 0 3rem 0 2.5rem; border-right: 1px solid var(--color-border); }
  .pt-detail-right { padding: 0 2.5rem 0 3rem; }
  .pt-detail-heading { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); margin-bottom: 1rem; display: block; }
  .pt-detail-desc { font-size: 0.95rem; line-height: 1.8; color: var(--color-text); margin-bottom: 2rem; }
  .pt-shots-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .pt-shots-list li { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.88rem; color: var(--color-text); line-height: 1.5; }
  .pt-shots-list li::before { content: ''; display: block; width: 20px; height: 1px; background: var(--color-accent); margin-top: 0.65em; flex-shrink: 0; }
  .pt-includes-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .pt-includes-list li { display: flex; gap: 0.75rem; align-items: flex-start; font-size: 0.88rem; color: var(--color-text); line-height: 1.5; }
  .pt-includes-list li::before { content: '✓'; color: var(--color-accent); font-weight: 700; font-size: 0.8rem; flex-shrink: 0; margin-top: 0.05em; }
  .pt-detail-slider { position: relative; width: 100%; overflow: hidden; border-radius: 2px; margin-bottom: 2rem; aspect-ratio: 16/9; }
  .pt-detail-track { display: flex; height: 100%; transition: transform 0.4s ease; will-change: transform; }
  .pt-detail-track img { width: 100%; height: 100%; flex-shrink: 0; object-fit: cover; display: block; }
  .pt-detail-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(10,8,5,0.6); color: #fff; border: none; cursor: pointer; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; z-index: 5; transition: background 0.2s; }
