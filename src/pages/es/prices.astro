---
import Layout from '../../layouts/Layout.astro';

---

<Layout
  title="Precios Sesiones de Retrato – Cristóbal Maturana Photo | Hội An, Vietnam"
  description="Sesiones de retrato familiar, branding personal y parejas en Hội An. Tres packages desde USD 150. Fotografía documental y orgánica con 15+ años de experiencia."
  lang="es"
  alternates={[
    { hreflang: 'es', href: 'https://crismaturana.com/es/prices' },
    { hreflang: 'en', href: 'https://crismaturana.com/prices' },
    { hreflang: 'x-default', href: 'https://crismaturana.com/prices' },
  ]}
>

  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Sesiones de Fotografía de Retrato",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Hội An", "addressCountry": "VN" }
      },
      "areaServed": "Hội An, Vietnam",
      "offers": [
        { "@type": "Offer", "name": "Familia Essentials", "price": "160", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Familia Story", "price": "250", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Familia Heritage", "price": "350", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Portrait", "price": "150", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Brand", "price": "290", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Presence", "price": "480", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Parejas Intimate", "price": "160", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Parejas Golden", "price": "280", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Parejas Journey", "price": "450", "priceCurrency": "USD" }
      ]
    })
  }</script>

  <div class="page-hero">
    <div class="container">
      <p class="hero-session-label">Retratos · Parejas & Familias</p>
      <h1>Precios de Sesión</h1>
      <p>Packages fijos para sesiones de retrato, parejas y familias — desde USD 150. Selecciona el tipo para explorar.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">

