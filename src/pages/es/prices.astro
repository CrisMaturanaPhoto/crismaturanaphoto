<script is:inline>
  function switchSession(id, btn) {
    document.querySelectorAll('.session-content').forEach(function(el) { el.classList.remove('active'); });
    document.querySelectorAll('.session-btn').forEach(function(el) { el.classList.remove('active'); });
    document.getElementById('session-' + id).classList.add('active');
    btn.classList.add('active');
  }
</script>

