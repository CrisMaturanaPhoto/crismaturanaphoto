  { thumb: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/Javiera%26Gonzalo%40-791.jpg', full: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/Javiera%26Gonzalo%40-791.jpg' },
