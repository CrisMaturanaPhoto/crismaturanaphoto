.p li{padding-left:18px;position:relative}
.p li::before{content:"";position:absolute;left:0;top:.72em;width:8px;height:1px;background:var(--amber-d)}
.p li.gift{color:var(--green);font-weight:500}
.p .btn{align-self:flex-start;margin-top:8px}
.civil{margin-top:22px;font-size:15px;color:var(--muted)}

/* STEPS (real sequence) */
.steps{background:var(--paper-2);padding:clamp(64px,9vw,104px) 0;border-top:1px solid var(--line)}
.steps h2{font:500 clamp(30px,3.8vw,46px)/1.1 var(--serif);margin-bottom:36px}
.steps ol{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:28px;counter-reset:s}
.steps li{counter-increment:s}
.steps li::before{content:counter(s);display:block;font:500 56px/1 var(--serif);color:var(--amber-d);margin-bottom:10px}
.steps b{display:block;font:500 22px/1.25 var(--serif);margin-bottom:6px}
.steps p{color:var(--muted)}

/* FAQ */
.faq{padding:clamp(64px,9vw,104px) 0}
.faq .wrap{display:grid;grid-template-columns:1fr 1.6fr;gap:clamp(24px,5vw,72px)}
.faq h2{font:500 clamp(30px,3.8vw,46px)/1.1 var(--serif)}
details{border-top:1px solid var(--line);padding:18px 0}
details:last-child{border-bottom:1px solid var(--line)}
summary{cursor:pointer;font:500 21px/1.3 var(--serif);list-style:none;display:flex;justify-content:space-between;gap:16px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-family:var(--sans);font-weight:300;color:var(--amber-d)}
details[open] summary::after{content:"–"}
details p{margin-top:10px;color:var(--muted);max-width:62ch}

/* CLOSE */
.close{background:var(--ink);color:var(--paper);padding:clamp(72px,10vw,128px) 0;text-align:center}
.close h2{font:500 clamp(36px,5vw,64px)/1.05 var(--serif);max-width:18ch;margin:0 auto 18px}
.close p{color:rgba(243,237,226,.78);max-width:52ch;margin:0 auto 30px}
.close .cta-row{justify-content:center}
footer{background:var(--ink-2);color:rgba(243,237,226,.55);font-size:13px;padding:24px 0}
footer .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
footer a{color:rgba(243,237,226,.75)}

@media (max-width:900px){
  .hero{grid-template-columns:1fr;min-height:auto}
  .hero-photo{height:62vh}
  .benefit .wrap,.approach .wrap,.faq .wrap{grid-template-columns:1fr}
  .perks li{grid-template-columns:1fr;gap:4px}
  .months{grid-template-columns:repeat(3,minmax(0,1fr))}
  .month{padding:14px 10px 18px}
  .month .m{font-size:22px}
  .hero-photo img{overflow:hidden}
  .month:nth-child(3){border-right:0}
  .month:nth-child(n+4){border-top:1px solid var(--line)}
  .month.is-you::after{content:none}
  .pk{grid-template-columns:1fr}
  .p{border-right:0;border-bottom:1px solid var(--line)}
  .steps ol{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(6,1fr);grid-auto-rows:120px}
  .g1,.g8{grid-column:span 6}.g2,.g3,.g4,.g5,.g6,.g7{grid-column:span 3;grid-row:span 2}
}
</style>
