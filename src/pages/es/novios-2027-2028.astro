.packages h2{font:500 clamp(34px,4.4vw,52px)/1.05 var(--serif);margin-bottom:10px}
.packages .lead{color:var(--muted);max-width:60ch;margin-bottom:40px}
.pk{display:grid;grid-template-columns:1fr 1.2fr 1fr;align-items:stretch;border-top:2px solid var(--ink)}
.p{padding:28px 24px 30px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:12px}
.p:last-child{border-right:0}
.p.featured{background:#fbf7ef;box-shadow:inset 0 3px 0 var(--amber-d)}
.p .tag{font-size:13px;color:var(--amber-d);font-weight:500}
.p h3{font:500 30px/1.1 var(--serif)}
