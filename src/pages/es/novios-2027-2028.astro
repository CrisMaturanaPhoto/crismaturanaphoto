<style is:global>
:root{
  --ink:#14110d; --ink-2:#0d0c0a; --paper:#f3ede2; --paper-2:#e9e1d2;
  --amber:#e8c070; --amber-d:#a0722a; --green:#3d6b2b; --muted:#6f665a; --line:#d8cdb9;
  --serif:'Cormorant Garamond',Georgia,serif; --sans:'Jost',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
body{background:var(--paper);color:var(--ink);font:300 17px/1.65 var(--sans);-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit}
:focus-visible{outline:2px solid var(--amber-d);outline-offset:3px}
.wrap{width:min(1120px,100% - 32px);margin-inline:auto}
.serif{font-family:var(--serif)}
.btn{display:inline-flex;align-items:center;gap:.5em;padding:.9em 1.5em;font:500 15px/1 var(--sans);letter-spacing:.02em;text-decoration:none;border:1px solid currentColor;transition:background .2s,color .2s}
.btn-solid{background:var(--amber);border-color:var(--amber);color:var(--ink)}
.btn-solid:hover{background:#f0d08f}
.btn-ghost:hover{background:rgba(255,255,255,.08)}

/* HERO: photo + letter */
.hero{background:var(--ink);color:var(--paper);display:grid;grid-template-columns:1.1fr 1fr;min-height:92vh}
.hero-photo{position:relative;overflow:hidden;min-width:0;background:#2a241c}
.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 30%;animation:settle 2.4s ease-out both}
@keyframes settle{from{transform:scale(1.06);opacity:.4}to{transform:scale(1);opacity:1}}
.hero-photo figcaption{position:absolute;left:20px;bottom:16px;font-size:13px;color:rgba(243,237,226,.75)}
.letter{padding:clamp(40px,7vw,96px) clamp(24px,5vw,72px);display:flex;flex-direction:column;justify-content:center;gap:22px}
.letter .to{font:italic 400 22px/1.3 var(--serif);color:var(--amber)}
.letter h1{font:500 clamp(40px,5.2vw,68px)/1.02 var(--serif);letter-spacing:-.01em}
.letter p{max-width:46ch;color:rgba(243,237,226,.86)}
.letter .sign{font:italic 400 26px/1 var(--serif);color:var(--paper)}
.letter .sign small{display:block;font:300 14px/1.5 var(--sans);font-style:normal;color:rgba(243,237,226,.6);margin-top:6px}
.cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}

/* BENEFIT */
.benefit{background:var(--paper-2);border-bottom:1px solid var(--line)}
.benefit .wrap{display:grid;grid-template-columns:1fr 1.4fr;gap:clamp(24px,5vw,72px);padding:clamp(56px,8vw,96px) 0}
.benefit h2{font:500 clamp(30px,3.6vw,44px)/1.1 var(--serif)}
.benefit .deadline{margin-top:14px;color:var(--amber-d);font-weight:500}
.perks{list-style:none;display:grid;gap:0}
.perks li{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:20px 0;border-top:1px solid var(--line)}
.perks li:last-child{border-bottom:1px solid var(--line)}
.perks strong{font:500 22px/1.2 var(--serif)}
.perks span{color:var(--muted)}

/* SEASON CALENDAR — the memorable element */
.season{padding:clamp(64px,9vw,112px) 0 clamp(48px,6vw,72px)}
.season-head{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:36px}
.season h2{font:500 clamp(34px,4.4vw,56px)/1.05 var(--serif);max-width:16ch}
.season-head p{max-width:42ch;color:var(--muted)}
.months{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border-top:2px solid var(--ink)}
.month{padding:18px 14px 22px;border-right:1px solid var(--line);position:relative}
.month:last-child{border-right:0}
.month .m{font:500 clamp(22px,2.4vw,34px)/1 var(--serif)}
.month .y{font-size:13px;color:var(--muted)}
.month .state{margin-top:18px;font-size:14px;display:flex;align-items:center;gap:8px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--green);flex:none}
.state.few .dot{background:var(--amber-d)}
.state.full .dot{background:#b9ae9c}
.month.is-you{background:var(--ink);color:var(--paper)}
.month.is-you .y{color:rgba(243,237,226,.6)}
.month.is-you::after{content:"Su mes";position:absolute;top:-30px;left:14px;font:italic 400 18px/1 var(--serif);color:var(--amber-d)}
.season small{display:block;margin-top:14px;color:var(--muted);font-size:13px}

/* GALLERY */
.gallery{padding:0 0 clamp(64px,9vw,112px)}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-rows:clamp(110px,13vw,170px);gap:10px}
.grid figure{overflow:hidden;background:#cfc4b1}
.grid img{width:100%;height:100%;object-fit:cover}
.g1{grid-column:span 7;grid-row:span 3}.g2{grid-column:span 5;grid-row:span 2}.g3{grid-column:span 5;grid-row:span 1}
.g4{grid-column:span 4;grid-row:span 2}.g5{grid-column:span 4;grid-row:span 2}.g6{grid-column:span 4;grid-row:span 2}
.g7{grid-column:span 5;grid-row:span 2}.g8{grid-column:span 7;grid-row:span 2}
.gallery .more{margin-top:20px;text-align:right}
.gallery .more a{color:var(--amber-d);text-underline-offset:4px}

/* APPROACH */
.approach{background:var(--ink);color:var(--paper);padding:clamp(64px,9vw,112px) 0}
.approach .wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,96px)}
.approach blockquote{font:400 clamp(28px,3.4vw,42px)/1.2 var(--serif)}
.approach blockquote em{color:var(--amber)}
.approach .facts{display:grid;gap:22px}
.approach .facts div{border-top:1px solid rgba(243,237,226,.18);padding-top:16px}
.approach .facts b{display:block;font:500 20px/1.3 var(--serif);color:var(--amber);margin-bottom:4px}
.approach .facts p{color:rgba(243,237,226,.78)}

/* PACKAGES */
