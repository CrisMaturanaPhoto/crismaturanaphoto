  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG' },
].map(img => ({ ...img, alt: 'Foto de parejas y familias por Cristóbal Maturana' }));
---

<Layout
  title="Parejas y Familias – Cristóbal Maturana"
  description="Fotografía de parejas y familias por Cristóbal Maturana."
  lang="es"
  canonical="https://crismaturana.com/es/portfolio/couples-families"
  alternates={alternates}
>
  <div class="page-hero-img" style="background-image: url('https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Alistair%26Emma-10.jpg')">
    <div class="page-hero-content">
      <h1>Parejas y Familias</h1>
      <p>El amor se ve mejor cuando no está posado.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="gallery-intro">
        <p>Ya sea una pareja explorando una nueva ciudad o una familia compartiendo una tarde tranquila — busco los momentos reales, los que ocurren entre las poses.</p>
      </div>
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .page-hero-img { height: 60vh; min-height: 400px; background-size: cover; background-position: center; display: flex; align-items: center; justify-content: center; position: relative; }
  .page-hero-img::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.35); }
  .page-hero-content { position: relative; z-index: 1; text-align: center; padding: 0 2rem; }
  .page-hero-content h1 { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 400; color: white; margin-bottom: 1rem; }
  .page-hero-content p { font-size: 1rem; color: rgba(255,255,255,0.85); letter-spacing: 0.05em; }
  .gallery-intro { max-width: 700px; margin: 0 auto 3rem; text-align: center; color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; }
</style>
