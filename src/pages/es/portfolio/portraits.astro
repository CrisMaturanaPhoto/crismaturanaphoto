---
import Layout from '../../../layouts/Layout.astro';
import Gallery from '../../../components/Gallery.astro';
import { buildAlternates } from '../../../lib/utils';

const alternates = buildAlternates('/portfolio/portraits', '/es/portfolio/portraits');

const cdn = 'https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION';
const images = [
  { thumb: `${cdn}/DanyaMuestra%40-2.JPG`, full: `${cdn}/DanyaMuestra%40-2.JPG` },
  { thumb: `${cdn}/agnes-portrait-001.JPG`, full: `${cdn}/agnes-portrait-001.JPG` },
  { thumb: `${cdn}/agnes-portrait-002.JPG`, full: `${cdn}/agnes-portrait-002.JPG` },
  { thumb: `${cdn}/agnes-partner-portrait-001.JPG`, full: `${cdn}/agnes-partner-portrait-001.JPG` },
  { thumb: `${cdn}/agnes-partner-portrait-002.JPG`, full: `${cdn}/agnes-partner-portrait-002.JPG` },
  { thumb: `${cdn}/anna-portrait-001.JPG`, full: `${cdn}/anna-portrait-001.JPG` },
  { thumb: `${cdn}/anna-portrait-002.JPG`, full: `${cdn}/anna-portrait-002.JPG` },
  { thumb: `${cdn}/Fo-Web%40-9.JPG`, full: `${cdn}/Fo-Web%40-9.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-10.JPG`, full: `${cdn}/HoiAnPortrais1%40-10.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-13.JPG`, full: `${cdn}/HoiAnPortrais1%40-13.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-15.JPG`, full: `${cdn}/HoiAnPortrais1%40-15.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-18.JPG`, full: `${cdn}/HoiAnPortrais1%40-18.JPG` },
  { thumb: `${cdn}/hygge-farm-portrait-001.JPG`, full: `${cdn}/hygge-farm-portrait-001.JPG` },
  { thumb: `${cdn}/MartinsSoul%40-24.JPG`, full: `${cdn}/MartinsSoul%40-24.JPG` },
  { thumb: `${cdn}/MartinsSoul%40-27.JPG`, full: `${cdn}/MartinsSoul%40-27.JPG` },
  { thumb: `${cdn}/monse-portrait-001.JPG`, full: `${cdn}/monse-portrait-001.JPG` },
  { thumb: `${cdn}/MonseRetratos%40-18.jpg`, full: `${cdn}/MonseRetratos%40-18.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-30.jpg`, full: `${cdn}/MonseRetratos%40-30.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-40.jpg`, full: `${cdn}/MonseRetratos%40-40.jpg` },
  { thumb: `${cdn}/rachel-portrait-001.JPG`, full: `${cdn}/rachel-portrait-001.JPG` },
  { thumb: `${cdn}/rachel-portrait-0013.JPG`, full: `${cdn}/rachel-portrait-0013.JPG` },
  { thumb: `${cdn}/tania-portrait-001.JPG`, full: `${cdn}/tania-portrait-001.JPG` },
  { thumb: `${cdn}/TheHyggePortraits%40-72.JPG`, full: `${cdn}/TheHyggePortraits%40-72.JPG` },
].map(img => ({ ...img, alt: 'Retrato por Cristóbal Maturana' }));
---

<Layout
  title="Retratos – Cristóbal Maturana"
  description="Fotografía de retrato con luz natural por Cristóbal Maturana."
  lang="es"
  canonical="https://crismaturana.com/es/portfolio/portraits"
  alternates={alternates}
>
    <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Portfolio · Retratos</p>
      <p class="hero-location">Hội An · Chile · Sudeste Asiático</p>
      <h1>Luz natural.<br>Expresiones honestas.</h1>
      <p class="hero-text">Trabajo principalmente con luz natural para crear retratos suaves y auténticos. Mi enfoque es relajado e intuitivo — te guío durante la sesión para que todo fluya con naturalidad.</p>
      
    </div>
  </div>
  <section class="section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION/rachel-portrait-0013.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(1.1);
    transform: scale(1.05);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 7rem 2.5rem 2rem;
    text-align: center;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #1a1a18;
    margin-bottom: 0.25rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 1.25rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 0.9rem;
    color: #4a4a48;
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 1.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.25rem;
    align-items: flex-end;
    justify-content: center;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgba(160, 120, 64, 0.6);
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(160, 120, 64, 0.6);
    padding-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.25rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media (max-width: 768px) {
    .gallery-hero-content { text-align: center; padding: 7rem 1.5rem 2rem; }
    .hero-text { max-width: 100%; }
    .hero-stats { justify-content: center; gap: 1.5rem; }
  }

</style>
