---
import Layout from '../../layouts/Layout.astro';

// Galería real desde Bunny CDN (mismas imágenes que ya usas en el sitio).
const galeria = [
  { src: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/Bernardita%26MauricioMatri-331.jpg', alt: 'Matrimonio en Chile fotografiado por Cristóbal Maturana' },
  { src: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/Javiera%26Gonzalo%40-435.jpg', alt: 'Pareja de novios en su matrimonio en Chile' },
  { src: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/poppin-chris-006.JPG', alt: 'Momento íntimo durante una ceremonia de matrimonio' },
  { src: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/abrazo-001.JPG', alt: 'Abrazo entre novios, fotografía documental de bodas' },
  { src: 'https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/yaz-lin-001.jpg', alt: 'Detalle emotivo de una boda fotografiada con luz natural' },
  { src: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/pareja-gam-santiago-chile.jpg', alt: 'Sesión de pareja en Santiago de Chile' },
];
---

<Layout
  title="Fotógrafo de Matrimonios en Chile 2026 | Cristóbal Maturana"
  description="Fotografía documental de matrimonios en Chile. Temporada octubre a marzo 2026–2027 con agenda limitada. Momentos reales, capturados con honestidad."
  lang="es"
>
  <!-- ============ HERO ============ -->
  <section class="page-hero mat-hero">
    <div class="container">
      <p class="section-label">Fotografía Documental de Matrimonios · Chile</p>
      <h1>Fotógrafo de Matrimonios en Chile</h1>
      <p>
        Más de 15 años capturando momentos reales, sin poses forzadas. Vuelvo a
        Chile para la temporada de matrimonios 2026–2027 y mantengo la agenda
        intencionalmente acotada: cada pareja recibe toda mi atención.
      </p>
      <p class="mat-hero-cta">
        <a href="/contact" class="btn btn-accent">Consultar disponibilidad</a>
      </p>
    </div>
  </section>

  <!-- ============ URGENCIA / TEMPORADA ============ -->
  <section class="section mat-season">
    <div class="container">
      <p class="section-label" style="text-align:center;">🇨🇱 Agenda abierta · Temporada 2026–2027</p>
      <h2 class="section-title" style="text-align:center;">Quedan pocas fechas <em>disponibles</em>.</h2>
      <p class="mat-season-intro">
        La temporada alta en Chile va de octubre a marzo. Las mejores fechas se
        reservan con meses de anticipación, así que si tienes un día en mente,
        este es el momento de conversarlo.
      </p>
      <div class="mat-months">
        <div class="mat-month"><span>Octubre</span> 2026 · Abierto</div>
        <div class="mat-month"><span>Noviembre</span> 2026 · Abierto</div>
        <div class="mat-month"><span>Diciembre</span> 2026 · Abierto</div>
        <div class="mat-month"><span>Enero — Marzo</span> 2027 · Abierto</div>
      </div>
      <p style="text-align:center; margin-top:2.5rem;">
        <a href="/contact" class="btn btn-accent">Reservar mi fecha</a>
      </p>
    </div>
  </section>

  <!-- ============ ENFOQUE ============ -->
  <section class="section mat-approach">
    <div class="container">
      <p class="section-label">Mi forma de fotografiar</p>
      <h2 class="section-title">Momentos reales, capturados con honestidad.</h2>
      <p class="mat-approach-text">
        No dirijo tu matrimonio: lo acompaño. Mi trabajo es documental —
        anticipo el gesto, la risa, la lágrima inesperada— para que años después
        recuerdes cómo se sintió ese día, no cómo posaste para una foto. Luz
        natural, intuición y respeto por el momento.
      </p>
    </div>
  </section>

  <!-- ============ GALERÍA ============ -->
  <section class="section mat-gallery-section">
    <div class="container">
      <p class="section-label" style="text-align:center;">Trabajos seleccionados</p>
      <h2 class="section-title" style="text-align:center;">Matrimonios</h2>
      <div class="mat-gallery" id="mat-gallery">
        {galeria.map((img, i) => (
          <img
            src={img.src}
            alt={img.alt}
            width="900"
            height="600"
            loading="lazy"
            data-idx={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CÓMO TRABAJAMOS ============ -->
  <section class="section mat-steps">
    <div class="container">
      <p class="section-label" style="text-align:center;">Cómo trabajamos juntos</p>
      <div class="mat-steps-grid">
        <div class="mat-step">
          <span class="mat-step-num">01</span>
          <h3>Conversamos</h3>
          <p>Me escribes por el formulario o WhatsApp. Respondo en menos de 24 horas para coordinar una llamada breve, sin compromiso.</p>
        </div>
        <div class="mat-step">
          <span class="mat-step-num">02</span>
          <h3>Planificamos</h3>
          <p>Definimos lugares, tiempos y lo que quieres sentir al ver tus fotos. Un abono reserva tu fecha.</p>
        </div>
        <div class="mat-step">
          <span class="mat-step-num">03</span>
          <h3>Recibes tus fotos</h3>
          <p>Galería completa editada en 7 a 30 días. Adelanto en menos de 24 horas. Imágenes que se sienten tuyas.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIOS ============ -->
  <!--
    IMPORTANTE (Cris): pega aquí 2 o 3 testimonios REALES de parejas.
    Si mencionan el lugar (ej. "nuestra boda en las viñas de Casablanca"
    o "en Santiago"), mejor para el SEO local. No invento testimonios.
    Borra esta tarjeta de ejemplo y reemplázala por las reales.
  -->
  <section class="section mat-testimonials">
    <div class="container">
      <p class="section-label" style="text-align:center;">Lo que dicen las parejas</p>
      <div class="mat-testimonial-card">
        <p class="mat-quote">“[Pega aquí el testimonio real de la pareja. Idealmente que mencione la región o el lugar del matrimonio.]”</p>
        <p class="mat-author">— [Nombre de la pareja], [Lugar / Región]</p>
      </div>
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  <section class="section mat-final-cta">
    <div class="container">
      <h2 class="section-title">¿Te casas entre octubre y marzo?</h2>
      <p>Cuéntame tu fecha y el lugar. Conversemos sin compromiso mientras la agenda lo permita.</p>
      <a href="/contact" class="btn btn-accent">Consultar mi fecha</a>
    </div>
  </section>

  <style>
    .mat-hero-cta { margin-top: 2rem; }

    .mat-season { background: var(--color-surface); }
    .mat-season-intro {
      text-align: center; max-width: 580px; margin: 0 auto 2.5rem;
      color: var(--color-text-muted);
    }
    .mat-months {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1px; background: var(--color-border);
      border: 1px solid var(--color-border); border-radius: 4px; overflow: hidden;
    }
    .mat-month {
      background: var(--color-bg); padding: 1.25rem 1rem; text-align: center;
      font-size: 0.95rem; color: var(--color-text-muted);
    }
    .mat-month span {
      display: block; font-family: var(--font-serif); font-size: 1.1rem;
      color: var(--color-heading); margin-bottom: 0.25rem;
    }

    .mat-approach-text {
      max-width: 680px; font-size: 1.15rem; line-height: 1.9;
      color: var(--color-text); font-weight: 300;
    }

    .mat-gallery {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem;
    }
    .mat-gallery img {
      width: 100%; height: 340px; object-fit: cover; cursor: pointer;
      border-radius: 2px; transition: opacity 0.3s ease;
    }
    .mat-gallery img:hover { opacity: 0.85; }

    .mat-steps { background: var(--color-surface); }
    .mat-steps-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 3rem; margin-top: 1rem;
    }
    .mat-step-num {
      font-family: var(--font-serif); font-size: 2rem; color: var(--color-accent);
      display: block; margin-bottom: 0.75rem;
    }
    .mat-step h3 {
      font-family: var(--font-serif); font-weight: 400; font-size: 1.3rem;
      color: var(--color-heading); margin-bottom: 0.5rem;
    }
    .mat-step p { color: var(--color-text-muted); font-size: 0.95rem; }

    .mat-testimonial-card {
      max-width: 700px; margin: 2rem auto 0; text-align: center;
      padding: 2.5rem; border: 1px solid var(--color-border); border-radius: 4px;
      background: var(--color-surface);
    }
    .mat-quote {
      font-family: var(--font-serif); font-style: italic; font-size: 1.3rem;
      line-height: 1.6; color: var(--color-heading); margin-bottom: 1rem;
    }
    .mat-author { font-size: 0.85rem; letter-spacing: 0.05em; color: var(--color-text-muted); }

    .mat-final-cta { text-align: center; }
    .mat-final-cta p { color: var(--color-text-muted); max-width: 520px; margin: 0 auto 2rem; }

    @media (max-width: 768px) {
      .mat-gallery { grid-template-columns: 1fr 1fr; }
      .mat-gallery img { height: 220px; }
    }
    @media (max-width: 480px) {
      .mat-gallery { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    // Conecta la galería al lightbox global que ya existe en Layout.astro
    const imgs = Array.from(document.querySelectorAll('#mat-gallery img')) as HTMLImageElement[];
    const srcs = imgs.map((im) => im.src);
    imgs.forEach((im, i) => {
      im.addEventListener('click', () => (window as any).openLightbox(srcs, i));
    });
  </script>
</Layout>
