---
import Layout from '../../layouts/Layout.astro';
import HomeContent from '../../components/HomeContent.astro';

import { heroSlides, portfolioCategories } from '../../lib/ui';
import { getLatestBlogPosts, buildAlternates } from '../../lib/utils';

const latestBlogPosts = await getLatestBlogPosts(3, 'es');
const alternates = buildAlternates('/', '/es/');
---

<Layout
  title="Fotógrafo de Matrimonios en Chile — Estilo Documental | Cris Maturana"
  description="15+ años fotografiando matrimonios con estilo documental auténtico, en Chile y el Sudeste Asiático. Descubre el portfolio y cotiza tu matrimonio."
  lang="es"
  canonical="https://www.crismaturana.com/es/"
  alternates={alternates}
>
  <HomeContent
    heroSlides={heroSlides}
    portfolioCategories={portfolioCategories}
    latestBlogPosts={latestBlogPosts}
    lang="es"
  />

</Layout>
