---
import Layout from '../../layouts/Layout.astro';
import { buildAlternates } from '../../lib/utils';

const alternates = buildAlternates('/wedding-pricing-chile', '/es/precios-matrimonios-chile');
---

<Layout
  title="Precios Matrimonios en Chile 2026 | Cristóbal Maturana"
  description="Paquetes y tarifas para matrimonios en Chile. Tres paquetes desde $1.200.000 CLP. Fotografía documental, sin poses forzadas."
  lang="es"
  canonical="https://crismaturana.com/es/precios-matrimonios-chile"
  alternates={alternates}
>

  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Fotografía de Matrimonios en Chile",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressCountry": "CL" }
      },
      "areaServed": "Chile",
      "offers": [
        { "@type": "Offer", "name": "Esencial", "price": "1200000", "priceCurrency": "CLP" },
        { "@type": "Offer", "name": "Completo", "price": "1800000", "priceCurrency": "CLP" },
        { "@type": "Offer", "name": "Premium", "price": "2500000", "priceCurrency": "CLP" }
      ]
    })
  }</script>

  <div class="page-hero">
    <div class="container">
      <p class="hero-session-label">Matrimonios · Chile</p>
      <h1>Tarifas y Paquetes</h1>
      <p>Tres paquetes pensados para matrimonios en Chile — desde $1.200.000 CLP. Fotografía documental, momentos reales, sin poses forzadas.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">

      <div class="pricing-grid">

        <div class="pkg-card">
          <p class="tier-label">ESENCIAL</p>
          <p class="pkg-name">Esencial</p>
          <p class="pkg-tagline">Lo justo y necesario, bien hecho.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$1.200.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>6 horas de cobertura</span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo</span></li>
            <li><span class="icon-check">✓</span><span>Ceremonia + recepción</span></li>
            <li><span class="icon-check">✓</span><span>300+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Guía de planificación del día</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+el+paquete+Esencial+para+mi+matrimonio" class="btn btn-accent pkg-cta">Consultar por WhatsApp</a>
          <p class="pkg-note">Entrega en 30 días</p>
        </div>

        <div class="pkg-card featured">
          <div class="featured-badge">Más elegido</div>
          <p class="tier-label">COMPLETO</p>
          <p class="pkg-name">Completo</p>
          <p class="pkg-tagline">La cobertura completa de tu día.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$1.800.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>8 horas de cobertura (preparativos, ceremonia y fiesta)</span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo + asistente</span></li>
            <li><span class="icon-check">✓</span><span>500+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Sesión de pareja antes o después de la boda (golden hour)</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Llamada de planificación previa</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+el+paquete+Completo+para+mi+matrimonio" class="btn btn-accent pkg-cta">Consultar por WhatsApp</a>
          <p class="pkg-note">Entrega en 21 días</p>
        </div>

        <div class="pkg-card">
          <p class="tier-label">PREMIUM</p>
          <p class="pkg-name">Premium</p>
          <p class="pkg-tagline">Tu día completo, de principio a fin.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$2.500.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>10–12 horas de cobertura (desde los preparativos hasta el cierre de la fiesta)</span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo + asistente</span></li>
            <li><span class="icon-check">✓</span><span>700+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Sesión de pareja antes de la boda</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Video resumen de 60 segundos (highlight)</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Álbum impreso 30×30 cm (20 páginas)</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+el+paquete+Premium+para+mi+matrimonio" class="btn btn-accent pkg-cta">Consultar por WhatsApp</a>
          <p class="pkg-note">Entrega prioritaria en 14 días</p>
        </div>

      </div>

      <p class="footer-note">Paquetes para matrimonios en todo Chile · Precios en pesos chilenos (CLP) · Viáticos fuera de la Región Metropolitana se cotizan aparte</p>

      <div class="custom-quote">
        <p class="custom-label">¿Tienes algo distinto en mente?</p>
        <h2 class="custom-heading">Cada matrimonio es único.</h2>
        <p class="custom-text">Cuéntame la fecha, el lugar y lo que imaginas para tu día, y armamos juntos una propuesta a medida. Sin compromiso.</p>
        <a href="https://wa.me/56999679935?text=Hola%2C+quisiera+una+cotizaci%C3%B3n+personalizada+para+mi+matrimonio" class="btn btn-accent custom-cta">Pedir cotización a medida →</a>
      </div>

    </div>
  </section>

</Layout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pkg-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s;
  }

  .pkg-card:hover { border-color: var(--color-accent); }

  .pkg-card.featured {
    border-color: var(--color-accent);
    border-width: 2px;
    padding-top: 3rem;
    background: #fff;
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    white-space: nowrap;
  }

  .tier-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .pkg-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .pkg-tagline {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    font-weight: 300;
  }

  .pkg-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .pkg-price .currency {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .pkg-price .amount {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1;
  }

  .pkg-divider { height: 1px; background: var(--color-border); margin-bottom: 0.5rem; }

  .pkg-features {
    list-style: none;
    margin-bottom: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.4;
    font-weight: 300;
  }

  .pkg-features li.value-add span:last-child { color: var(--color-text); font-weight: 400; }

  .pkg-features li.delivery {
    opacity: 0.55;
    border-bottom: none;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  .icon-check { color: var(--color-accent); font-weight: 700; flex-shrink: 0; font-size: 0.85rem; margin-top: 1px; }
  .icon-star { color: #c0392b; font-size: 0.75rem; flex-shrink: 0; margin-top: 2px; }
  .icon-del { color: var(--color-text-muted); flex-shrink: 0; font-size: 0.8rem; margin-top: 1px; }

  .pkg-cta { display: block; width: 100%; text-align: center; margin-top: auto; }

  .pkg-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.6rem;
    opacity: 0.6;
    font-weight: 300;
  }

  .footer-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 3rem;
    font-weight: 300;
  }

  .hero-session-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-cta { display: inline-block; }

  .page-hero { padding-bottom: 0 !important; margin-bottom: 0 !important; border-bottom: none !important; }
  .section { padding-top: 1.5rem !important; }

  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
</style>
