---
import Layout from '../../layouts/Layout.astro';
import { buildAlternates } from '../../lib/utils';

const alternates = buildAlternates('/wedding-pricing-chile', '/es/precios-matrimonios-chile');
---

<Layout
  title="Precio Fotógrafo de Matrimonios en Chile 2026 | Paquetes y Tarifas"
  description="Conoce los precios reales de un fotógrafo de matrimonios en Chile: paquetes desde $200.000 CLP, cobertura en Santiago, Chillán y todo el país. Cotiza tu fecha."
  lang="es"
  canonical="https://www.crismaturana.com/es/precios-matrimonios-chile"
  alternates={alternates}
>

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Fotografía de Matrimonios en Chile",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://www.crismaturana.com",
        "address": { "@type": "PostalAddress", "addressCountry": "CL" }
      },
      "areaServed": "Chile",
      "offers": [
        { "@type": "Offer", "name": "Matrimonio Civil", "price": "200000", "priceCurrency": "CLP" },
        { "@type": "Offer", "name": "Lo Esencial", "price": "400000", "priceCurrency": "CLP" },
        { "@type": "Offer", "name": "La Jornada Completa", "price": "1000000", "priceCurrency": "CLP" },
        { "@type": "Offer", "name": "El Día Entero", "price": "1290000", "priceCurrency": "CLP" }
      ]
    })} />

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta un fotógrafo de matrimonio en Chile?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Los paquetes van desde $200.000 CLP (matrimonio civil, 1–2 horas) hasta $1.290.000 CLP (cobertura de 12 horas, el día completo). El paquete más reservado, La Jornada Completa, cuesta $1.000.000 CLP. La hora extra tiene un valor de $100.000 CLP."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué incluye cada paquete de matrimonio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Todos los paquetes incluyen fotos editadas en alta resolución y galería privada online. Desde La Jornada Completa en adelante se suma sesión de pareja antes de la boda y llamada de planificación previa; El Día Entero además incluye un álbum impreso de 30×30 cm."
          }
        },
        {
          "@type": "Question",
          "name": "¿Trabajas matrimonios en todo Chile?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, disponible en todo Chile. Los viáticos fuera de la Región Metropolitana se cotizan aparte según la fecha y el lugar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto demora la entrega de las fotos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La entrega estándar es en 30 días. El paquete El Día Entero tiene entrega prioritaria en 14 días."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo pedir una cotización personalizada?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Cada colección es un punto de partida, no un guion fijo — cuéntame tu fecha, tu lugar y lo que imaginas, y armo una propuesta a tu medida sin compromiso."
          }
        }
      ]
    })} />

  <div class="page-hero">
    <div class="container">
      <p class="hero-session-label">Matrimonios · Chile</p>
      <h1>¿Cuánto de tu día quieres recordar?</h1>
      <p>He fotografiado matrimonios en Chile y el Sudeste Asiático, y con los años he ido entendiendo qué fotos son las que de verdad se siguen mirando, las que ayudan a recordar cómo se sintió ese día, no solo cómo se veía, la idea es revivir ese día. Por eso ofrezco tres opciones distintas, según cuánto de tu matrimonio quieres dejar guardado: desde los momentos más importantes hasta cada detalle, de principio a fin.</p>
    </div>
  </div>

  <section class="story-image-section">
    <div class="story-image-wrap">
      <img src="https://crismaturana.b-cdn.net/Weddings/wedding-photographer-chile-embrace-01.jpg" alt="Fotografía documental de matrimonios en Chile por Cristóbal Maturana" class="story-image" loading="eager" />
      <div class="story-image-overlay"></div>
      <p class="story-image-caption">No vas a recordar cada detalle de tu matrimonio.<br>Las fotos sí.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="pricing-grid">

        <div class="pkg-card">
          <p class="tier-label">MATRIMONIO CIVIL</p>
          <p class="pkg-name">Matrimonio Civil</p>
          <p class="pkg-tagline">La ceremonia civil, capturada con cercanía y rapidez.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$200.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span><strong>1–2 horas de cobertura</strong></span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo</span></li>
            <li><span class="icon-check">✓</span><span>Ceremonia civil</span></li>
            <li><span class="icon-check">✓</span><span>Fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/es/contact?session=Wedding&amp;package=Matrimonio+Civil#contact-form" class="btn btn-accent pkg-cta">Enviar Email</a>
            <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+Matrimonio+Civil+para+mi+matrimonio" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Conversemos por WhatsApp</a>
          </div>
          <p class="pkg-note">Entrega en 30 días</p>
        </div>

        <div class="pkg-card">
          <p class="tier-label">ESENCIAL</p>
          <p class="pkg-name">Lo Esencial</p>
          <p class="pkg-tagline">La ceremonia, los brindis, el baile — capturados por completo.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$400.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span><strong>4 horas de cobertura</strong></span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo</span></li>
            <li><span class="icon-check">✓</span><span>Ceremonia + recepción</span></li>
            <li><span class="icon-check">✓</span><span>250+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/es/contact?session=Wedding&amp;package=Lo+Esencial#contact-form" class="btn btn-accent pkg-cta">Enviar Email</a>
            <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+Lo+Esencial+para+mi+matrimonio" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Conversemos por WhatsApp</a>
          </div>
          <p class="pkg-note">Entrega en 30 días</p>
        </div>

        <div class="pkg-card featured">
          <div class="featured-badge">Lo Más Reservado</div>
          <p class="tier-label">JORNADA COMPLETA</p>
          <p class="pkg-name">La Jornada Completa</p>
          <p class="pkg-tagline">La colección que eligen la mayoría de las parejas — y la que elegiría para mi propio matrimonio.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$1.000.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span><strong>10 horas de cobertura</strong> (preparativos, ceremonia y fiesta)</span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo + asistente</span></li>
            <li><span class="icon-check">✓</span><span>500+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Sesión de pareja antes de la boda (golden hour)</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Llamada de planificación previa</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/es/contact?session=Wedding&amp;package=La+Jornada+Completa#contact-form" class="btn btn-accent pkg-cta">Enviar Email</a>
            <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+La+Jornada+Completa+para+mi+matrimonio" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Conversemos por WhatsApp</a>
          </div>
          <p class="pkg-note">Entrega en 30 días</p>
        </div>

        <div class="pkg-card">
          <p class="tier-label">EL DÍA ENTERO</p>
          <p class="pkg-name">El Día Entero + Photobook</p>
          <p class="pkg-tagline">Cada hora, cada detalle — un archivo completo, no solo una galería.</p>
          <div class="pkg-price"><span class="currency">CLP</span><span class="amount">$1.290.000</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span><strong>12 horas de cobertura</strong> (desde los preparativos hasta el cierre de la fiesta)</span></li>
            <li><span class="icon-check">✓</span><span>1 fotógrafo + asistente</span></li>
            <li><span class="icon-check">✓</span><span>700+ fotos editadas en alta resolución</span></li>
            <li><span class="icon-check">✓</span><span>Galería privada online</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Sesión de pareja antes de la boda</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Photobook de regalo: 30×30 cm · 40 páginas · 130 fotos · formato tradicional con folia</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/redes + resolución completa para imprimir</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/es/contact?session=Wedding&amp;package=El+D%C3%ADa+Entero#contact-form" class="btn btn-accent pkg-cta">Enviar Email</a>
            <a href="https://wa.me/56999679935?text=Hola%2C+me+interesa+El+D%C3%ADa+Entero+para+mi+matrimonio" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Conversemos por WhatsApp</a>
          </div>
          <p class="pkg-note">Entrega prioritaria en 14 días</p>
        </div>

      </div>

      <p class="footer-note">Cada colección es un punto de partida, no un guion fijo · Disponible en todo Chile · Precios en pesos chilenos (CLP) · Viáticos fuera de la Región Metropolitana se cotizan aparte</p>

      <p class="extra-hour-note">Hora extra: <strong>$100.000 CLP</strong></p>

      <div class="photobook-addon">
        <p class="photobook-label">Álbum impreso · Opcional</p>
        <h2 class="photobook-heading">Photobook profesional Lay Flat 30×30 cm · 40 páginas</h2>
        <p class="photobook-text">Impreso en papel fotográfico FUJIFILM de 400 grs, con apertura totalmente plana (180°). Súmalo a cualquier paquete de matrimonio.</p>

        <div class="photobook-grid">
          <div class="photobook-item">
            <p class="photobook-item-name">Tapa Impresa</p>
            <p class="photobook-item-desc">Tapa en cartón piedra de 3mm con acabado impreso termolaminado.</p>
            <div class="photobook-item-divider"></div>
            <p class="photobook-item-price"><span class="currency">CLP</span> $174.990</p>
          </div>
          <div class="photobook-item">
            <p class="photobook-item-name">Tapa con Folia</p>
            <p class="photobook-item-desc">Tapa con grabado en folia dorada o plateada.</p>
            <div class="photobook-item-divider"></div>
            <p class="photobook-item-price"><span class="currency">CLP</span> $195.990</p>
          </div>
          <div class="photobook-item">
            <p class="photobook-item-name">Tapa Acrílico</p>
            <p class="photobook-item-desc">Tapa en acrílico impreso de primer nivel.</p>
            <div class="photobook-item-divider"></div>
            <p class="photobook-item-price"><span class="currency">CLP</span> $205.990</p>
          </div>
        </div>
      </div>

      <div class="custom-quote">
        <p class="custom-label">¿Tienes algo distinto en mente?</p>
        <h2 class="custom-heading">Cada matrimonio merece su propia historia.</h2>
        <p class="custom-text">Cuéntame tu fecha, tu lugar y lo que imaginas — armo una propuesta a su medida. Sin compromiso.</p>
        <a href="https://wa.me/56999679935?text=Hola%2C+quisiera+una+cotizaci%C3%B3n+personalizada+para+mi+matrimonio" class="btn btn-accent custom-cta">Pedir cotización a medida →</a>
      </div>

      <div class="pricing-faq">
        <h2 class="section-title" style="text-align:center;">Preguntas frecuentes</h2>

        <div class="faq-item">
          <h3>¿Cuánto cuesta un fotógrafo de matrimonio en Chile?</h3>
          <p>Los paquetes van desde $200.000 CLP (matrimonio civil, 1–2 horas) hasta $1.290.000 CLP (cobertura de 12 horas, el día completo). El paquete más reservado, La Jornada Completa, cuesta $1.000.000 CLP. La hora extra tiene un valor de $100.000 CLP.</p>
        </div>
        <div class="faq-item">
          <h3>¿Qué incluye cada paquete de matrimonio?</h3>
          <p>Todos los paquetes incluyen fotos editadas en alta resolución y galería privada online. Desde La Jornada Completa en adelante se suma sesión de pareja antes de la boda y llamada de planificación previa; El Día Entero además incluye un álbum impreso de 30×30 cm.</p>
        </div>
        <div class="faq-item">
          <h3>¿Trabajas matrimonios en todo Chile?</h3>
          <p>Sí, disponible en todo Chile. Los viáticos fuera de la Región Metropolitana se cotizan aparte según la fecha y el lugar.</p>
        </div>
        <div class="faq-item">
          <h3>¿Cuánto demora la entrega de las fotos?</h3>
          <p>La entrega estándar es en 30 días. El paquete El Día Entero tiene entrega prioritaria en 14 días.</p>
        </div>
        <div class="faq-item">
          <h3>¿Puedo pedir una cotización personalizada?</h3>
          <p>Sí. Cada colección es un punto de partida, no un guion fijo — cuéntame tu fecha, tu lugar y lo que imaginas, y armo una propuesta a tu medida sin compromiso.</p>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pkg-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s;
  }

  .pkg-card:hover { border-color: var(--color-accent); }

  .pkg-card.featured {
    border-color: var(--color-accent);
    border-width: 2px;
    padding-top: 3rem;
    background: #fff;
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    white-space: nowrap;
  }

  .tier-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .pkg-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .pkg-tagline {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    font-weight: 300;
  }

  .pkg-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .pkg-price .currency {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .pkg-price .amount {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1;
  }

  .pkg-divider { height: 1px; background: var(--color-border); margin-bottom: 0.5rem; }

  .pkg-features {
    list-style: none;
    margin-bottom: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.4;
    font-weight: 300;
  }

  .pkg-features li.value-add span:last-child { color: var(--color-text); font-weight: 400; }

  .pkg-features li.delivery {
    border-bottom: none;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  .icon-check { color: var(--color-accent); font-weight: 700; flex-shrink: 0; font-size: 0.85rem; margin-top: 1px; }
  .icon-star { color: #c0392b; font-size: 0.75rem; flex-shrink: 0; margin-top: 2px; }
  .icon-del { color: var(--color-text-muted); flex-shrink: 0; font-size: 0.8rem; margin-top: 1px; }

  .pkg-cta-group { display: flex; flex-direction: column; gap: 0.6rem; margin-top: auto; }
  .pkg-cta { display: block; width: 100%; text-align: center; }
  .pkg-cta-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: #25D366;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 40px;
    transition: background 0.25s;
  }
  .pkg-cta-whatsapp:hover { background: #1fb858; }
  .pkg-cta-whatsapp svg { flex-shrink: 0; }

  .pkg-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.6rem;
    opacity: 0.6;
    font-weight: 300;
  }

  .footer-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 3rem;
    font-weight: 300;
  }

  .extra-hour-note {
    text-align: center;
    font-size: 0.95rem;
    color: var(--color-text);
    margin-top: 0.75rem;
    font-weight: 300;
  }

  .extra-hour-note strong {
    font-weight: 700;
    color: var(--color-heading);
  }

  .photobook-addon {
    margin-top: 3rem;
    padding: 2.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .photobook-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
