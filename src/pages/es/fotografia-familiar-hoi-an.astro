---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import { buildAlternates } from '../../lib/utils';

const alternates = buildAlternates('/family-portrait-photography-hoi-an', '/es/fotografia-familiar-hoi-an');

const images = [
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/agnes-couple-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/agnes-couple-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Alistair%26Emma-10.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Alistair%26Emma-10.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Alistair%26Emma-3.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Alistair%26Emma-3.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/brauli-itziar-sesion-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/brauli-itziar-sesion-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/familia.santiago.chile.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/familia.santiago.chile.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina-Nick-Pai-thailand-sesion-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina-Nick-Pai-thailand-sesion-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-12.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-12.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-49.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-49.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Isa%26Fen%CC%83a%40-3.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Isa%26Fen%CC%83a%40-3.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/jose-photos-%40-101-1536x1025.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/jose-photos-%40-101-1536x1025.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/jose-photos-%40-132.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/jose-photos-%40-132.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/maca-julian-sesion-embarazo-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/maca-julian-sesion-embarazo-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/nadeem-dionne-kohlanta-session.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/nadeem-dionne-kohlanta-session.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/pareja-gam-santiago-chile.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/pareja-gam-santiago-chile.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/poppin-chris-oldtown-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/poppin-chris-oldtown-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG' },
].map(img => ({ ...img, alt: 'Foto de parejas y familias por Cristóbal Maturana' }));
---

<Layout
  title="Fotógrafo de Familias, Parejas y Retratos en Hội An y Da Nang | Cristóbal Maturana"
  description="Sesiones de fotografía familiar, de pareja y retratos en Hội An y Da Nang, Vietnam. Estilo documental, luz natural, momentos reales. Paquetes desde $160 USD."
  lang="es"
  canonical="https://crismaturana.com/es/fotografia-familiar-hoi-an"
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Fotografía Familiar, de Parejas y Retratos",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Hội An", "addressCountry": "VN" }
      },
      "areaServed": ["Hội An", "Da Nang", "Vietnam"]
    })
  }</script>
  <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Portfolio · Parejas y Familias</p>
      <p class="hero-location">Hội An · Da Nang · Sudeste Asiático</p>
      <h1>Fotógrafo de Familias y Parejas en Hội An y Da Nang</h1>
      <h2>Dos personas. Una familia. La vida tal como es.</h2>
      <p class="hero-text">Parejas en su primer viaje juntos. Familias que llevan años sin quedarse quietas. Me presento, observo y dejo que las cosas pasen. Un poco de dirección no hace daño — pero los mejores fotogramas siempre son los que ocurren entre medio.</p>
      <div class="hero-stats">
        <div class="stat"><p class="stat-num">15+</p><p class="stat-label">Años</p></div>
        <div class="stat"><p class="stat-num">100+</p><p class="stat-label">Sesiones</p></div>
        <div class="stat"><p class="stat-num stat-sm">Always</p><p class="stat-label">Present</p></div>
        <div class="stat stat-text"><p class="stat-num stat-sm">Natural & Espontáneo</p><p class="stat-label">Estilo</p></div>
      </div>
      <div class="hero-cta">
        <a href="/es/prices" class="cta-btn">Ver Paquetes y Precios</a>
        <a href="/es/contact?session=Couples+%26+Families" class="cta-link">Reservar una Sesión →</a>
      </div>
    </div>
  </div>
  <section class="section gallery-section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>

  <section class="section service-section">
    <div class="container service-copy">

      <h2>¿Qué esperar?</h2>
      <p>
        Las sesiones normalmente duran entre 1 y 4 horas según el paquete, y se hacen donde tú
        quieras — las calles del Casco Antiguo, la ribera del río Thu Bon, la playa, o los
        campos de arroz al atardecer. Los primeros minutos los uso para que todos se relajen y
        se olviden de la cámara, y luego sigo el ritmo natural del momento — los niños siendo
        niños, las parejas realmente conversando entre ellas, los abuelos contando historias.
        La luz y el lugar hacen la mitad del trabajo; el resto ocurre solo.
      </p>

      <h2>¿Por qué reservar con Cristóbal?</h2>
      <p>
        Llevo más de 15 años fotografiando familias y parejas, desde Chile hasta Hội An, y ahora
        con cobertura regular también en Da Nang. Mi formación documental significa que noto los
        momentos intermedios que la mayoría de los fotógrafos se pierde — y trabajo rápido y sin
        interrumpir, lo cual importa especialmente con niños y con parejas que se sienten
        incómodas frente a la cámara.
      </p>

      <h2>Preguntas Frecuentes</h2>
      <details>
        <summary>¿También fotografías en Da Nang?</summary>
        <p>Sí — Da Nang está a unos 30–45 minutos de Hội An, y regularmente hago sesiones familiares y de pareja ahí sin complicaciones adicionales de traslado.</p>
      </details>
      <details>
        <summary>¿Cuántas personas pueden participar en una sesión familiar?</summary>
        <p>Cualquier tamaño — desde una pareja esperando su primer hijo hasta familias multigeneracionales. Grupos más grandes pueden necesitar una sesión un poco más larga; te lo indico cuando conversemos.</p>
      </details>
      <details>
        <summary>¿Cuántas fotos recibiremos y cuánto demora la entrega?</summary>
        <p>Entre 15 y 50 fotos editadas según tu paquete, con un adelanto dentro de 24 horas y la galería completa entregada dentro de 7 días.</p>
      </details>
      <details>
        <summary>¿Cómo reservo?</summary>
        <p>Completa el formulario de contacto en crismaturana.com/es/contact, o escríbeme directamente. Te responderé dentro de 24–48 horas para confirmar fecha y lugar.</p>
      </details>

      <div class="custom-quote">
        <p class="custom-label">Trabajemos Juntos</p>
        <h2 class="custom-heading">Empecemos la conversación</h2>
        <p class="custom-text">Cuéntame sobre tu familia o tu viaje — te respondo dentro de 24 horas.</p>
        <a href="/es/contact?session=Couples+%26+Families" class="btn btn-accent custom-cta">Empezar la Conversación →</a>
        <p class="custom-text" style="margin-top: 1rem; margin-bottom: 0;">
          <a href="/es/prices">Ver paquetes y precios →</a>
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
  
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(1.1);
    transform: scale(1.05);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 7rem 2.5rem 2rem;
    text-align: center;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #1a1a18;
    margin-bottom: 0.25rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 1.25rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 0.9rem;
    color: #4a4a48;
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 1.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.25rem;
    align-items: flex-end;
    justify-content: center;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgba(160, 120, 64, 0.6);
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(160, 120, 64, 0.6);
    padding-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.25rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-cta {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: #e8c070;
    color: #1a1a18;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta-btn:hover {
    background: #c9a050;
  }

  .cta-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.3);
    padding-bottom: 2px;
    transition: color 0.2s;
  }

  .cta-link:hover {
    color: rgba(160, 120, 64, 0.85);
  }

  .gallery-section {
    padding-bottom: 0;
  }

  .service-section {
    padding-top: 0;
    margin-top: -30px;
  }

  .service-copy {
    max-width: 720px;
    margin: 0 auto;
  }

  .service-copy h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .service-copy p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .service-copy a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .service-copy details {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }

  .service-copy summary {
    font-family: var(--font-sans);
    font-weight: 700;
    cursor: pointer;
    color: var(--color-heading);
  }

  .service-copy details p {
    margin-top: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-text a {
    color: var(--color-accent);
  }

  .custom-cta {
    display: inline-block;
  }

  @media (max-width: 768px) {
    .gallery-hero-content { text-align: center; padding: 7rem 1.5rem 2rem; }
    .hero-text { max-width: 100%; }
    .hero-stats { justify-content: center; gap: 1.5rem; }
  }


</style>