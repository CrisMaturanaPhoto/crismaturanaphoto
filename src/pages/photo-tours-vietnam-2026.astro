---
import Layout from '../layouts/Layout.astro';
import { buildAlternates } from '../lib/utils';

const alternates = buildAlternates('/photo-tours-vietnam-2026', '/es/photo-tours-vietnam-2026');

const tours = [
  {
    id: 'duy-hai',
    num: '01',
    badge: 'COASTAL · DOCUMENTARY',
    name: 'Dawn at the Fishing Village',
    sessionValue: 'Photo Tour – Dawn at the Fishing Village',
    location: 'Duy Hai · 40 min from Hội An',
    tagline: "Basket boats, salt air, and fishermen sorting the night’s catch at the edge of first light.",
    time: '4:30 – 8:30 AM',
    duration: '3.5 hours',
    groupSize: 'Max 4 people',
    level: 'All levels',
    groupPrice: '$60 USD',
    groupPriceVnd: '1.600.000 VND',
    privatePrice: '$150 USD',
    privatePriceVnd: '3.950.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-1.JPG',
    heroAlt: 'Vietnamese fishermen with basket boats at sunrise in Duy Hai',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHay2HoiAn%40-0001.JPG', alt: 'Duy Hai fishing village morning light' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-10.JPG', alt: 'Basket boats launching before sunrise' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-15.JPG', alt: 'Fish market on the beach Duy Hai' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHay2HoiAn%40-21.JPG', alt: 'Traditional trawlers silhouette golden hour' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/DuyHai-SELECTION/DuyHaiSeleccion%40-1.JPG', alt: 'Fishermen at Duy Hai at dawn' },
    ],
    shots: [
      'Round basket boats (thuyền thúng) launching before first light',
      "Fishermen sorting the night's catch on wet sand",
      'The spontaneous fish market — faces, color, movement',
      'Traditional trawlers silhouetted against a gold horizon',
      'Long-exposure waves and boat reflections at shore',
    ],
    includes: ['Private round-trip transport from Hội An', 'Coffee & bánh mì', 'Real-time photography coaching', 'Shot list & composition guide'],
    description: "Most visitors never make it to Duy Hai. The village wakes before 4 AM — fishermen returning, nets being mended, the spontaneous market appearing on the sand. You'll be there with a photographer who knows these men by name, in the exact window when the light turns gold and the chaos turns beautiful.",
  },
  {
    id: 'old-town',
    num: '02',
    badge: 'MOST REQUESTED · STREET · ARCHITECTURE',
    name: 'Old Town Before the Crowds',
    sessionValue: 'Photo Tour – Old Town Before the Crowds',
    location: 'Hội An Ancient Town · UNESCO Heritage',
    tagline: 'The yellow walls, the morning market, the real Hội An — photographed before the tourists arrive.',
    time: '6:00 – 9:00 AM',
    duration: '3 hours',
    groupSize: 'Max 5 people',
    level: 'All levels',
    groupPrice: '$40 USD',
    groupPriceVnd: '1.100.000 VND',
    privatePrice: '$129 USD',
    privatePriceVnd: '3.400.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-32.jpg',
    heroAlt: 'Hội An Ancient Town empty yellow streets at golden hour',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/market-001.JPG', alt: 'Market vendor with colorful produce Hoi An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-37.jpg', alt: 'Morning market vendors Hội An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-39.JPG', alt: 'Yellow wall corner at dawn Hội An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-43.jpg', alt: 'Old Town street life Hội An' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/OldTown-SELECTION/01.25HoiAn%40-32.jpg', alt: 'Hội An rooftops at morning light' },
    ],
    shots: [
      'UNESCO yellow walls in soft morning raking light — texture, shadow, depth',
      'Empty alleys and iconic facades before the day begins',
      'The morning market: tropical fruit, seafood, vendors in conical hats',
      'Color and authentic street life — real Hội An, not the postcard version',
      'The Japanese Covered Bridge — architecture, symmetry, quiet reflection',
    ],
    includes: ['Walking tour (no transport needed)', 'Market breakfast together', 'Full real-time image review & coaching'],
    description: 'By 7 AM the Old Town belongs to tourists. By 6 AM it still belongs to locals — the vendors setting up, the motorbikes weaving through narrow lanes, the light sliding in at a low angle across those famous yellow walls. This is the tour people come back from saying "I finally got the shot I came to Vietnam for."',
  },
  {
    id: 'thu-bon',
    num: '03',
    badge: 'DOCUMENTARY · LANDSCAPE · BOAT',
    name: 'River Life at Golden Hour',
    sessionValue: 'Photo Tour – River Life at Golden Hour',
    location: 'Thu Bon River · Hội An countryside',
    tagline: 'Warm afternoon light, a wooden boat, and fishermen casting nets as the river turns gold.',
    time: '3:30 – 6:30 PM',
    duration: '3 hours',
    groupSize: 'Max 4 people',
    level: 'All levels',
    groupPrice: '$69 USD',
    groupPriceVnd: '1.850.000 VND',
    privatePrice: '$195 USD',
    privatePriceVnd: '5.150.000 VND',
    heroImg: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-004.JPEG',
    heroAlt: 'Fisherman casting net on Thu Bon River Hoi An at golden hour',
    gallery: [
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-004.JPG', alt: 'River life Thu Bon at golden hour' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-001.JPEG', alt: 'Man fishing on Thu Bon River traditional' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-008.jpg', alt: 'Thu Bon afternoon light landscape' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/ThuBhonRiver-009.jpg', alt: 'Thu Bon river coconut palms reflection' },
      { src: 'https://CrisMaturana.b-cdn.net/Photo-Tours-Vietnam/ThuBhonRiver-SELECTION/man-fishing-net-004.JPEG', alt: 'Fisherman casting net Thu Bon River' },
    ],
    shots: [
      'Fishermen casting nets from a traditional wooden boat',
      'Warm golden light reflecting off still, mirror-flat water',
      'Coconut palm reflections and flooded rice paddies',
      'Basket boats navigating narrow river channels',
      'Rural river-bank life — farmers, children, daily rhythm',
    ],
    includes: ['Private wooden boat with local river guide', 'Real-time photography coaching on board', 'Shot list & timing notes'],
    description: "The Thu Bon at late afternoon is something you can't photograph from the shore. As the sun drops low, the light turns the water into molten gold and every cast net becomes a perfect frame. You need a boat, the right guide, and patience — this tour gives you all three. The most meditative experience of the three, slow and full of frames you won't find anywhere else.",
  },
];
---

<Layout
  title="Photo Tours Hội An, Vietnam 2026 — Private Photography Tours with Local Guide"
  description="Three private photo tours in Hội An, Vietnam. Fishing villages, ancient streets, and river life at first light. Group and private rates available. Guided by Cris Maturana, local photographer."
  lang="en"
  canonical="https://crismaturana.com/photo-tours-vietnam-2026"
  alternates={alternates}
>

<!-- ═══ SCHEMA.ORG STRUCTURED DATA ═══ -->
<script type="application/ld+json" is:inline>{JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://crismaturana.com" },
        { "@type": "ListItem", "position": 2, "name": "Photo Tours Vietnam 2026", "item": "https://crismaturana.com/photo-tours-vietnam-2026" }
      ]
    },
    {
      "@type": "Person",
      "name": "Cris Maturana",
      "jobTitle": "Photographer",
      "url": "https://crismaturana.com",
      "sameAs": ["https://www.instagram.com/crismaturanaphoto"]
    },
    {
      "@type": "TouristTrip",
      "name": "Dawn at the Fishing Village — Duy Hai Photo Tour",
      "description": "Private sunrise photography tour to Duy Hai fishing village near Hội An, Vietnam. Document fishermen, basket boats, and the spontaneous fish market at first light.",
      "touristType": "Photographer",
      "itinerary": { "@type": "ItemList", "name": "Duy Hai Photo Tour Itinerary" },
      "offers": { "@type": "AggregateOffer", "lowPrice": "60", "highPrice": "150", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cris Maturana" },
      "location": { "@type": "Place", "name": "Duy Hai, Quảng Nam, Vietnam" }
    },
    {
      "@type": "TouristTrip",
      "name": "Old Town Before the Crowds — Hội An Photo Tour",
      "description": "Private morning photography tour of Hội An Ancient Town UNESCO Heritage. Yellow walls, morning market, empty alleys — before the tourists arrive.",
      "touristType": "Photographer",
      "offers": { "@type": "AggregateOffer", "lowPrice": "40", "highPrice": "129", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cris Maturana" },
      "location": { "@type": "Place", "name": "Hội An Ancient Town, Quảng Nam, Vietnam" }
    },
    {
      "@type": "TouristTrip",
      "name": "River Life at Golden Hour — Thu Bon River Photo Tour",
      "description": "Private boat photography tour on the Thu Bon River, Hội An. Capture fishermen casting nets, golden afternoon light, and rural river life at sunset.",
      "touristType": "Photographer",
      "offers": { "@type": "AggregateOffer", "lowPrice": "69", "highPrice": "195", "priceCurrency": "USD", "offerCount": "2" },
      "provider": { "@type": "Person", "name": "Cris Maturana" },
      "location": { "@type": "Place", "name": "Thu Bon River, Hội An, Vietnam" }
    }
  ]
})}</script>

<style>
  /* ── RESET & BASE ── */
  .pt-page { font-family: var(--font-sans); color: var(--color-text); }

  /* ── HERO ── */
  .pt-hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    max-height: 900px;
    overflow: hidden;
    display: flex;
    align-items: stretch;
  }
  .pt-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .pt-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0.55) 0%,
      rgba(255,255,255,0.18) 40%,
      rgba(255,255,255,0) 65%,
      rgba(10,8,5,0.25) 100%
    );
  }
  .pt-hero-content {
    position: relative;
    z-index: 2;
    padding: 7rem 2rem 4rem;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .pt-hero-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
    display: block;
  }
  .pt-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.5vw, 4.2rem);
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1.1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .pt-hero h1 em { font-style: italic; }
  .pt-hero-sub {
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    color: rgba(26,26,24,0.78);
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 2rem;
    font-weight: 300;
  }
  .pt-hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .pt-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    background: var(--color-accent);
    color: #1a1814;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s, transform 0.15s;
    border: none;
    cursor: pointer;
  }
  .pt-btn-primary:hover { background: #b8934a; transform: translateY(-1px); }
  .pt-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border: 1px solid rgba(255,255,255,0.85);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.25s, color 0.25s, background 0.25s;
    cursor: pointer;
    background: rgba(10,8,5,0.4);
    backdrop-filter: blur(4px);
  }
  .pt-btn-ghost:hover { border-color: #fff; color: #fff; background: rgba(10,8,5,0.6); }
  .pt-scroll-arrow {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255,255,255,0.4);
    font-size: 1.4rem;
    animation: bounce 2s infinite;
    text-decoration: none;
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  /* ── TRUST BAR ── */
  .pt-trust {
    background: var(--color-heading);
    padding: 1.1rem 2rem;
  }
  .pt-trust-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .pt-trust-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgba(255,255,255,0.65);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .pt-trust-item strong { color: rgba(255,255,255,0.9); font-weight: 700; }
  .pt-trust-dot {
    color: var(--color-accent);
    font-size: 0.9rem;
    line-height: 1;
  }

  /* ── SECTION HEADER ── */
  .pt-section { padding: 5rem 2rem; }
  .pt-section-inner { max-width: 1160px; margin: 0 auto; }
  .pt-section-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
    display: block;
  }
  .pt-section-title {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.5vw, 2.8rem);
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .pt-section-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.75;
    margin-bottom: 3.5rem;
  }

  /* ── TOUR CARDS ── */
  .pt-tours-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid var(--color-border);
  }
  .pt-tour-card {
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .pt-tour-card:last-child { border-bottom: none; }

  .pt-tour-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    cursor: pointer;
    transition: background 0.2s;
    position: relative;
  }
  .pt-tour-summary:hover .pt-tour-img { transform: scale(1.03); }

  .pt-tour-img-wrap {
    overflow: hidden;
    aspect-ratio: 4/3;
    position: relative;
  }
  .pt-tour-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s ease;
    display: block;
  }
  /* Expand hint overlay */
  .pt-tour-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(10,8,5,0);
    transition: background 0.3s;
  }
  .pt-tour-summary:hover .pt-tour-img-wrap::after {
    background: rgba(10,8,5,0.18);
  }
  .pt-tour-expand-hint {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 3;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    border: 1px solid rgba(255,255,255,0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1;
    transition: background 0.25s, transform 0.25s;
    pointer-events: none;
  }
  .pt-tour-summary:hover .pt-tour-expand-hint {
    background: rgba(201,169,110,0.85);
    border-color: transparent;
    transform: scale(1.08);
  }
  .pt-tour-expand-hint.open {
    background: rgba(201,169,110,0.9);
    border-color: transparent;
  }
  .pt-tour-expand-hint.open span { transform: rotate(45deg); display: inline-block; }

  .pt-tour-info {
    padding: 2.5rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-bg);
  }
  .pt-tour-top {}
  .pt-tour-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .pt-tour-num-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .pt-tour-badge-tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }
  .pt-tour-info h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .pt-tour-location {
    font-size: 0.75rem;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .pt-tour-tagline {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin-bottom: 1.75rem;
    font-style: italic;
  }

  .pt-tour-quickmeta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .pt-qm-item { }
  .pt-qm-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 2px;
  }
  .pt-qm-val {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--color-heading);
  }

  .pt-tour-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ── DUAL PRICING ── */
  .pt-price-options {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .pt-price-option {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pt-price-option-label {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .pt-price-amount {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-heading);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .pt-price-per {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    margin-left: 3px;
    font-weight: 400;
  }
  .pt-price-vnd {
    font-size: 0.68rem;
    color: var(--color-text-muted);
  }

  .pt-tour-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .pt-btn-book {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-accent);
    color: #1a1814;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .pt-btn-book:hover { background: #b8934a; transform: translateY(-1px); }
  .pt-btn-book-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid var(--color-heading);
    color: var(--color-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .pt-btn-book-outline:hover { background: var(--color-accent); border-color: var(--color-accent); color: #fff; transform: translateY(-1px); }
  .pt-btn-details {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    font-family: inherit;
    white-space: nowrap;
  }
