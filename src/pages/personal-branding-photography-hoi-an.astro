---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
import { buildAlternates } from '../lib/utils';

const alternates = buildAlternates('/personal-branding-photography-hoi-an', '/es/fotografia-marca-personal-hoi-an');

const cdn = 'https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION';

const images = [
  { thumb: `${cdn}/Danya1Muestra%40-2.JPG`, full: `${cdn}/Danya1Muestra%40-2.JPG`, alt: 'Portrait photo by Cris Maturana' },
  { thumb: `${cdn}/agnes-portrait-001.JPG`, full: `${cdn}/agnes-portrait-001.JPG` },
  { thumb: `${cdn}/agnes-portrait-002.JPG`, full: `${cdn}/agnes-portrait-002.JPG` },
  { thumb: `${cdn}/agnes-partner-portrait-001.JPG`, full: `${cdn}/agnes-partner-portrait-001.JPG` },
  { thumb: `${cdn}/agnes-partner-portrait-002.JPG`, full: `${cdn}/agnes-partner-portrait-002.JPG` },
  { thumb: `${cdn}/anna-portrait-001.JPG`, full: `${cdn}/anna-portrait-001.JPG` },
  { thumb: `${cdn}/anna-portrait-002.JPG`, full: `${cdn}/anna-portrait-002.JPG` },
  { thumb: `${cdn}/Fo-Web%40-9.JPG`, full: `${cdn}/Fo-Web%40-9.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-10.JPG`, full: `${cdn}/HoiAnPortrais1%40-10.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-13.JPG`, full: `${cdn}/HoiAnPortrais1%40-13.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-15.JPG`, full: `${cdn}/HoiAnPortrais1%40-15.JPG` },
  { thumb: `${cdn}/HoiAnPortrais1%40-18.JPG`, full: `${cdn}/HoiAnPortrais1%40-18.JPG` },
  { thumb: `${cdn}/hygge-farm-portrait-001.JPG`, full: `${cdn}/hygge-farm-portrait-001.JPG` },
  { thumb: `${cdn}/MartinsSoul%40-24.JPG`, full: `${cdn}/MartinsSoul%40-24.JPG` },
  { thumb: `${cdn}/MartinsSoul%40-27.JPG`, full: `${cdn}/MartinsSoul%40-27.JPG` },
  { thumb: `${cdn}/monse-portrait-001.JPG`, full: `${cdn}/monse-portrait-001.JPG` },
  { thumb: `${cdn}/MonseRetratos%40-18.jpg`, full: `${cdn}/MonseRetratos%40-18.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-30.jpg`, full: `${cdn}/MonseRetratos%40-30.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-40.jpg`, full: `${cdn}/MonseRetratos%40-40.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-83.jpg`, full: `${cdn}/MonseRetratos%40-83.jpg` },
  { thumb: `${cdn}/MonseRetratos%40-91.jpg`, full: `${cdn}/MonseRetratos%40-91.jpg` },
  { thumb: `${cdn}/rachel-portrait-001.JPG`, full: `${cdn}/rachel-portrait-001.JPG` },
  { thumb: `${cdn}/rachel-portrait-0012.JPG`, full: `${cdn}/rachel-portrait-0012.JPG` },
  { thumb: `${cdn}/rachel-portrait-0013.JPG`, full: `${cdn}/rachel-portrait-0013.JPG` },
  { thumb: `${cdn}/rachel-portrait-0014.JPG`, full: `${cdn}/rachel-portrait-0014.JPG` },
  { thumb: `${cdn}/tania-portrait-001.JPG`, full: `${cdn}/tania-portrait-001.JPG` },
  { thumb: `${cdn}/tania-portrait-002.JPG`, full: `${cdn}/tania-portrait-002.JPG` },
  { thumb: `${cdn}/TheHyggePortraits%40-72.JPG`, full: `${cdn}/TheHyggePortraits%40-72.JPG` },
].map(img => ({ ...img, alt: 'Portrait photo by Cris Maturana' }));
---

<Layout
  title="Personal Branding & Portrait Photographer in Hoi An & Da Nang | Cris Maturana"
  description="Personal branding and portrait photography sessions in Hoi An and Da Nang, Vietnam. Natural light, honest expressions, real presence."
  lang="en"
  canonical="https://crismaturana.com/personal-branding-photography-hoi-an"
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Personal Branding & Portrait Photography",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Hội An", "addressCountry": "VN" }
      },
      "areaServed": ["Hội An", "Da Nang", "Vietnam"]
    })
  }</script>
  <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Portfolio · Portraits</p>
      <p class="hero-location">Hội An · Da Nang · Southeast Asia</p>
      <h1>Personal Branding &amp; Portrait Photographer in Hội An &amp; Da Nang</h1>
      <h2>Natural light. Honest expressions.</h2>
      <p class="hero-text">I work primarily with natural light to create soft, authentic portraits. My approach is relaxed and intuitive — I guide you throughout the session so everything feels effortless.</p>
      <div class="hero-stats">
        <div class="stat"><p class="stat-num">15+</p><p class="stat-label">Years</p></div>
        <div class="stat"><p class="stat-num">100+</p><p class="stat-label">Sessions</p></div>
        <div class="stat"><p class="stat-num stat-sm">Always</p><p class="stat-label">Present</p></div>
        <div class="stat stat-text"><p class="stat-num stat-sm">Natural & Spontaneous</p><p class="stat-label">Style · Estilo</p></div>
      </div>
      <div class="hero-cta">
        <a href="/prices" class="cta-btn">View Packages & Prices</a>
        <a href="/contact?session=Portrait+%2F+Personal+Branding" class="cta-link">Book a Session →</a>
      </div>
    </div>
  </div>
  <section class="section gallery-section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>

  <section class="section service-section">
    <div class="container service-copy">

      <h2>What to Expect</h2>
      <p>
        Sessions usually run 45 minutes to 4 hours depending on your package, and can include
        one outfit or several looks across different locations in Hội An or Da Nang — Old Town
        backdrops, riverside light, or somewhere more neutral if you need it for LinkedIn or a
        website. I'll guide you through simple poses and expressions so you don't have to think
        about it; the goal is photos that still look like you, just camera-ready.
      </p>

      <h2>Why Book with Cris?</h2>
      <p>
        I've spent 15+ years photographing people who aren't professional models —
        entrepreneurs, remote workers, couples on holiday — which means I know how to put
        someone at ease in front of a camera. For personal branding, that matters more than
        equipment: the best headshot is the one where you forgot you were being photographed.
      </p>

      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>Do you offer sessions in Da Nang too?</summary>
        <p>Yes — Da Nang is about 30–45 minutes from Hội An, and I regularly shoot portrait and branding sessions there with no extra travel complexity.</p>
      </details>
      <details>
        <summary>What's a personal branding session used for?</summary>
        <p>LinkedIn profiles, websites, social media, press kits — anywhere you need photos that look professional but not stiff. We can plan outfit changes and locations around how you'll actually use the images.</p>
      </details>
      <details>
        <summary>How many photos will we receive, and how long does delivery take?</summary>
        <p>Between 10 and 50 edited photos depending on your package, with a sneak peek within 24 hours and the full gallery delivered within 7 to 10 days.</p>
      </details>
      <details>
        <summary>How do I book?</summary>
        <p>Fill in the <a href="/contact?session=Portrait+%2F+Personal+Branding">contact form</a> with Personal Branding preselected, or message me directly. I'll reply within 24–48 hours to confirm a date and location.</p>
      </details>

      <div class="custom-quote">
        <p class="custom-label">Let's Work Together</p>
        <h2 class="custom-heading">Start the conversation</h2>
        <p class="custom-text">Tell me what the photos are for and what look you're going for — I'll get back to you within 24 hours.</p>
        <a href="/contact?session=Portrait+%2F+Personal+Branding" class="btn btn-accent custom-cta">Start the Conversation →</a>
        <p class="custom-text" style="margin-top: 1rem; margin-bottom: 0;">
          <a href="/prices">View packages &amp; prices →</a>
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
  
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/PORTRAITS-SELECTION/Danya1Muestra%40-2.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(1.1);
    transform: scale(1.05);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 7rem 2.5rem 2rem;
    text-align: center;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #1a1a18;
    margin-bottom: 0.25rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 1.25rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 0.9rem;
    color: #4a4a48;
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 1.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.25rem;
    align-items: flex-end;
    justify-content: center;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgba(160, 120, 64, 0.6);
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(160, 120, 64, 0.6);
    padding-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.25rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-cta {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: #e8c070;
    color: #1a1a18;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta-btn:hover { background: #c9a050; }

  .cta-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .cta-link:hover { color: rgba(160, 120, 64, 0.85); }

  .gallery-section {
    padding-bottom: 0;
  }

  .service-section {
    padding-top: 0;
    margin-top: -30px;
  }

  .service-copy {
    max-width: 720px;
    margin: 0 auto;
  }

  .service-copy h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .service-copy p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .service-copy a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .service-copy details {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }

  .service-copy summary {
    font-family: var(--font-sans);
    font-weight: 700;
    cursor: pointer;
    color: var(--color-heading);
  }

  .service-copy details p {
    margin-top: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-text a {
    color: var(--color-accent);
  }

  .custom-cta {
    display: inline-block;
  }

  @media (max-width: 768px) {
    .gallery-hero-content { text-align: center; padding: 7rem 1.5rem 2rem; }
    .hero-text { max-width: 100%; }
    .hero-stats { justify-content: center; gap: 1.5rem; }
    .hero-cta { flex-direction: column; gap: 1rem; }
  }

</style>
