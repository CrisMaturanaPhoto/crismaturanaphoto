---
import Layout from '../layouts/Layout.astro';
import { buildAlternates } from '../lib/utils';

const alternates = buildAlternates('/faq', '/es/faq');

const faqs = [
  {
    q: "What's your photography style?",
    a: "Documentary, human, and unposed. My references are Sergio Larrain, Cartier-Bresson, McCurry, Salgado, and Fan Ho — photographers who observed first and directed never.",
  },
  {
    q: "Do you pose people? What if I'm awkward in front of the camera?",
    a: "I use a directing approach called FLOW: instead of static poses, I give you actions and prompts that draw out your natural self. Most of my clients tell me afterwards that they forgot I was there.",
  },
  {
    q: "What services do you offer?",
    a: "Portrait and personal branding (especially yoga and wellness), destination weddings in Vietnam and Southeast Asia, product photography, and documentary / travel work.",
  },
  {
    q: "Where are you based? Do you travel?",
    a: "Based in Hoi An, Vietnam. I shoot across Central Vietnam (Da Nang area) with no travel fee, and travel throughout Southeast Asia and internationally.",
  },
  {
    q: "When will I receive my photos?",
    a: "Portraits and branding: 7–10 business days. Weddings: sneak peek within 24 hours, full gallery in 15–30 days.",
  },
  {
    q: "How do I book?",
    a: "Fill in the contact form at crismaturana.com/contact. I'll reply within 24–48 hours to schedule a short call. A 30–50% deposit secures your date.",
  },
];
---

<Layout
  title="FAQ – Cristóbal Maturana"
  description="Frequently asked questions about Cristóbal Maturana's photography services."
  canonical="https://crismaturana.com/faq"
  alternates={alternates}
>
  <div class="page-hero">
    <div class="container">
      <h1>FAQ</h1>
      <p>Check the most frequent questions</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="faq-list">
        {faqs.map((item, i) => (
          <details class="faq-item">
            <summary class="faq-question">
              <span class="faq-num">{String(i + 1).padStart(2, '0')}.</span>
              {item.q}
              <span class="faq-icon">+</span>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-list { max-width: 800px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-question { display: flex; align-items: flex-start; gap: 1rem; padding: 1.5rem 0; cursor: pointer; font-size: 1rem; font-weight: 400; color: var(--color-heading); list-style: none; transition: color 0.2s; position: relative; padding-right: 2.5rem; }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question:hover { color: var(--color-accent); }
  .faq-num { font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-accent); flex-shrink: 0; line-height: 1.2; }
  .faq-icon { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 1.5rem; color: var(--color-text-muted); transition: transform 0.3s, color 0.2s; line-height: 1; }
  details[open] .faq-icon { transform: translateY(-50%) rotate(45deg); color: var(--color-accent); }
  .faq-answer { padding: 0 0 1.5rem 3rem; }
  .faq-answer p { color: var(--color-text-muted); line-height: 1.8; font-size: 0.95rem; }
</style>
