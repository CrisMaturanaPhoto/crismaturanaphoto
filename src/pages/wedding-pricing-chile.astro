---
import Layout from '../layouts/Layout.astro';
import { buildAlternates } from '../lib/utils';

const alternates = buildAlternates('/wedding-pricing-chile', '/es/precios-matrimonios-chile');
---

<Layout
  title="Wedding Pricing in Chile 2026 | Cris Maturana"
  description="Wedding photography packages and rates in Chile. Three packages starting at CLP $1,200,000. Documentary style, real moments."
  lang="en"
  canonical="https://crismaturana.com/wedding-pricing-chile"
  alternates={alternates}
>

  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Wedding Photography in Chile",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressCountry": "CL" }
      },
      "areaServed": "Chile",
      "offers": [
        { "@type": "Offer", "name": "The Essentials", "price": "700", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "The Full Day", "price": "1300", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Start to Finish", "price": "1800", "priceCurrency": "USD" }
      ]
    })
  }</script>

  <div class="page-hero">
    <div class="container">
      <p class="hero-session-label">Weddings · Chile</p>
      <h1>How much of your day do you want to remember?</h1>
      <p>I've photographed weddings across Chile and Southeast Asia, and over the years I've learned which photos actually get looked at again — the ones that help you remember how the day felt, not just how it looked. That's why I offer three different options, based on how much of your wedding you want to keep: from the most important moments to every detail, start to finish.</p>
    </div>
  </div>

  <section class="story-image-section">
    <div class="story-image-wrap">
      <img src="https://crismaturana.b-cdn.net/WEDDINGS-SELECTION/yaz-lin-005.jpg" alt="Documentary wedding photography in Chile by Cristóbal Maturana" class="story-image" loading="eager" />
      <div class="story-image-overlay"></div>
      <p class="story-image-caption">You won't remember every detail of your wedding.<br>The photos will.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="pricing-grid">

        <div class="pkg-card">
          <p class="tier-label">THE ESSENTIALS</p>
          <p class="pkg-name">The Essentials</p>
          <p class="pkg-tagline">The ceremony, the toasts, the dance — fully captured.</p>
          <div class="pkg-price"><span class="currency">USD</span><span class="amount">$700</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>5 hours of coverage</span></li>
            <li><span class="icon-check">✓</span><span>1 photographer</span></li>
            <li><span class="icon-check">✓</span><span>Ceremony + reception</span></li>
            <li><span class="icon-check">✓</span><span>250+ edited photos in high resolution</span></li>
            <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/contact?session=Wedding&amp;package=The+Essentials#contact-form" class="btn btn-accent pkg-cta">Send an Email</a>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+The+Essentials+package+for+my+wedding" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Chat on WhatsApp</a>
          </div>
          <p class="pkg-note">Delivery in 30 days</p>
        </div>

        <div class="pkg-card featured">
          <div class="featured-badge">Most Booked</div>
          <p class="tier-label">THE FULL DAY</p>
          <p class="pkg-name">The Full Day</p>
          <p class="pkg-tagline">The package most couples choose — and the one I'd choose for my own wedding.</p>
          <div class="pkg-price"><span class="currency">USD</span><span class="amount">$1,300</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>10 hours of coverage (getting ready, ceremony &amp; party)</span></li>
            <li><span class="icon-check">✓</span><span>1 photographer + assistant</span></li>
            <li><span class="icon-check">✓</span><span>500+ edited photos in high resolution</span></li>
            <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Pre-wedding couple's session (golden hour) — a chance for us to get to know each other before the big day</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Planning call before the day</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/contact?session=Wedding&amp;package=The+Full+Day#contact-form" class="btn btn-accent pkg-cta">Send an Email</a>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+The+Full+Day+package+for+my+wedding" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Chat on WhatsApp</a>
          </div>
          <p class="pkg-note">Delivery in 21 days</p>
        </div>

        <div class="pkg-card">
          <p class="tier-label">START TO FINISH</p>
          <p class="pkg-name">Start to Finish</p>
          <p class="pkg-tagline">Every hour, every detail — a complete archive, not just a gallery.</p>
          <div class="pkg-price"><span class="currency">USD</span><span class="amount">$1,800</span></div>
          <div class="pkg-divider"></div>
          <ul class="pkg-features">
            <li><span class="icon-check">✓</span><span>12 hours of coverage (getting ready through the last dance)</span></li>
            <li><span class="icon-check">✓</span><span>1 photographer + assistant</span></li>
            <li><span class="icon-check">✓</span><span>700+ edited photos in high resolution</span></li>
            <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Pre-wedding couple's session — a chance for us to get to know each other before the big day</span></li>
            <li class="value-add"><span class="icon-star">★</span><span>Printed 30×30 cm album (40 pages)</span></li>
            <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
          </ul>
          <div class="pkg-cta-group">
            <a href="/contact?session=Wedding&amp;package=Start+to+Finish#contact-form" class="btn btn-accent pkg-cta">Send an Email</a>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+Start+to+Finish+package+for+my+wedding" class="pkg-cta pkg-cta-whatsapp" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>Chat on WhatsApp</a>
          </div>
          <p class="pkg-note">Priority delivery in 14 days</p>
        </div>

      </div>

      <p class="footer-note">Every package above is a starting point — not a script · Available across Chile · Prices in USD · Travel outside the Santiago Metropolitan Region quoted separately</p>

      <div class="custom-quote">
        <p class="custom-label">Something different in mind?</p>
        <h2 class="custom-heading">Every wedding deserves its own story.</h2>
        <p class="custom-text">Tell me your date, your venue, and what you're imagining — I'll build a proposal around it. No commitment needed.</p>
        <a href="https://wa.me/56999679935?text=Hi%2C+I%27d+like+a+custom+quote+for+my+wedding" class="btn btn-accent custom-cta">Get a custom quote →</a>
      </div>

    </div>
  </section>

</Layout>

<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pkg-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s;
  }

  .pkg-card:hover { border-color: var(--color-accent); }

  .pkg-card.featured {
    border-color: var(--color-accent);
    border-width: 2px;
    padding-top: 3rem;
    background: #fff;
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    white-space: nowrap;
  }

  .tier-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .pkg-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .pkg-tagline {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    font-weight: 300;
  }

  .pkg-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .pkg-price .currency {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .pkg-price .amount {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1;
  }

  .pkg-divider { height: 1px; background: var(--color-border); margin-bottom: 0.5rem; }

  .pkg-features {
    list-style: none;
    margin-bottom: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.4;
    font-weight: 300;
  }

  .pkg-features li.value-add span:last-child { color: var(--color-text); font-weight: 400; }

  .pkg-features li.delivery {
    border-bottom: none;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  .icon-check { color: var(--color-accent); font-weight: 700; flex-shrink: 0; font-size: 0.85rem; margin-top: 1px; }
  .icon-star { color: #c0392b; font-size: 0.75rem; flex-shrink: 0; margin-top: 2px; }
  .icon-del { color: var(--color-text-muted); flex-shrink: 0; font-size: 0.8rem; margin-top: 1px; }

  .pkg-cta { display: block; width: 100%; text-align: center; }

  .pkg-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.6rem;
    opacity: 0.6;
    font-weight: 300;
  }

  .footer-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 3rem;
    font-weight: 300;
  }

  .hero-session-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-cta { display: inline-block; }

  .page-hero { padding-bottom: 0 !important; margin-bottom: 0 !important; border-bottom: none !important; }
  .section { padding-top: 1.5rem !important; }

  .story-image-section { margin-top: 2rem; }

  .story-image-wrap {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .story-image { width: 100%; height: 100%; object-fit: cover; display: block; }

  .story-image-overlay {
    position: absolute;
    inset: 0 2rem;
    background: linear-gradient(to top, rgba(10,9,7,0.65) 0%, rgba(10,9,7,0.05) 50%, transparent 100%);
  }

  .story-image-caption {
    position: absolute;
    left: calc(2rem + 2.5rem);
    bottom: 1.75rem;
    z-index: 2;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  @media (max-width: 700px) {
    .story-image-wrap { aspect-ratio: 4 / 5; padding: 0 1.25rem; }
    .story-image-overlay { inset: 0 1.25rem; }
    .story-image-caption {
      left: calc(1.25rem + 1.25rem);
      right: 1.25rem;
      bottom: 1.25rem;
      font-size: 0.95rem;
      white-space: normal;
    }
  }

  .pkg-cta-group { display: flex; flex-direction: column; gap: 0.6rem; margin-top: auto; }

  .pkg-cta-whatsapp {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: #25D366;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 40px;
    transition: background 0.25s;
  }

  .pkg-cta-whatsapp:hover { background: #1fb858; }
  .pkg-cta-whatsapp svg { flex-shrink: 0; }

  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }
</style>
