---
import Layout from '../layouts/Layout.astro';

---

<Layout
  title="Portrait Session Prices – Cristóbal Maturana Photo | Hội An, Vietnam"
  description="Family, personal branding and couples portrait sessions in Hội An. Three packages starting at USD 150. Organic, documentary-style photography."
  lang="en"
  alternates={[
    { hreflang: 'en', href: 'https://crismaturana.com/prices' },
    { hreflang: 'es', href: 'https://crismaturana.com/es/prices' },
    { hreflang: 'x-default', href: 'https://crismaturana.com/prices' },
  ]}
>

  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Portrait Photography Sessions",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Hội An", "addressCountry": "VN" }
      },
      "areaServed": "Hội An, Vietnam",
      "offers": [
        { "@type": "Offer", "name": "Family Essentials", "price": "160", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Family Story", "price": "250", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Family Heritage", "price": "350", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Portrait", "price": "150", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Brand", "price": "290", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Branding Presence", "price": "480", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Couples Intimate", "price": "160", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Couples Golden", "price": "280", "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Couples Journey", "price": "450", "priceCurrency": "USD" }
      ]
    })
  }</script>

  <div class="page-hero">
    <div class="container">
      <p class="hero-session-label">Portraits · Couples & Families</p>
      <h1>Session Prices</h1>
      <p>Fixed packages for portrait, couples & family sessions — starting at USD 160. Select a type to explore.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">

      <div class="sessions-nav">
        <button class="session-btn active" onclick="switchSession('family', this)">Family</button>
        <button class="session-btn" onclick="switchSession('branding', this)">Personal Branding</button>
        <button class="session-btn" onclick="switchSession('couples', this)">Couples</button>
      </div>

      <!-- FAMILY -->
      <div class="session-content active" id="session-family">
        <div class="pricing-grid">

          <div class="pkg-card">
            <p class="tier-label">ESSENTIALS</p>
            <p class="pkg-name">Essentials</p>
            <p class="pkg-tagline">One moment. One memory.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">160</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>1-hour session</span></li>
              <li><span class="icon-check">✓</span><span>1 location of your choice</span></li>
              <li><span class="icon-check">✓</span><span>15 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Style guide: what to wear &amp; how to prepare</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Essentials+family+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card featured">
            <div class="featured-badge">Most Popular</div>
            <p class="tier-label">STORY</p>
            <p class="pkg-name">Story</p>
            <p class="pkg-tagline">The complete family session.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">250</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>2-hour session</span></li>
              <li><span class="icon-check">✓</span><span>2 locations of your choice</span></li>
              <li><span class="icon-check">✓</span><span>30 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Style guide + 15-min planning call</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>1 black &amp; white photo — documentary style, ready to frame</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>30-sec mini video slideshow of your best photos</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Story+family+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card">
            <p class="tier-label">HERITAGE</p>
            <p class="pkg-name">Heritage</p>
            <p class="pkg-tagline">To treasure for generations.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">350</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>3–4 hour session</span></li>
              <li><span class="icon-check">✓</span><span>Unlimited locations</span></li>
              <li><span class="icon-check">✓</span><span>50 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Style guide + planning call</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>1 black &amp; white photo — documentary style, ready to frame</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>30-sec mini video slideshow of your best photos</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>RAW files of all edited photos</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Heritage+family+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 7–10 days</p>
          </div>

        </div>
      </div>

      <!-- BRANDING -->
      <div class="session-content" id="session-branding">
        <div class="pricing-grid">

          <div class="pkg-card">
            <p class="tier-label">PORTRAIT</p>
            <p class="pkg-name">Portrait</p>
            <p class="pkg-tagline">Your presence, in one image.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">150</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>45-min session</span></li>
              <li><span class="icon-check">✓</span><span>1 look / outfit</span></li>
              <li><span class="icon-check">✓</span><span>1 location of your choice</span></li>
              <li><span class="icon-check">✓</span><span>10 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Posing guidance included</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Outfit checklist tailored to your brand style</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Portrait+branding+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card featured">
            <div class="featured-badge">Most Popular</div>
            <p class="tier-label">BRAND</p>
            <p class="pkg-name">Brand</p>
            <p class="pkg-tagline">Content ready to use.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">290</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>2-hour session</span></li>
              <li><span class="icon-check">✓</span><span>2–3 looks / outfits</span></li>
              <li><span class="icon-check">✓</span><span>2 locations of your choice</span></li>
              <li><span class="icon-check">✓</span><span>30 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Posing guidance included</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Outfit checklist + 15-min pre-session call</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>3 profile-ready photos — with a note on which to use for LinkedIn, Instagram &amp; web</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>30-sec mini video slideshow for social media</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Brand+branding+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card">
            <p class="tier-label">PRESENCE</p>
            <p class="pkg-name">Presence</p>
            <p class="pkg-tagline">Your brand, in depth.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">480</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>3–4 hour session</span></li>
              <li><span class="icon-check">✓</span><span>4+ looks / locations</span></li>
              <li><span class="icon-check">✓</span><span>50 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Posing guidance included</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Outfit checklist + planning call</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>3 profile-ready photos — with a note on which to use for LinkedIn, Instagram &amp; web</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>30-sec mini video slideshow for social media</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>RAW files of all edited photos</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Presence+branding+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 7–10 days</p>
          </div>

        </div>
      </div>

      <!-- COUPLES -->
      <div class="session-content" id="session-couples">
        <div class="pricing-grid">

          <div class="pkg-card">
            <p class="tier-label">INTIMATE</p>
            <p class="pkg-name">Intimate</p>
            <p class="pkg-tagline">A real moment between you two.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">160</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>1-hour session</span></li>
              <li><span class="icon-check">✓</span><span>1 location of your choice</span></li>
              <li><span class="icon-check">✓</span><span>15 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Couples activity guide — natural connection, no stiff poses</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Intimate+couples+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card featured">
            <div class="featured-badge">Most Popular</div>
            <p class="tier-label">GOLDEN</p>
            <p class="pkg-name">Golden</p>
            <p class="pkg-tagline">Hội An in its best light.</p>
            <div class="pkg-price"><span class="currency">USD</span><span class="amount">280</span></div>
            <div class="pkg-divider"></div>
            <ul class="pkg-features">
              <li><span class="icon-check">✓</span><span>2-hour session</span></li>
              <li><span class="icon-check">✓</span><span>2 locations of your choice</span></li>
              <li><span class="icon-check">✓</span><span>30 edited photos</span></li>
              <li><span class="icon-check">✓</span><span>Private online gallery</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>Activity guide + 15-min planning call</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>1 black &amp; white photo — documentary style, ready to frame</span></li>
              <li class="value-add"><span class="icon-star">★</span><span>30-sec mini video slideshow to share</span></li>
              <li class="delivery"><span class="icon-del">↓</span><span>JPG web/social + full resolution for printing</span></li>
            </ul>
            <a href="https://wa.me/56999679935?text=Hi%2C+I%27m+interested+in+the+Golden+couples+package" class="btn btn-accent pkg-cta">Chat to book</a>
            <p class="pkg-note">Delivery in 5–7 days</p>
          </div>

          <div class="pkg-card">
            <p class="tier-label">JOURNEY</p>
