</Layout>

<style>
  .sessions-nav {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .session-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.5rem 1.75rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .session-btn.active,
  .session-btn:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  .session-content { display: none; }
  .session-content.active { display: block; }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .pkg-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 2rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s;
  }

  .pkg-card:hover {
    border-color: var(--color-accent);
  }

  .pkg-card.featured {
    border-color: var(--color-accent);
    border-width: 2px;
    padding-top: 3rem;
    background: #fff;
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.3rem 1rem;
    white-space: nowrap;
  }

  .tier-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .pkg-name {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.25rem;
    line-height: 1.2;
  }

  .pkg-tagline {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
    font-weight: 300;
  }

  .pkg-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: 0.5rem;
  }

  .pkg-price .currency {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  .pkg-price .amount {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1;
  }

  .pkg-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 0.5rem;
  }

  .pkg-features {
    list-style: none;
    margin-bottom: 1.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.4;
    font-weight: 300;
  }

  .pkg-features li.value-add span:last-child {
    color: var(--color-text);
    font-weight: 400;
  }

  .pkg-features li.delivery {
    opacity: 0.55;
    border-bottom: none;
    border-top: 1px solid var(--color-border);
    margin-top: 0.25rem;
  }

  .icon-check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    font-size: 0.85rem;
    margin-top: 1px;
  }

  .icon-star {
    color: #c0392b;
    font-size: 0.75rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .icon-del {
    color: var(--color-text-muted);
    flex-shrink: 0;
    font-size: 0.8rem;
    margin-top: 1px;
  }

  .pkg-cta {
    display: block;
    width: 100%;
    text-align: center;
    margin-top: auto;
  }

  .pkg-note {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.6rem;
    opacity: 0.6;
    font-weight: 300;
  }

  .footer-note {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    margin-top: 3rem;
    font-weight: 300;
  }

  .hero-session-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-cta {
    display: inline-block;
  }

  .page-hero { padding-bottom: 0 !important; margin-bottom: 0 !important; border-bottom: none !important; }
  .section { padding-top: 0 !important; }
  .sessions-nav { margin-top: 0; }

  @media (max-width: 900px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
  }

  @media (max-width: 480px) {
    .sessions-nav { flex-wrap: nowrap; gap: 0.35rem; }
    .session-btn {
      flex: 1;
      padding: 0.5rem 0.3rem;
      font-size: 0.8rem;
      letter-spacing: 0;
      white-space: normal;
      line-height: 1.15;
    }
  }
</style>

<script is:inline>
  function switchSession(id, btn) {
    document.querySelectorAll('.session-content').forEach(function(el) { el.classList.remove('active'); });
    document.querySelectorAll('.session-btn').forEach(function(el) { el.classList.remove('active'); });
    document.getElementById('session-' + id).classList.add('active');
    btn.classList.add('active');
  }
</script>

