---
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/HomeContent.astro';
import { heroSlides, portfolioCategories } from '../lib/ui';
import { getLatestBlogPosts, buildAlternates } from '../lib/utils';

const latestBlogPosts = await getLatestBlogPosts(3, 'en');
const alternates = buildAlternates('/', '/es/');
---

<Layout
  title="Cris Maturana – Photographer"
  lang="en"
  alternates={alternates}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="https://CrisMaturana.b-cdn.net/TRAVEL%26CULTURE-SELECTION/DuyHaiSeleccion%40-10.JPG"
    fetchpriority="high"
  />
  <HomeContent
    heroSlides={heroSlides}
    portfolioCategories={portfolioCategories}
    latestBlogPosts={latestBlogPosts}
    lang="en"
  />

</Layout>
