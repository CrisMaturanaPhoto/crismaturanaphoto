---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';

const images = [
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-001.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-001.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-002.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-002.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-003.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/atacama-desert-003.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-2.jpg', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-2.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-3.jpg', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-3.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-5.jpg', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Dron%40-5.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/DronCoconutBoat%40-10.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/DronCoconutBoat%40-10.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/DronCoconutBoat%40-5.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/DronCoconutBoat%40-5.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-17.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-17.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-6.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-6.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-7.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/HoiAnDron%40-7.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/mar-pan-de-azucar-001.jpg', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/mar-pan-de-azucar-001.jpg' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Pai%20Buda%20-1.JPG', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/Pai%20Buda%20-1.JPG' },
  { thumb: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/vietnamese-fishing-boat-001.jpg', full: 'https://CrisMaturana.b-cdn.net/FROMABOVE-SELECTION/vietnamese-fishing-boat-001.jpg' },
].map(img => ({ ...img, alt: 'Aerial photo by Cristóbal Maturana' }));
---

<Layout title="From Above – Cristóbal Maturana" description="Aerial and drone photography by Cristóbal Maturana.">
  <div class="page-hero">
    <div class="container">
      <h1>From Above</h1>
      <p>Perspective changes everything.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="gallery-intro">
        <p>Drone photography from Vietnam, Chile, and Thailand — rice fields, coconut forests, desert landscapes, and fishing boats seen from a completely different angle.</p>
      </div>
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .gallery-intro {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
</style>
