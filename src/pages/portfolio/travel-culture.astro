---

<Layout title="Travel & Culture – Cristóbal Maturana" description="Travel and documentary photography by Cristóbal Maturana.">
  <div class="page-hero">
    <div class="container">
      <h1>Travel & Culture</h1>
      <p>Observing the world, honestly.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="gallery-intro">
        <p>Street life, markets, rivers, and quiet moments between strangers. Images made while traveling through Vietnam, India, and beyond — always observing, never staging.</p>
      </div>
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .gallery-intro {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
</style>
