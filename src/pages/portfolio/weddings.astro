---

<Layout title="Weddings – Cristóbal Maturana" description="Documentary wedding photography by Cristóbal Maturana.">
  <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Portfolio · Weddings</p>
      <p class="hero-location">Hội An · Chile · Southeast Asia</p>
      <h1>Moments that<br>last forever.</h1>
      <p class="hero-text">Weddings are a mix of chaos, emotion, and everything in between. I stay in the background, close enough to catch what matters.</p>
      <div class="hero-stats">
        <div class="stat"><p class="stat-num">15+</p><p class="stat-label">Years</p></div>
        <div class="stat"><p class="stat-num">100+</p><p class="stat-label">Couples</p></div>
        <div class="stat"><p class="stat-num">24h</p><p class="stat-label">Sneak peek</p></div>
        <div class="stat stat-text"><p class="stat-num stat-sm">Natural light</p><p class="stat-label">Style</p></div>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/poppin-chris-001.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(10px) brightness(1.1);
    transform: scale(1.08);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.6);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 3rem 2.5rem 2rem;
  }

  .hero-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #c9a96e;
    margin-bottom: 0.5rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 2rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.15;
    margin-bottom: 1.75rem;
  }

  .hero-text {
    font-size: 0.95rem;
    color: #4a4a48;
    line-height: 1.9;
    max-width: 500px;
    margin-bottom: 2.5rem;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.75rem;
    align-items: flex-end;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: #c9a96e;
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.35rem;
    padding-bottom: 0.3rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.3rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
</style>
