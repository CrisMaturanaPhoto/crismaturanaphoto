---

<Layout title="Weddings – Cristóbal Maturana" description="Documentary wedding photography by Cristóbal Maturana.">
  <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Portfolio · Weddings</p>
      <p class="hero-location">Hội An · Chile · Southeast Asia</p>
      <h1>Moments that<br>last forever.</h1>
      <p class="hero-text">Weddings are a mix of chaos, emotion, and everything in between. I stay in the background, close enough to catch what matters.</p>
      <div class="hero-stats">
        <div class="stat"><p class="stat-num">15+</p><p class="stat-label">Years</p></div>
        <div class="stat"><p class="stat-num">100+</p><p class="stat-label">Couples</p></div>
        <div class="stat"><p class="stat-num stat-sm">Always</p><p class="stat-label">Present</p></div>
        <div class="stat stat-text"><p class="stat-num stat-sm">Natural & Spontaneous</p><p class="stat-label">Style · Estilo</p></div>
      </div>
      <div class="hero-cta">
        <a href="/investment" class="cta-btn">Check Rates &amp; Packages</a>
        <a href="/contact?session=Wedding" class="cta-link">Book a Session →</a>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/WEDDINGS-SELECTION/poppin-chris-001.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(1.1);
    transform: scale(1.05);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 7rem 2.5rem 2rem;
    text-align: center;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #1a1a18;
    margin-bottom: 0.25rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 1.25rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 0.9rem;
    color: #4a4a48;
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 1.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.25rem;
    align-items: flex-end;
    justify-content: center;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: #c9a96e;
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(160, 120, 64, 0.6);
    padding-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.25rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-cta {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: #e8c070;
    color: #1a1a18;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta-btn:hover { background: #c9a050; }

  .cta-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .cta-link:hover { color: rgba(160, 120, 64, 0.85); }

  @media (max-width: 768px) {
    .gallery-hero-content {
      text-align: center;
      padding: 7rem 1.5rem 2rem;
    }
    .hero-text { max-width: 100%; }
    .hero-stats { justify-content: center; gap: 1.5rem; }
    .stat-text { align-items: center; }
    .hero-cta { flex-direction: column; gap: 1rem; }
  }
</style>
