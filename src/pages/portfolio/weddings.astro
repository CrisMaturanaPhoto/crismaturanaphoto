---

<Layout title="Weddings – Cristóbal Maturana" description="Documentary wedding photography by Cristóbal Maturana.">
  <div class="page-hero">
    <div class="container">
      <h1>Weddings</h1>
      <p>Moments that last forever.</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="gallery-intro">
        <p>I photograph weddings the way they actually happen — candidly, with attention to real emotion and quiet in-between moments. No forced poses, just honest storytelling.</p>
      </div>
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>
</Layout>

<style>
  .gallery-intro {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }
</style>
