  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/maca-julian-sesion-embarazo-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/maca-julian-sesion-embarazo-001.JPG', alt: 'Maternity couple session documentary photography' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/nadeem-dionne-kohlanta-session.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/nadeem-dionne-kohlanta-session.JPG', alt: 'Couple photo session Southeast Asia beach' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/pareja-gam-santiago-chile.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/pareja-gam-santiago-chile.jpg', alt: 'Couple portrait session by Cris Maturana' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/poppin-chris-oldtown-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/poppin-chris-oldtown-001.JPG', alt: 'Couple photographer Hội An Ancient Town' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/rodrigo-silvia-familia.001.JPG', alt: 'Family photography session Hội An Vietnam' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-31.JPG', alt: 'Family portrait Hội An documentary style' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggeFamily%40-39.JPG', alt: 'Natural family photography Hội An Vietnam' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/TheHyggePortraits%40-31.JPG', alt: 'Couple and family portraits Hội An' },
];
---

<Layout
  title="Family, Portrait & Couples Photographer in Hoi An & Da Nang | Cris Maturana"
  description="Family, couples, and portrait photography sessions in Hoi An and Da Nang, Vietnam. Documentary style, natural light, real moments. Packages from $160 USD."
  lang="en"
  canonical="https://crismaturana.com/family-portrait-photography-hoi-an"
  alternates={alternates}
>
  <script slot="head" type="application/ld+json" is:inline>{
    JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Family, Couples & Portrait Photography",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Cris Maturana Photo",
        "url": "https://crismaturana.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Hội An", "addressCountry": "VN" }
      },
      "areaServed": ["Hội An", "Da Nang", "Vietnam"]
    })
  }</script>
  <div class="gallery-hero">
    <div class="gallery-hero-bg"></div>
    <div class="gallery-hero-overlay"></div>
    <div class="gallery-hero-content">
      <p class="hero-label">Couple & Family Photography · Hội An, Vietnam</p>
      <p class="hero-location">Ancient Town · Thu Bon River · Da Nang · Southeast Asia</p>
      <h1>Couples &amp; Family Photographer in Hội An &amp; Da Nang</h1>
      <h2>Two people. A family. Real life in between.</h2>
      <p class="hero-text">Couples on their first trip together. Families that haven't sat still in years. I photograph in Hội An's Old Town, along the Thu Bon River, and at golden hour in the rice fields — I show up, watch, and let things happen. The best frames are always the ones in between.</p>
      <div class="hero-stats">
        <div class="stat"><p class="stat-num">15+</p><p class="stat-label">Years</p></div>
        <div class="stat"><p class="stat-num">100+</p><p class="stat-label">Sessions</p></div>
        <div class="stat"><p class="stat-num stat-sm">Always</p><p class="stat-label">Present</p></div>
        <div class="stat stat-text"><p class="stat-num stat-sm">Natural & Spontaneous</p><p class="stat-label">Style · Estilo</p></div>
      </div>
      <div class="hero-cta">
        <a href="/prices" class="cta-btn">View Packages & Prices</a>
        <a href="/contact?session=Couples+%26+Families" class="cta-link">Book a Session →</a>
      </div>
    </div>
  </div>
  <section class="section gallery-section">
    <div class="container">
      <Gallery images={images} layout="masonry" columns={3} />
    </div>
  </section>

  <section class="section service-section">
    <div class="container service-copy">

      <h2>What to Expect</h2>
      <p>
        Sessions usually run 1 to 4 hours depending on your package, and take place wherever
        feels right for you — Old Town lanes, the Thu Bon riverside, the beach, or rice fields
        at golden hour. I spend the first few minutes letting everyone settle in and forget the
        camera is there, then follow the natural rhythm of the time together — kids being kids,
        partners actually talking to each other, grandparents telling stories. The light and the
        location do half the work; the rest takes care of itself.
      </p>

      <h2>Why Book with Cris?</h2>
      <p>
        I've been photographing families and couples for 15+ years, from Chile to Hội An and
        now regularly in Da Nang. My documentary background means I notice the in-between
        moments most photographers miss — and I work fast and unobtrusively, which matters most
        with kids and with couples who feel awkward in front of a camera.
      </p>

      <h2>Frequently Asked Questions</h2>
      <details>
        <summary>Do you photograph in Da Nang too?</summary>
        <p>Yes — Da Nang is about 30–45 minutes from Hội An, and I regularly shoot family and couples sessions there with no extra travel complexity.</p>
      </details>
      <details>
        <summary>How many people can be in a family session?</summary>
        <p>Any size — from a couple expecting their first child to multi-generational families. Larger groups may need a slightly longer session; I'll let you know when we talk.</p>
      </details>
      <details>
        <summary>How many photos will we receive, and how long does delivery take?</summary>
        <p>Between 15 and 50 edited photos depending on your package, with a sneak peek within 24 hours and the full gallery delivered within 7 days.</p>
      </details>
      <details>
        <summary>How do I book?</summary>
        <p>Fill in the contact form at crismaturana.com/contact, or message me directly. I'll reply within 24–48 hours to confirm a date and location.</p>
      </details>

      <div class="custom-quote">
        <p class="custom-label">Let's Work Together</p>
        <h2 class="custom-heading">Start the conversation</h2>
        <p class="custom-text">Tell me about your family or your trip — I'll get back to you within 24 hours.</p>
        <a href="/contact?session=Couples+%26+Families" class="btn btn-accent custom-cta">Start the Conversation →</a>
        <p class="custom-text" style="margin-top: 1rem; margin-bottom: 0;">
          <a href="/prices">View packages &amp; prices →</a>
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
  .gallery-hero {
    position: relative;
    overflow: hidden;
    margin-bottom: 0;
  }

  .gallery-hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG');
    background-size: cover;
    background-position: center;
    filter: blur(6px) brightness(1.1);
    transform: scale(1.05);
  }

  .gallery-hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.65);
  }

  .gallery-hero-content {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding: 7rem 2.5rem 2rem;
    text-align: center;
  }

  .hero-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #1a1a18;
    margin-bottom: 0.25rem;
  }

  .hero-location {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin-bottom: 1.25rem;
  }

  .gallery-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    font-style: italic;
    color: #1a1a18;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .gallery-hero h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    font-weight: 300;
    font-style: italic;
    color: #4a4a48;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .hero-text {
    font-size: 0.9rem;
    color: #4a4a48;
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto 1.75rem;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    border-top: 1px solid rgba(0,0,0,0.12);
    padding-top: 1.25rem;
    align-items: flex-end;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: rgba(160, 120, 64, 0.6);
    margin: 0;
    line-height: 1;
  }

  .stat-sm {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(160, 120, 64, 0.6);
    padding-bottom: 0.2rem;
  }

  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #6f6b65;
    margin: 0.25rem 0 0;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-cta {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.7rem 1.75rem;
    background: #e8c070;
    color: #1a1a18;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s;
  }

  .cta-btn:hover {
    background: #c9a050;
  }

  .cta-link {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a1a18;
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.3);
    padding-bottom: 2px;
    transition: color 0.2s;
  }

  .cta-link:hover {
    color: rgba(160, 120, 64, 0.85);
  }

  .gallery-section {
    padding-bottom: 0;
  }

  .service-section {
    padding-top: 0;
    margin-top: -30px;
  }

  .service-copy {
    max-width: 720px;
    margin: 0 auto;
  }

  .service-copy h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .service-copy p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .service-copy a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .service-copy details {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
  }

  .service-copy summary {
    font-family: var(--font-sans);
    font-weight: 700;
    cursor: pointer;
    color: var(--color-heading);
  }

  .service-copy details p {
    margin-top: 0.5rem;
  }

  .custom-quote {
    margin-top: 4rem;
    padding: 3rem 2.5rem;
    border: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface);
    position: relative;
  }

  .custom-quote::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }

  .custom-label {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .custom-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
    line-height: 1.2;
  }

  .custom-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1.75rem;
    font-weight: 300;
  }

  .custom-text a {
    color: var(--color-accent);
  }

  .custom-cta {
    display: inline-block;
  }

  @media (max-width: 768px) {
    .gallery-hero-content { text-align: center; padding: 7rem 1.5rem 2rem; }
    .hero-text { max-width: 100%; }
    .hero-stats { justify-content: center; gap: 1.5rem; }
    .hero-cta { flex-direction: column; gap: 1rem; }
  }
</style>
