  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/brauli-itziar-sesion-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/brauli-itziar-sesion-001.JPG', alt: 'Couple session documentary style Hội An' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/familia.santiago.chile.jpg', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/familia.santiago.chile.jpg', alt: 'Family photography session by Cris Maturana' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina-Nick-Pai-thailand-sesion-001.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina-Nick-Pai-thailand-sesion-001.JPG', alt: 'Couple photo session Southeast Asia' },
  { thumb: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG', full: 'https://CrisMaturana.b-cdn.net/COUPLES%26FAMILY-SELECTION/Gina%26Nick%40-113.JPG', alt: 'Couple photographer Hội An Vietnam golden hour' },
