---
// Página de la exposición (HTML propio) con la barra de menú del sitio.
// El contenido vive en src/expo/expo-es.html.
import Nav from '../../../components/Nav.astro';
import raw from '../../../expo/expo-es.html?raw';
const head = raw.match(/<head>([\s\S]*)<\/head>/i)?.[1] ?? '';
const body = raw.match(/<body>([\s\S]*)<\/body>/i)?.[1] ?? '';
const pageLang = 'es';
---
<!DOCTYPE html>
<html lang="es">
<head>
<Fragment set:html={head} />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap" />
<script is:inline define:vars={{ pageLang }}>
  try { localStorage.setItem('lang', pageLang); } catch (e) {}
</script>
<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-surface: #f8f6f3;
    --color-border: #e6e1da;
    --color-text: #2e2e2c;
    --color-text-muted: #6f6b65;
    --color-heading: #1a1a18;
    --color-accent: #c9a96e;
    --color-white: #ffffff;
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Lato', 'Helvetica Neue', sans-serif;
    --nav-height: 70px;
    --max-width: 1400px;
  }
  .site-header { font-family: var(--font-sans); line-height: 1.7; }
  .site-header a { color: inherit; text-decoration: none; }
  .site-header ul { list-style: none; }
</style>
<script is:inline src="/scripts/translations.js"></script>
</head>
<body>
<Nav />
<Fragment set:html={body} />
</body>
</html>
